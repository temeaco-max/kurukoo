# Copy to the deployment secret manager/environment. Never commit the real file.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
JWT_SECRET=CHANGE_ME

# Persistence backend. sqljs is the single-process local substrate.
# PostgreSQL is the canonical shared-state owner for Cloud Run / multi-process.
KURUKOO_DATABASE_MODE=sqljs
KURUKOO_JOB_MODE=in_process
KURUKOO_WORKERS=1
KURUKOO_PERSISTENT_STATE_REQUIRED=true
DB_PATH=/app/data/kurukoo.sqlite

# PostgreSQL canonical owner configuration (activated during controlled cutover).
# The repository persistence boundary audit has verified that no source file
# under src/ opens SQL.js directly; production PostgreSQL activation requires
# DATABASE_URL plus KURUKOO_POSTGRES_APPLICATION_INTEGRATED=true.
DATABASE_URL=
KURUKOO_POSTGRES_SSL=true
KURUKOO_POSTGRES_POOL_MAX=5
KURUKOO_POSTGRES_APPLICATION_INTEGRATED=false

# Distributed job processor (future substrate — do not enable until the
# corresponding canonical adapters are active and migration-tested).
KURUKOO_REDIS_URL=

# Network observability.
KURUKOO_METRICS_ENABLED=true
KURUKOO_OTEL_ENDPOINT=http://otel-collector:4318

# External execution/payment remain disabled until real contracts are verified.
KURUKOO_EXTERNAL_EXECUTION_ENABLED=false
KURUKOO_PAY_PROVIDER=
ECONOMIC_PAYMENT_ADAPTER=

# MCP / external AI channel.
KURUKOO_MCP_ENABLED=false
KURUKOO_MCP_ISSUER=
KURUKOO_MCP_CLIENT_ID=
KURUKOO_MCP_CLIENT_SECRET=
KURUKOO_MCP_REDIRECT_URIS=
KURUKOO_MCP_OAUTH_SECRET=
