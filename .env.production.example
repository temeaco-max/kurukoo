# Copy to the deployment secret manager/environment. Never commit the real file.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
JWT_SECRET=CHANGE_ME

# Cloud Run production substrate: one process + managed PostgreSQL.
# SQL.js is local-development only and must never be selected for Cloud Run.
KURUKOO_CLOUD_RUN=true
KURUKOO_DATABASE_MODE=postgres
KURUKOO_JOB_MODE=in_process
KURUKOO_WORKERS=1
KURUKOO_PERSISTENT_STATE_REQUIRED=true
# SQL.js path is retained only for explicitly local development.
DB_PATH=/app/data/kurukoo.sqlite

# Fail-closed until the full async application call-surface migration and managed-database
# verification are complete. Set true only as part of an evidence-backed cutover.
DATABASE_URL=
POSTGRES_URL=
KURUKOO_POSTGRES_APPLICATION_INTEGRATED=false
KURUKOO_POSTGRES_SSL=false
KURUKOO_POSTGRES_POOL_MAX=5
KURUKOO_POSTGRES_IDLE_TIMEOUT_SECONDS=30
KURUKOO_POSTGRES_CONNECT_TIMEOUT_SECONDS=5
KURUKOO_REDIS_URL=

# Network observability.
KURUKOO_METRICS_ENABLED=true
KURUKOO_OTEL_ENDPOINT=http://otel-collector:4318

# External execution/payment remain disabled until real contracts are verified.
KURUKOO_EXTERNAL_EXECUTION_ENABLED=false
# Cloud Run requires object_storage; local is retained here only to make the current block explicit.
KURUKOO_STORAGE_MODE=local
KURUKOO_PAY_PROVIDER=
ECONOMIC_PAYMENT_ADAPTER=

# MCP / external AI channel.
KURUKOO_MCP_ENABLED=false
KURUKOO_MCP_ISSUER=
KURUKOO_MCP_CLIENT_ID=
KURUKOO_MCP_CLIENT_SECRET=
KURUKOO_MCP_REDIRECT_URIS=
KURUKOO_MCP_OAUTH_SECRET=
