<%- include('../_partials/head', { country, t, seo, schemas, faqs, reqPath }) %>
<%- include('../_partials/nav', { country, t, shortcode }) %>

<main class="explore-container container page-container">
    <!-- Hero Section -->
    <section class="section-heading">
        <span class="eyebrow">Explore Capabilities</span>
        <h1>What can I ask Kurukoo?</h1>
        <p class="lead">
            Kurukoo handles a wide range of requests by matching you with the right capabilities across our network.
        </p>

        <!-- Search & Instant Intent Bar -->
        <div class="explore-search-container">
            <input type="text" id="explore-search" class="explore-search-input" placeholder="What do you need? (e.g. plumber, ride, food)...">
            <button type="button" id="explore-search-btn" class="btn btn-primary">
                Ask Kurukoo
            </button>
        </div>
    </section>

    <!-- Categories Responsive Grid -->
    <section class="categories-section">
        <div id="categories-grid" class="categories-grid">
            <% categories.forEach((cat, index) => { %>
                <!-- Category Card -->
                <div class="category-card explore-category-card" data-name="<%= cat.name.toLowerCase() %>">
                    <div class="explore-category-icon"><%= cat.icon %></div>
                    <h3 class="explore-category-title"><%= cat.name %></h3>
                    <p class="explore-category-desc"><%= cat.description %></p>
                    <div class="explore-category-footer">
                        <a href="/chat?prompt=I%20need%20help%20with%20<%= encodeURIComponent(cat.name) %>" class="btn btn-outline btn-sm">Start request</a>
                    </div>
                </div>

                <!-- Ad Placement Boundary -->
                <% if ((index + 1) % 8 === 0 && ads && ads.length > 0) { %>
                    <% const adIndex = Math.floor(index / 8) % ads.length; %>
                    <% const ad = ads[adIndex]; %>
                    <div class="sponsored-ad-card">
                        <span class="sponsored-badge">Partner Placement</span>
                        <h4><%= ad.title %></h4>
                        <p><%= ad.desc %></p>
                        <a href="/chat?prompt=Tell%20me%20about%20<%= encodeURIComponent(ad.title) %>" class="text-link">Learn more <span>→</span></a>
                    </div>
                <% } %>
            <% }) %>
        </div>
    </section>
</main>

<%- include('../_partials/footer') %>

<script>
    const searchInput = document.getElementById('explore-search');
    const searchBtn = document.getElementById('explore-search-btn');
    
    function filterCategories() {
        const query = searchInput.value.toLowerCase().trim();
        const cards = document.querySelectorAll('.category-card');
        cards.forEach(card => {
            const name = card.getAttribute('data-name');
            card.style.display = (!query || name.includes(query)) ? 'flex' : 'none';
        });
    }
    
    searchInput.addEventListener('input', filterCategories);
    searchBtn.addEventListener('click', () => {
        const query = searchInput.value.trim();
        if (query) {
            window.location.href = `/chat?prompt=${encodeURIComponent(query)}`;
        }
    });
</script>

<style>
.explore-search-container {
    display: flex;
    gap: 12px;
    max-width: 600px;
    margin: 32px auto 0;
}
.explore-search-input {
    flex: 1;
    padding: 12px 20px;
    border: 1px solid var(--gray-200);
    border-radius: 100px;
    font-size: 1rem;
}
.categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 60px;
}
.category-card {
    padding: 32px;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius);
    display: flex;
    flex-direction: column;
    text-align: center;
}
.explore-category-icon { font-size: 2.5rem; margin-bottom: 20px; }
.explore-category-title { margin-bottom: 12px; }
.explore-category-desc { color: var(--gray-600); font-size: 0.9rem; margin-bottom: 24px; flex: 1; }
.sponsored-ad-card {
    grid-column: 1 / -1;
    padding: 24px;
    background: var(--gray-50);
    border: 1px dashed var(--terracotta);
    border-radius: var(--border-radius);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}
.sponsored-badge { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--terracotta); font-weight: 700; margin-bottom: 8px; }
</style>
