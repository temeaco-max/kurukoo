<%- include('../_partials/head', { country, t, seo, schemas, faqs, reqPath }) %>
<%- include('../_partials/nav', { country, t, shortcode }) %>

<main class="container page-container">
    <div class="breadcrumb">
        <a href="/explore">← Back to Capabilities</a> / <span><%= category.name %></span>
    </div>

    <div class="category-hero-layout">
        <div class="category-info">
            <div class="category-header">
                <div class="category-icon-large"><%= category.icon %></div>
                <h1><%= category.name %></h1>
            </div>
            <p class="lead"><%= category.description %></p>
            
            <div class="category-actions">
                <a href="/chat?prompt=I%20need%20help%20with%20<%= encodeURIComponent(category.name) %>" class="btn btn-primary">Start conversation</a>
            </div>

            <% if (category.subCategories && category.subCategories.length > 0) { %>
                <div class="sub-capabilities">
                    <h3>Related Capabilities</h3>
                    <div class="subcat-grid">
                        <% category.subCategories.forEach(sub => { %>
                            <a href="/explore/<%= sub.slug %>" class="subcat-card">
                                <span><%= sub.name %></span>
                                <span class="arrow">→</span>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </div>

        <aside class="category-sidebar">
            <div class="workflow-card">
                <h3>How a Request Can Proceed</h3>
                <ul class="workflow-list">
                    <li>
                        <span class="w-num">1</span>
                        <div>
                            <strong>Describe the need</strong>
                            <p>Start in Web Chat and explain the relevant requirement.</p>
                        </div>
                    </li>
                    <li>
                        <span class="w-num">2</span>
                        <div>
                            <strong>Assess the request</strong>
                            <p>Kurukoo evaluates the request and checks for a supported path.</p>
                        </div>
                    </li>
                    <li>
                        <span class="w-num">3</span>
                        <div>
                            <strong>Review a supported next step</strong>
                            <p>Provider details or a quote are shown only when the required data is available.</p>
                        </div>
                    </li>
                    <li>
                        <span class="w-num">4</span>
                        <div>
                            <strong>Confirm eligible actions</strong>
                            <p>Identity, payment, and escrow steps apply only when their verified integrations are available.</p>
                        </div>
                    </li>
                </ul>
            </div>
        </aside>
    </div>
</main>

<style>
.breadcrumb { margin-bottom: 32px; color: var(--gray-600); font-size: 0.9rem; }
.category-hero-layout { display: grid; grid-template-columns: 1fr 350px; gap: 60px; }
.category-header { display: flex; align-items: center; gap: 20px; margin-bottom: 24px; }
.category-icon-large { font-size: 3.5rem; }
.category-actions { margin: 32px 0 60px; }

.sub-capabilities h3 { margin-bottom: 24px; font-size: 1.25rem; }
.subcat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
.subcat-card { 
    padding: 16px 20px; background: var(--white); border: 1px solid var(--gray-200); 
    border-radius: var(--border-radius); display: flex; justify-content: space-between; align-items: center;
}
.subcat-card:hover { border-color: var(--terracotta); }

.workflow-card { padding: 32px; background: var(--gray-50); border-radius: var(--border-radius-lg); }
.workflow-card h3 { margin-bottom: 24px; }
.workflow-list { list-style: none; display: flex; flex-direction: column; gap: 24px; }
.workflow-list li { display: flex; gap: 16px; }
.w-num { 
    width: 28px; height: 28px; border-radius: 50%; background: var(--terracotta); color: white;
    display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0;
}
.workflow-list strong { display: block; font-size: 0.95rem; margin-bottom: 4px; }
.workflow-list p { font-size: 0.85rem; color: var(--gray-600); margin: 0; }

@media (max-width: 900px) {
    .category-hero-layout { grid-template-columns: 1fr; }
}
</style>

<%- include('../_partials/footer') %>
