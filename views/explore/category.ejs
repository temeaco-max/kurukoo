<%- include('../_partials/head', { country, t, seo, schemas, faqs, reqPath }) %>
<%- include('../_partials/nav', { country, t, shortcode }) %>
<%
  const iconMap = {
    food:'package', drinks:'package', transport:'discover', 'errands-delivery':'package', workers:'work', repairs:'settings', emergency:'safety', 'safety-security':'safety', health:'safety', wellness:'saved', 'personal-care':'settings', education:'document', tutoring:'document', events:'calendar', entertainment:'discover', accommodation:'home', 'property-real-estate':'home', logistics:'package', 'professional-services':'work', 'creative-arts':'work', tourism:'discover', fitness:'work', automotive:'settings', 'automotive-care':'settings'
  };
  const iconId = iconMap[category.slug] || 'request';
%>

<main class="container page-container public-category-page">
    <div class="breadcrumb"><a class="public-return-link" href="/explore"><span aria-hidden="true">←</span> Back to capabilities</a><span aria-hidden="true">/</span><span><%= category.name %></span></div>

    <div class="category-hero-layout">
        <div class="category-info">
            <div class="category-header">
                <div class="category-icon-large" aria-hidden="true"><svg class="k-icon k-icon--lg"><use href="/icons/kurukoo-icons.svg#<%= iconId %>"></use></svg></div>
                <div><span class="eyebrow">Capability pathway</span><h1><%= category.name %></h1></div>
            </div>
            <p class="lead"><%= category.description %></p>
            <div class="public-note"><strong>State boundary:</strong> this page explains the request pathway. It does not by itself mean a provider, price, inventory, payment or fulfilment outcome is confirmed.</div>
            <div class="category-actions public-action-row"><a href="/chat?prompt=I%20need%20help%20with%20<%= encodeURIComponent(category.name) %>" class="btn btn-primary">Start conversation</a><a href="/explore" class="btn btn-outline">Browse capabilities</a></div>

            <% if (category.subCategories && category.subCategories.length > 0) { %>
                <div class="sub-capabilities">
                    <h2>Related Capabilities</h2>
                    <div class="subcat-grid">
                        <% category.subCategories.forEach(sub => { %>
                            <a href="/explore/<%= sub.slug %>" class="subcat-card"><span><%= sub.name %></span><span class="arrow" aria-hidden="true">→</span></a>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </div>

        <aside class="category-sidebar">
            <div class="workflow-card public-surface-panel">
                <span class="eyebrow">Request lifecycle</span>
                <h2>How a Request Can Proceed</h2>
                <ul class="workflow-list">
                    <li><span class="w-num">1</span><div><strong>Describe the need</strong><p>Start in Web Chat and explain the relevant requirement.</p></div></li>
                    <li><span class="w-num">2</span><div><strong>Assess the request</strong><p>Kurukoo evaluates the request and checks for a supported path.</p></div></li>
                    <li><span class="w-num">3</span><div><strong>Review a supported next step</strong><p>Provider details or a quote are shown only when the required data is available.</p></div></li>
                    <li><span class="w-num">4</span><div><strong>Confirm eligible actions</strong><p>Identity, payment and fulfilment steps apply only when their verified integrations are available.</p></div></li>
                </ul>
            </div>
        </aside>
    </div>
</main>

<%- include('../_partials/footer') %>
