<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>Artifacts · Kurukoo</title>
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-client-foundation.css?v=2">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=5">
  <link rel="stylesheet" href="/css/kurukoo-os-architecture.css?v=1">
  <style>
    .artifacts-page{min-height:100vh;background:var(--k-bg,#f7f7f4)}.artifacts-wrap{max-width:1180px;margin:0 auto;padding:32px 28px 64px}.artifacts-top{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:22px}.artifacts-top h1{margin:0 0 6px;font-size:34px}.artifacts-top p{margin:0;color:#68706b;max-width:720px;line-height:1.55}.artifact-storage{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px;border:1px solid #dfdfd8;background:#fff;border-radius:18px;margin-bottom:20px}.artifact-storage-copy{display:grid;gap:5px}.artifact-status{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}.artifact-status.connected{color:#21734a}.artifact-status.fallback{color:#9b6a10}.artifact-actions{display:flex;gap:10px;flex-wrap:wrap}.artifact-button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border-radius:11px;text-decoration:none;border:1px solid #d8dad2;font-weight:700;font-size:13px}.artifact-button.primary{background:#242923;color:#fff;border-color:#242923}.artifact-toolbar{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-bottom:16px}.artifact-search{flex:1;min-width:240px;min-height:44px;border:1px solid #d8dad2;border-radius:11px;padding:0 14px;background:#fff;font:inherit}.artifact-filters{display:flex;gap:7px;flex-wrap:wrap}.artifact-chip{border:1px solid #d8dad2;background:#fff;border-radius:999px;padding:9px 12px;font-size:12px;font-weight:700;cursor:pointer}.artifact-chip.active{background:#ebece6;border-color:#bbbfb6}.artifact-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.artifact-card{background:#fff;border:1px solid #e0e1da;border-radius:18px;padding:18px;display:grid;gap:13px}.artifact-card-head{display:flex;gap:12px;justify-content:space-between}.artifact-name{font-weight:800;font-size:16px;line-height:1.35}.artifact-meta{font-size:12px;color:#747a74}.artifact-badges{display:flex;gap:6px;flex-wrap:wrap}.artifact-badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:#f0f1ec;color:#5f655e;font-size:11px;font-weight:700}.artifact-badge.ok{background:#eaf5ed;color:#23744c}.artifact-badge.warn{background:#fff4df;color:#986816}.artifact-card-actions{display:flex;gap:8px;flex-wrap:wrap}.artifact-card-actions a,.artifact-card-actions button{font:inherit;border:0;background:none;color:#2b5d42;font-weight:800;cursor:pointer;padding:0}.artifact-empty{padding:50px 20px;text-align:center;color:#70776f;border:1px dashed #d3d5cc;border-radius:18px;background:#fff}.artifact-empty strong{display:block;color:#242923;font-size:18px;margin-bottom:7px}.artifact-filter-hidden{display:none!important}@media(max-width:760px){.artifacts-wrap{padding:22px 15px 50px}.artifacts-top,.artifact-storage{flex-direction:column}.artifact-grid{grid-template-columns:1fr}.artifact-toolbar{align-items:stretch}.artifact-search{min-width:0;width:100%}}
  </style>
</head>
<body class="artifacts-page" data-artifacts-page>
  <main class="artifacts-wrap">
    <div class="artifacts-top"><div><div class="k-app-eyebrow">Kurukoo OS · Artifacts</div><h1>Your files, recordings and receipts</h1><p>Every artifact stays owner-scoped. Kurukoo prefers your connected Google Drive for durable storage and keeps a clear managed fallback when Drive is unavailable.</p></div><a class="artifact-button" href="/app">Back to OS</a></div>
    <section class="artifact-storage">
      <div class="artifact-storage-copy"><span class="artifact-status <%= artifactStorage?.connected ? 'connected' : 'fallback' %>"><%= artifactStorage?.connected ? '● Google Drive connected' : '● Managed fallback active' %></span><strong><%= artifactStorage?.connected ? 'New artifacts can be synced to your Drive.' : 'Your artifacts are still protected; connect Drive for your own cloud archive.' %></strong><span class="artifact-meta"><%= artifactStorage?.reason || 'Least-privilege drive.file scope' %></span></div>
      <div class="artifact-actions"><% if (artifactStorage?.connected) { %><a class="artifact-button" href="/connect">Manage connections</a><% } else { %><a class="artifact-button primary" href="/app/artifacts/connect">Connect Google Drive</a><% } %></div>
    </section>
    <section class="artifact-toolbar"><input id="artifact-search" class="artifact-search" type="search" placeholder="Search files, receipts, voice notes and reports" aria-label="Search artifacts"><div class="artifact-filters"><button class="artifact-chip active" data-filter="all">All</button><button class="artifact-chip" data-filter="document">Documents</button><button class="artifact-chip" data-filter="voice">Voice notes</button><button class="artifact-chip" data-filter="image">Media</button><button class="artifact-chip" data-filter="other">Other</button></div></section>
    <section id="artifact-grid" class="artifact-grid" aria-live="polite"></section>
    <div id="artifact-empty" class="artifact-empty artifact-filter-hidden"><strong>No artifacts match</strong><span>Try another search or category. New files appear here after Kurukoo saves them.</span></div>
  </main>
  <script>
  (()=>{const data=<%- JSON.stringify(artifacts||[]) %>;const grid=document.getElementById('artifact-grid');const empty=document.getElementById('artifact-empty');const search=document.getElementById('artifact-search');let filter='all';const esc=(v)=>String(v??'').replace(/[&<>\"']/g,s=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[s]));const kind=(a)=>a.kind==='voice'?'voice':a.kind==='document'?'document':a.kind==='image'||a.kind==='video'?'image':'other';const fmt=(n)=>{const x=Number(n||0);if(x<1024)return x+' B';if(x<1024*1024)return Math.round(x/1024)+' KB';return (x/1024/1024).toFixed(1)+' MB';};const render=()=>{const q=search.value.trim().toLowerCase();const items=data.filter(a=>(filter==='all'||kind(a)===filter)&&(!q||`${a.filename} ${a.mimeType} ${a.kind}`.toLowerCase().includes(q)));grid.innerHTML=items.map(a=>{const isDrive=a.storageProvider==='google_drive';return `<article class="artifact-card"><div class="artifact-card-head"><div><div class="artifact-name">${esc(a.filename)}</div><div class="artifact-meta">${esc(new Date(a.createdAt).toLocaleString())} · ${fmt(a.bytes)} · ${esc(a.mimeType)}</div></div><div class="artifact-badges"><span class="artifact-badge ${a.durability==='external_verified'?'ok':'warn'}">${isDrive?'Google Drive':'Managed fallback'}</span></div></div><div class="artifact-badges"><span class="artifact-badge">${esc(a.kind)}</span>${a.transcriptStatus==='available'?'<span class="artifact-badge ok">Transcript ready</span>':''}</div><div class="artifact-card-actions"><a href="/api/artifacts/${encodeURIComponent(a.id)}/open" target="_blank" rel="noopener">${isDrive?'Open artifact':'Preview'}</a>${a.externalUrl?`<a href="${esc(a.externalUrl)}" target="_blank" rel="noopener">Open in Drive</a>`:''}<a href="/chat?prompt=${encodeURIComponent('Help me with artifact '+a.filename)}">Use in Chat</a></div></article>`}).join('');empty.classList.toggle('artifact-filter-hidden',items.length>0);};document.querySelectorAll('[data-filter]').forEach((b)=>b.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.classList.remove('active'));b.classList.add('active');filter=b.dataset.filter;render();}));search.addEventListener('input',render);render();})();
  </script>
</body></html>
