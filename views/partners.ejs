<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container page-container">
    <section class="page-header-center">
        <div class="badge-pill">
            Partners
        </div>
        <h1 class="page-title">
            Grow with Kurukoo
        </h1>
        <p class="page-desc">
            Discuss a scoped partnership role — such as local support, distribution, verification, content contribution, or organizational integration.
        </p>
    </section>

    <div class="partner-grid">
        <div class="card partner-card">
            <div class="partner-icon">🤝</div>
            <h2 class="partner-title">Agent Networks</h2>
            <p class="partner-text">Discuss local support, onboarding, or distribution roles that can be verified and configured for the current deployment.</p>
            <a href="/chat?prompt=I%20want%20to%20discuss%20a%20partner%20role%20for%20an%20agent%20network" class="partner-link">Discuss a role →</a>
        </div>
        <div class="card partner-card">
            <div class="partner-icon">🏢</div>
            <h2 class="partner-title">Business & Distributors</h2>
            <p class="partner-text">Discuss products or services that may be represented in a canonical request after the required data, review, and authorization boundaries are configured.</p>
            <a href="/chat?prompt=I%20want%20to%20discuss%20adding%20my%20business%20to%20Kurukoo" class="partner-link">Discuss your business →</a>
        </div>
        <div class="card partner-card">
            <div class="partner-icon">🧾</div>
            <h2 class="partner-title">Verifiers & Experts</h2>
            <p class="partner-text">Discuss verification, review, or specialist expertise roles that can be assigned with explicit authorization.</p>
            <a href="/chat?prompt=I%20want%20to%20discuss%20a%20verification%20or%20expert%20role" class="partner-link">Discuss a role →</a>
        </div>
        <div class="card partner-card">
            <div class="partner-icon">🎥</div>
            <h2 class="partner-title">Content & Media</h2>
            <p class="partner-text">Discuss a contribution role for event coverage, guides, or local insights. Participation and any payment terms require separate confirmation.</p>
            <a href="/chat?prompt=I%20want%20to%20discuss%20a%20content%20contribution%20role" class="partner-link">Discuss contribution →</a>
        </div>
        <div class="card partner-card">
            <div class="partner-icon">🌐</div>
            <h2 class="partner-title">Enterprise & Government</h2>
            <p class="partner-text">Discuss a scoped organizational use case and the required review, security, and operational boundaries.</p>
            <a href="/contact" class="partner-link">Contact us →</a>
        </div>
        <div class="card partner-card">
            <div class="partner-icon">🧰</div>
            <h2 class="partner-title">Tech & Integrations</h2>
            <p class="partner-text">Discuss an API, payment, or logistics capability. An integration is represented only after its connector and authorization boundary are configured.</p>
            <a href="/api-docs" class="partner-link">View API →</a>
        </div>
    </div>
</main>

<%- include('_partials/footer') %>
