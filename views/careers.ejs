<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main>
    <section class="section page-hero-careers">
        <div class="container text-center">
            <span class="badge help-badge">Join the Mission</span>
            <h1 class="page-hero-title mt-16">Help us sort everyday life.</h1>
            <p class="page-hero-subtitle-careers">We're looking for builders, dreamers, and problem solvers to join our team in Lagos and London.</p>
        </div>
    </section>

    <section class="section container">
        <div class="pattern-bg"></div>
        
        <div class="grid grid-2 mb-80 align-center relative z-1">
            <div>
                <h2 class="mb-24 text-2_5rem">Why work at Kurukoo?</h2>
                <p class="text-gray text-1_1rem mb-24">We are building more than just an app; we are building economic infrastructure. Every line of code you write helps a vendor find a customer, a driver find a rider, and a community save together.</p>
                <div class="flex-col gap-16">
                    <div class="career-feature">
                        <span class="career-feature-check">✓</span>
                        <div><strong>Hybrid Work</strong>: Flexible office and remote options.</div>
                    </div>
                    <div class="career-feature">
                        <span class="career-feature-check">✓</span>
                        <div><strong>Equity</strong>: Ownership in the platform you build.</div>
                    </div>
                    <div class="career-feature">
                        <span class="career-feature-check">✓</span>
                        <div><strong>Health & Wellness</strong>: Comprehensive coverage for you and your family.</div>
                    </div>
                </div>
            </div>
            <div class="card bg-white border-none p-0 overflow-hidden h-400 flex-center text-8rem">
                🚀
            </div>
        </div>

        <h2 class="mb-40 text-center">Open Roles</h2>
        <div class="grid grid-1 flex-col gap-20 relative z-1">
            <div class="card job-card">
                <div>
                    <span class="category-tag">Engineering</span>
                    <h3 class="job-card-title">Senior Full-Stack Engineer</h3>
                    <p class="text-gray text-0_9rem">Lagos, Nigeria • Full-time</p>
                </div>
                <a href="#" class="btn btn-primary">Apply Now</a>
            </div>
            
            <div class="card job-card">
                <div>
                    <span class="category-tag">Design</span>
                    <h3 class="job-card-title">Product Designer (UX/UI)</h3>
                    <p class="text-gray text-0_9rem">London, UK • Hybrid</p>
                </div>
                <a href="#" class="btn btn-primary">Apply Now</a>
            </div>
            
            <div class="card job-card">
                <div>
                    <span class="category-tag">Operations</span>
                    <h3 class="job-card-title">Growth & Operations Lead</h3>
                    <p class="text-gray text-0_9rem">Accra, Ghana • Full-time</p>
                </div>
                <a href="#" class="btn btn-primary">Apply Now</a>
            </div>
        </div>
    </section>
</main>

