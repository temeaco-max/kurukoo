<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main>
    <section class="section blog-hero">
        <div class="container">
            <span class="badge blog-badge">The Kurukoo Blog</span>
            <h1 class="blog-hero-title">Ideas, Updates &amp; Stories</h1>
            <p class="blog-hero-desc">Notes about conversation-first requests, product boundaries, and the network model.</p>
        </div>
    </section>

    <section class="section container">
        <div class="pattern-bg"></div>
        <article class="article-card featured-article">
            <div class="article-img featured-article-img">📱</div>
            <div class="article-content featured-article-content">
                <span class="category-tag">Engineering</span>
                <h2 class="featured-article-h2">How a conversation-first request stays in context.</h2>
                <p class="featured-article-p">A practical look at the Web Chat request flow, identity gates, and the boundaries between supported and planned access channels.</p>
                <div class="author-row">
                    <div class="author-avatar">K</div>
                    <div class="author-info">
                        <div class="author-name">Kurukoo product note</div>
                        <div class="author-meta">Publication preview</div>
                    </div>
                </div>
            </div>
        </article>

        <div class="grid grid-3">
            <article class="article-card">
                <div class="article-img article-icon-center">🤝</div>
                <div class="article-content">
                    <span class="category-tag">Community</span>
                    <h3 class="article-h3">Participation and economic requests</h3>
                    <p class="article-desc">A forthcoming note on how participants, providers, and contributors remain distinct within the request lifecycle.</p>
                    <span class="article-read-more" aria-label="Publication preview">Publication preview</span>
                </div>
            </article>
            <article class="article-card">
                <div class="article-img article-icon-center">⚡</div>
                <div class="article-content">
                    <span class="category-tag">Product</span>
                    <h3 class="article-h3">Location-aware request context</h3>
                    <p class="article-desc">Location-related information is presented only when the applicable data and request path are available.</p>
                    <span class="article-read-more" aria-label="Publication preview">Publication preview</span>
                </div>
            </article>
            <article class="article-card">
                <div class="article-img article-icon-center">🏙️</div>
                <div class="article-content">
                    <span class="category-tag">Deployment</span>
                    <h3 class="article-h3">Availability by deployment</h3>
                    <p class="article-desc">Kurukoo publishes channels, integrations, and coverage only after they are configured and verified for a deployment.</p>
                    <span class="article-read-more" aria-label="Publication preview">Publication preview</span>
                </div>
            </article>
        </div>
    </section>

    <section class="section newsletter-section">
        <div class="container text-center">
            <h2>Follow product updates</h2>
            <p class="newsletter-desc">Email subscriptions are not configured in this deployment. Use Web Chat if you need to discuss a request or product boundary.</p>
            <a href="/chat?prompt=I%20want%20to%20discuss%20a%20Kurukoo%20product%20update" class="btn btn-primary">Open Web Chat</a>
        </div>
    </section>
</main>

<%- include('_partials/footer') %>
