<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Continue with Kurukoo</title>
  <meta name="description" content="Continue your Kurukoo conversation securely with progressive identity.">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=1.2.0"><link rel="stylesheet" href="/css/kurukoo-auth.css?v=7">
</head>
<body class="kurukoo-auth-page">
<main class="conversation-auth-shell">
  <section class="conversation-auth-intro"><a href="/chat" class="auth-brand"><img src="/assets/brand/logo-icon.svg" alt="Kurukoo" width="42" height="42"><span>Kurukoo</span></a><div class="auth-intro-copy"><span class="auth-kicker">Continue your conversation</span><h1>Let’s keep going.</h1><p>Start in guest chat. When a request needs your identity, use email to continue without SMS, or use the existing phone verification path.</p><div class="auth-principles"><div><strong>One conversation</strong><span>Your requests stay connected.</span></div><div><strong>Progressive identity</strong><span>Kurukoo asks for only what the next step needs.</span></div><div><strong>Phone stays primary</strong><span>Email is a credential, not a replacement for your phone identity.</span></div></div></div></section>
  <section class="conversation-auth-card" aria-labelledby="auth-title"><img src="/assets/brand/logo-icon.svg" alt="Kurukoo" class="auth-card-logo" width="48" height="48"><span class="auth-kicker">Kurukoo identity</span><h2 id="auth-title">Continue securely.</h2><p id="auth-subtitle">You can keep using Kurukoo as a guest. Choose email if you want a passwordless continuation, or phone code when phone verification is required.</p>
    <div class="auth-progress"><span class="active" id="progress-1"></span><span id="progress-2"></span><span id="progress-3"></span></div>
    <div id="auth-step-name" class="auth-step active"><label for="auth-name">Your name</label><input id="auth-name" class="auth-input" autocomplete="name" placeholder="What should Kurukoo call you?"><button class="auth-button" id="auth-name-next" type="button">Continue to options</button><button class="auth-back" id="auth-guest-back" type="button">No account yet — stay in Guest Chat</button></div>
    <div id="auth-step-choice" class="auth-step"><p class="auth-note">Choose the least-friction identity step that fits what you are doing.</p><button class="auth-button" id="auth-magic-mode" type="button">Continue with email link</button><button class="auth-button" id="auth-phone-mode" type="button">Use phone code</button><button class="auth-back" id="auth-choice-back" type="button">Back</button></div>
    <div id="auth-step-magic" class="auth-step"><label for="auth-magic-email">Email address</label><input id="auth-magic-email" class="auth-input" type="email" autocomplete="email" placeholder="you@example.com"><p class="auth-note">We’ll send a single-use link valid for 10 minutes. No SMS is required. Your phone remains the primary Kurukoo channel identity once proven.</p><button class="auth-button" id="auth-send-magic" type="button">Send magic link</button><button class="auth-back" id="auth-magic-back" type="button">Back</button></div>
    <div id="auth-step-phone" class="auth-step"><label for="auth-phone">Best phone number</label><div class="auth-phone"><select id="auth-prefix" class="auth-input" aria-label="Country code"><option value="+234" <%= country === 'ng' ? 'selected' : '' %>>+234</option><option value="+233" <%= country === 'gh' ? 'selected' : '' %>>+233</option><option value="+44" <%= country === 'gb' ? 'selected' : '' %>>+44</option></select><input id="auth-phone" class="auth-input" type="tel" inputmode="tel" autocomplete="tel" placeholder="803 000 0000"></div><p class="auth-note" id="auth-delivery-note">We'll send a one-time verification code. You do not need a password.</p><button class="auth-button" id="auth-send-code" type="button">Send verification code</button><button class="auth-back" id="auth-phone-back" type="button">Back</button></div>
    <div id="auth-step-code" class="auth-step"><div class="auth-sent">Code sent to <strong id="auth-phone-display"></strong></div><label for="auth-code">Verification code</label><input id="auth-code" class="auth-input auth-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000"><button class="auth-button" id="auth-verify-code" type="button">Verify and continue</button><div class="auth-actions"><button class="auth-back" id="auth-code-back" type="button">Change number</button><button class="auth-back" id="auth-resend" type="button">Resend code</button></div></div>
    <div id="auth-feedback" class="auth-feedback" hidden role="status" aria-live="polite"></div><div id="auth-test-banner" class="auth-feedback" hidden role="status" aria-live="polite">Development test authentication is active for the configured test identity. The production OTP flow is unchanged.</div>
    <p class="auth-legal">By continuing, you agree to Kurukoo's <a href="/legal/terms">Terms</a> and <a href="/legal/privacy">Privacy Policy</a>. Kurukoo is not an emergency service.</p>
    <a class="auth-return" href="/chat">← Back to chat</a>
  </section>
</main>
<script>
(() => {
  const $ = id => document.getElementById(id);
  const returnTo = <%- JSON.stringify(returnTo || '') %>;
  const conversationId = <%- JSON.stringify(conversationId || '') %>;
  const guestId = <%- JSON.stringify(guestId || '') %>;
  let name = '';
  let phone = '';
  let email = '';
  let verificationMode = 'phone';
  const testAuthEnabled = <%- JSON.stringify(Boolean(testAuth?.active && testAuth?.configured)) %>;
  if (testAuthEnabled) $('auth-test-banner').hidden = false;
  const safeReturnTo = () => { try { const url = new URL(returnTo || '/desk', window.location.origin); return url.origin === window.location.origin && url.pathname.startsWith('/') ? `${url.pathname}${url.search}${url.hash}` : '/desk'; } catch (_) { return '/desk'; } };
  const setStep = step => {
    const steps = ['name','choice','magic','phone','code'];
    steps.forEach(s => $('auth-step-' + s).classList.toggle('active', s === step));
    const progress = {name:1,choice:2,magic:2,phone:2,code:3}[step] || 1;
    [1,2,3].forEach(n => $('progress-' + n).classList.toggle('active', n <= progress));
    const copy = {
      name:['Continue securely.','You can keep using Kurukoo as a guest. Choose the least-friction identity step when you need one.'],
      choice:['Choose how to continue.','Email is passwordless continuity. Phone code remains the canonical phone verification path.'],
      magic:['Continue with email.','A one-time link can restore your conversation without SMS.'],
      phone:['Verify your phone.','Use the existing phone verification path when a phone-proven action is required.'],
      code:['Confirm it’s you.','Enter the one-time code we sent.']
    };
    $('auth-title').textContent = copy[step][0]; $('auth-subtitle').textContent = copy[step][1];
  };
  const feedback = (message, error=false) => { $('auth-feedback').hidden = !message; $('auth-feedback').textContent = message || ''; $('auth-feedback').className = 'auth-feedback' + (error ? ' error' : ''); };
  const normalizePhone = () => { let raw = String($('auth-phone').value || '').replace(/\D/g,''); if(raw.startsWith('0')) raw = raw.slice(1); return $('auth-prefix').value + raw; };
  $('auth-name-next').addEventListener('click', () => { name = $('auth-name').value.trim(); if(!name) return feedback('Tell me what I should call you.', true); feedback(''); setStep('choice'); });
  $('auth-guest-back').addEventListener('click', () => window.location.assign(safeReturnTo()));
  $('auth-choice-back').addEventListener('click', () => setStep('name'));
  $('auth-magic-mode').addEventListener('click', () => { verificationMode = 'magic'; feedback(''); setStep('magic'); $('auth-magic-email').focus(); });
  $('auth-phone-mode').addEventListener('click', () => { verificationMode = 'phone'; feedback(''); setStep('phone'); $('auth-phone').focus(); });
  $('auth-magic-back').addEventListener('click', () => setStep('choice'));
  $('auth-phone-back').addEventListener('click', () => setStep('choice'));
  $('auth-send-magic').addEventListener('click', async () => {
    email = $('auth-magic-email').value.trim().toLowerCase();
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return feedback('Enter a valid email address.', true);
    const button = $('auth-send-magic'); button.disabled = true; button.textContent = 'Sending…'; feedback('');
    try {
      const response = await fetch('/api/auth/request-magic-link',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({email,name,guestPhone:guestId||undefined,returnPath:safeReturnTo(),conversationId:conversationId||undefined})});
      const data = await response.json().catch(()=>({}));
      if(!response.ok || !data.success) throw new Error(data.message || 'Could not send the magic link.');
      feedback(data.debugUrl ? `Development link ready: ${data.debugUrl}` : 'Magic link sent. Open it from your email to continue.');
    } catch(error){ feedback(error.message || 'Could not send the magic link.', true); } finally { button.disabled=false; button.textContent='Send magic link'; }
  });
  $('auth-send-code').addEventListener('click', async () => {
    phone = normalizePhone(); if(phone.length < 10) return feedback('Enter a valid phone number.', true);
    const button = $('auth-send-code'); button.disabled = true; button.textContent = 'Sending…'; feedback('');
    try { const response = await fetch('/api/auth/request-otp',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone})}); const data=await response.json(); if(!response.ok || !data.success) throw new Error(data.error || data.message || 'Could not send a verification code.'); $('auth-phone-display').textContent=phone; setStep('code'); $('auth-code').focus(); if(data.testMode) { $('auth-test-banner').hidden=false; feedback(`Development test code: ${data.devCode}`); } else if(data.debugCode) feedback(`Development verification code: ${data.debugCode}`); }
    catch(error){ feedback(error.message || 'Could not send a verification code.',true); } finally { button.disabled=false; button.textContent='Send verification code'; }
  });
  $('auth-resend').addEventListener('click', () => $('auth-send-code').click());
  $('auth-code-back').addEventListener('click', () => setStep('phone'));
  $('auth-verify-code').addEventListener('click', async () => {
    const code = $('auth-code').value.trim(); if(!/^\d{6}$/.test(code)) return feedback('Enter the 6-digit code.',true);
    const button=$('auth-verify-code'); button.disabled=true; button.textContent='Checking…'; feedback('');
    try { const response=await fetch('/api/auth/verify-otp',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone,code,name,guestPhone:guestId||undefined,conversationId:conversationId||undefined})}); const data=await response.json(); if(!response.ok || !data.success) throw new Error(data.error || data.message || 'That code could not be verified.'); if(data.token) localStorage.setItem('kurukoo_auth_token',data.token); localStorage.setItem('kurukoo_user_phone',data.phone || phone); localStorage.setItem('kurukoo_user_name',name); feedback(`You’re signed in, ${name}. Returning to your conversation…`); window.setTimeout(()=>window.location.assign(safeReturnTo()),450); }
    catch(error){ feedback(error.message || 'Verification failed. Try again.',true); button.disabled=false; button.textContent='Verify and continue'; }
  });
  $('auth-code').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g,'').slice(0,6); if(e.target.value.length===6) $('auth-verify-code').focus(); });
})();
</script>
</body>
</html>
