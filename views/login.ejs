<%- include('_partials/head') %>
<link rel="stylesheet" href="/css/kurukoo-auth.css?v=1.0.0">

<main class="auth-page">
  <div class="auth-shell">
    <section class="auth-story" aria-labelledby="auth-story-title">
      <a class="auth-brand" href="/" aria-label="Kurukoo home"><span class="auth-brand-mark">K</span><span>Kurukoo</span></a>
      <div>
        <div class="auth-kicker">Your conversation comes first</div>
        <h1 class="auth-title" id="auth-story-title">Tell Kurukoo what you need. Kurukoo figures out who or what can fulfil it.</h1>
        <p class="auth-copy">You do not need to learn a marketplace, choose a category, or know who can help. Start with what you need. Your Kurukoo identity lets you save the conversation, continue later, communicate with people involved, and securely complete protected actions.</p>
        <div class="auth-points">
          <div class="auth-point"><span class="auth-point-mark">✓</span><span>One identity for your Kurukoo conversations and requests.</span></div>
          <div class="auth-point"><span class="auth-point-mark">✓</span><span>Resume a request when you leave and come back.</span></div>
          <div class="auth-point"><span class="auth-point-mark">✓</span><span>Identity is requested when a protected action actually needs it.</span></div>
        </div>
      </div>
      <p class="auth-note">Kurukoo uses phone verification for this entry flow. Other sign-in providers will only appear when a real, configured integration is available.</p>
    </section>

    <section class="auth-card" aria-labelledby="auth-card-title">
      <div class="auth-step" data-auth-step="phone">
        <h2 id="auth-card-title">Continue with Kurukoo</h2>
        <p class="auth-card-intro">Enter your phone number. We will send a verification code. New here? You are registering as you continue.</p>
        <form id="auth-phone-form" novalidate>
          <label class="auth-label" for="auth-phone">Phone number</label>
          <div class="auth-phone-row">
            <select id="auth-prefix" class="auth-input auth-select" aria-label="Country code"><option value="+234" <%= country === 'ng' ? 'selected' : '' %>>🇳🇬 +234</option><option value="+233" <%= country === 'gh' ? 'selected' : '' %>>🇬🇭 +233</option><option value="+44" <%= country === 'gb' ? 'selected' : '' %>>🇬🇧 +44</option></select>
            <input id="auth-phone" class="auth-input" type="tel" inputmode="numeric" autocomplete="tel" placeholder="803 000 0000" required>
          </div>
          <p class="auth-helper">Your number becomes the verified identity Kurukoo uses across supported access points.</p>
          <div class="auth-actions"><button class="auth-button" type="submit">Send verification code</button></div>
        </form>
        <div class="auth-links"><a href="/">Back to Kurukoo</a><a href="/legal/privacy">Privacy</a></div>
      </div>

      <div class="auth-step" data-auth-step="otp" hidden>
        <h2>Verify your number</h2>
        <p class="auth-card-intro">Enter the code sent to <strong id="auth-requested-phone"></strong>.</p>
        <form id="auth-otp-form" novalidate>
          <label class="auth-label" for="auth-otp">Verification code</label>
          <input id="auth-otp" class="auth-input auth-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="••••••" required>
          <p class="auth-helper">If you did not receive a code, go back and check the number.</p>
          <div class="auth-actions"><button class="auth-button" type="submit">Verify and continue</button><button class="auth-button auth-secondary" type="button" data-auth-back>Change number</button></div>
        </form>
      </div>

      <div class="auth-step" data-auth-step="profile" hidden>
        <h2>Make Kurukoo yours</h2>
        <p class="auth-card-intro">You are verified. These details are optional and can be changed later.</p>
        <form id="auth-profile-form" novalidate>
          <input id="auth-return" type="hidden" value="/chat">
          <div class="auth-profile-grid">
            <div><label class="auth-label" for="auth-name">Name <span class="auth-helper">(optional)</span></label><input id="auth-name" class="auth-input" type="text" autocomplete="name" placeholder="What should Kurukoo call you?"></div>
            <div><label class="auth-label" for="auth-email">Email <span class="auth-helper">(optional)</span></label><input id="auth-email" class="auth-input" type="email" autocomplete="email" placeholder="For account communication when configured"></div>
            <div><label class="auth-label" for="auth-goal">What are you mainly here to do?</label><select id="auth-goal" class="auth-input"><option value="buyer">Get something done / buy</option><option value="provider">Offer skills or services</option><option value="business">Run or grow a business</option></select></div>
          </div>
          <label class="auth-consent"><input type="checkbox" required> <span>I understand that Kurukoo may use my account information to maintain my requests, conversations and protected actions.</span></label>
          <div class="auth-actions"><button class="auth-button" type="submit">Continue to my conversation</button><button class="auth-button auth-secondary" type="button" data-auth-skip-profile>Skip optional details</button></div>
        </form>
      </div>

      <div id="auth-feedback" class="auth-feedback" hidden role="status" aria-live="polite"></div>
      <div class="auth-footer">You remain in control of your account. <a href="/legal/privacy">Read the privacy policy</a>.</div>
    </section>
  </div>
</main>

<script src="/js/kurukoo-auth.js?v=1.0.0" defer></script>
</body>
</html>
