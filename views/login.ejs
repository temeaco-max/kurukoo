<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Continue with Kurukoo</title>
  <meta name="description" content="Continue your Kurukoo conversation securely with phone verification.">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=1.2.0"><link rel="stylesheet" href="/css/kurukoo-auth.css?v=3">
</head>
<body class="kurukoo-auth-page">
  <main class="conversation-auth-shell">
    <section class="conversation-auth-intro">
      <a href="/chat" class="auth-brand"><img src="/assets/brand/logo-icon.svg" alt="Kurukoo" width="42" height="42"><span>Kurukoo</span></a>
      <div class="auth-intro-copy">
        <span class="auth-kicker">Continue your conversation</span>
        <h1>Tell Kurukoo what you need. Kurukoo figures out who or what can fulfil it.</h1>
        <p>Start as a guest, then verify your phone when a request needs an identity. Your existing conversation and request stay connected when you return.</p>
        <div class="auth-principles"><div><strong>One conversation</strong><span>Your requests stay connected.</span></div><div><strong>One account</strong><span>Your phone is your account identity.</span></div><div><strong>One-time code</strong><span>No password to remember.</span></div></div>
      </div>
    </section>

    <section class="conversation-auth-card" aria-labelledby="auth-title">
      <img src="/assets/brand/logo-icon.svg" alt="Kurukoo" class="auth-card-logo" width="48" height="48">
      <span class="auth-kicker">Kurukoo identity</span><h2 id="auth-title">Continue your conversation</h2>
      <p id="auth-subtitle">Verify your phone to save this request and keep your Kurukoo context together. If a supported payment step applies, verified payment is available only when a payment provider has been configured.</p>
      <input id="auth-return" type="hidden" value="<%= returnTo || '/chat' %>">
      <input id="auth-guest-phone" type="hidden" value="<%= guestId || '' %>">
      <input id="auth-conversation-id" type="hidden" value="<%= conversationId || '' %>">

      <form id="auth-phone-form" class="auth-step active" data-auth-step="phone">
        <label for="auth-phone">Best phone number</label>
        <div class="auth-phone"><select id="auth-prefix" class="auth-input" aria-label="Country code"><option value="+234" <%= country === 'ng' ? 'selected' : '' %>>+234</option><option value="+233" <%= country === 'gh' ? 'selected' : '' %>>+233</option><option value="+44" <%= country === 'gb' ? 'selected' : '' %>>+44</option></select><input id="auth-phone" class="auth-input" type="tel" inputmode="tel" autocomplete="tel" placeholder="803 000 0000" required></div>
        <p class="auth-note">We will send a one-time verification code. You do not need a password.</p><button class="auth-button" type="submit">Send verification code</button>
      </form>

      <form id="auth-otp-form" class="auth-step" data-auth-step="otp" hidden>
        <p class="auth-sent">Code sent to <strong id="auth-requested-phone"></strong></p><label for="auth-otp">Verification code</label><input id="auth-otp" class="auth-input auth-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="8" placeholder="000000" required><button class="auth-button" type="submit">Verify and continue</button><button class="auth-back" data-auth-back type="button">Change number</button>
      </form>

      <form id="auth-profile-form" class="auth-step" data-auth-step="profile" hidden>
        <label for="auth-name">What should Kurukoo call you? <span class="optional">Optional</span></label><input id="auth-name" class="auth-input" autocomplete="name" placeholder="Your name"><label for="auth-email">Email <span class="optional">Optional</span></label><input id="auth-email" class="auth-input" type="email" autocomplete="email" placeholder="you@example.com"><label for="auth-goal">What would you like to do first?</label><select id="auth-goal" class="auth-input"><option value="buyer">Get something done</option><option value="provider">Offer a skill or service</option><option value="explore">Explore Kurukoo</option></select><button class="auth-button" type="submit">Save and continue</button><button class="auth-back" data-auth-skip-profile type="button">Skip for now</button>
      </form>

      <div id="auth-feedback" class="auth-feedback" hidden role="status" aria-live="polite"></div>
      <p class="auth-legal">By continuing, you agree to Kurukoo's <a href="/legal/terms">Terms</a> and <a href="/legal/privacy">Privacy Policy</a>. Kurukoo is not an emergency service.</p><a class="auth-return" href="/chat">← Back to chat</a>
    </section>
  </main>
  <script src="/js/kurukoo-auth.js?v=2" defer></script>
</body>
</html>
