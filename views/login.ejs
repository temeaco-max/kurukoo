<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container page-container login-page-container">
    <div class="login-split-grid">
        <!-- Left Side: Informational / Value Proposition -->
        <section class="login-info-side">
            <div class="badge-pill login-badge">
                ✦ Living Economic Profile
            </div>
            <h1 class="login-title">
                One account. One memory. All your economic life in one conversation.
            </h1>
            <p class="login-desc">
                Kurukoo is your conversational utility. It learns who you are as you use it — remembering your skills, orders, and trusted connections without repetitive sign-up forms.
            </p>

            <div class="login-benefits-list">
                <div class="login-benefit-item">
                    <div class="login-benefit-icon">💬</div>
                    <div class="login-benefit-text">
                        <strong class="login-benefit-title">One secure profile</strong>
                        <p class="login-benefit-sub">Your account keeps your requests and conversation context together whenever you return to Web Chat.</p>
                    </div>
                </div>

                <div class="login-benefit-item">
                    <div class="login-benefit-icon">🛡️</div>
                    <div class="login-benefit-text">
                        <strong class="login-benefit-title">Protected transaction lifecycle</strong>
                        <p class="login-benefit-sub">Eligible requests can follow a documented payment and escrow lifecycle after verified payment is available.</p>
                    </div>
                </div>

                <div class="login-benefit-item">
                    <div class="login-benefit-icon">📍</div>
                    <div class="login-benefit-text">
                        <strong class="login-benefit-title">Request context</strong>
                        <p class="login-benefit-sub">Continue a saved request, review matching details, and return to the conversation without starting over.</p>
                    </div>
                </div>

                <div class="login-benefit-item">
                    <div class="login-benefit-icon">⚡</div>
                    <div class="login-benefit-text">
                        <strong class="login-benefit-title">Secure phone verification</strong>
                        <p class="login-benefit-sub">Use a one-time verification code to protect your account before taking protected actions.</p>
                    </div>
                </div>
            </div>

            <div class="login-trust-footer">
                <div class="login-trust-badge">
                    <span class="trust-icon">🔒</span>
                    <span class="trust-text">Review how Kurukoo handles account information in the Privacy Policy before continuing.</span>
                </div>
            </div>
        </section>

        <!-- Right Side: Fields + SSO Login -->
        <section class="login-form-side">
            <div class="card auth-card">
                <div class="auth-card-header">
                    <h2 class="auth-card-title"><%= returnTo ? 'Continue with Kurukoo' : 'Sign In or Register' %></h2>
                    <p class="auth-card-subtitle">
                        <%= returnTo ? 'Sign in to proceed with your request.' : 'Enter your phone number to continue.' %>
                    </p>
                </div>

                <!-- Phone Entry Form -->
                <form id="kurukoo-login-form" class="auth-form">
                    <div id="phone-entry-section">
                        <div class="form-group">
                            <label for="login-phone" class="form-label">Phone Number <span class="label-required">*</span></label>
                            <div class="phone-input-group">
                                <select id="login-prefix" class="phone-prefix-select" aria-label="Country Dial Code">
                                    <option value="+234" <%= country === 'ng' ? 'selected' : '' %>>🇳🇬 +234</option>
                                    <option value="+233" <%= country === 'gh' ? 'selected' : '' %>>🇬🇭 +233</option>
                                    <option value="+44" <%= country === 'gb' ? 'selected' : '' %>>🇬🇧 +44</option>
                                </select>
                                <input type="tel" id="login-phone" class="form-input phone-number-input" placeholder="803 000 0000" required autocomplete="tel">
                            </div>
                            <span class="field-hint">We'll send a verification code to this number.</span>
                        </div>

                        <div class="form-group">
                            <label for="login-name" class="form-label">Full Name <span class="label-optional">(optional)</span></label>
                            <input type="text" id="login-name" class="form-input" placeholder="e.g. Chinedu Okafor" autocomplete="name">
                        </div>

                        <button type="submit" class="btn btn-primary btn-block auth-submit-btn" id="login-submit-btn">
                            <span id="login-submit-text">Send Verification Code</span>
                            <span class="btn-arrow">→</span>
                        </button>
                    </div>

                    <!-- OTP Entry Section (hidden by default) -->
                    <div id="otp-entry-section" hidden>
                        <div class="form-group">
                            <label for="login-otp" class="form-label">Verification Code <span class="label-required">*</span></label>
                            <input type="text" id="login-otp" class="form-input otp-input" placeholder="000000" maxlength="6" inputmode="numeric">
                            <span class="field-hint">Enter the 6-digit code sent to your phone.</span>
                        </div>

                        <button type="button" class="btn btn-primary btn-block auth-submit-btn" id="otp-verify-btn">
                            <span>Verify & Continue</span>
                            <span class="btn-arrow">→</span>
                        </button>
                        
                        <button type="button" class="btn btn-link btn-block" id="otp-resend-btn" style="margin-top: 12px; font-size: 13px;">
                            Didn't get a code? Resend
                        </button>
                    </div>

                    <div id="auth-feedback" class="auth-feedback" hidden></div>
                </form>

                <div class="auth-alternative-links">
                    <span class="alt-text">Web Chat is the available conversational channel in this deployment.</span>
                    <div class="alt-buttons-row">
                        <a href="/chat" class="alt-link"><span>Open Web Chat</span></a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const loginForm = document.getElementById('kurukoo-login-form');
        const phoneSection = document.getElementById('phone-entry-section');
        const otpSection = document.getElementById('otp-entry-section');
        const feedback = document.getElementById('auth-feedback');
        
        const returnTo = "<%= returnTo %>";
        const guestId = "<%= guestId %>";
        const conversationId = "<%= conversationId %>";

        let currentPhone = '';

        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const prefix = document.getElementById('login-prefix').value;
            const rawPhone = document.getElementById('login-phone').value.trim().replace(/\D/g, '');
            const name = document.getElementById('login-name').value.trim();
            
            if (!rawPhone) return showFeedback('Please enter a phone number.', 'error');
            
            currentPhone = prefix + rawPhone;
            const submitBtn = document.getElementById('login-submit-btn');
            submitBtn.disabled = true;
            
            try {
                const res = await fetch('/api/auth/request-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: currentPhone })
                });
                const data = await res.json();
                
                if (data.success) {
                    phoneSection.hidden = true;
                    otpSection.hidden = false;
                    showFeedback('Code sent! Please check your phone.', 'success');
                    if (data.devCode) {
                        console.log('Development OTP Code:', data.devCode);
                        document.getElementById('login-otp').value = data.devCode;
                    }
                } else {
                    showFeedback(data.error || 'Failed to request code.', 'error');
                    submitBtn.disabled = false;
                }
            } catch (err) {
                showFeedback('Connection error. Please try again.', 'error');
                submitBtn.disabled = false;
            }
        });

        document.getElementById('otp-verify-btn').addEventListener('click', async () => {
            const code = document.getElementById('login-otp').value.trim();
            const name = document.getElementById('login-name').value.trim();
            
            if (!code || code.length !== 6) return showFeedback('Enter the 6-digit code.', 'error');
            
            const verifyBtn = document.getElementById('otp-verify-btn');
            verifyBtn.disabled = true;
            
            try {
                const res = await fetch('/api/auth/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        phone: currentPhone, 
                        code, 
                        name,
                        guestPhone: guestId || undefined
                    })
                });
                const data = await res.json();
                
                if (data.success) {
                    localStorage.setItem('kurukoo_auth_token', data.token);
                    localStorage.setItem('kurukoo_user_phone', data.phone);
                    if (name) localStorage.setItem('kurukoo_user_name', name);
                    
                    showFeedback('Authenticated! Redirecting...', 'success');
                    
                    setTimeout(() => {
                        if (returnTo) {
                            window.location.href = returnTo;
                        } else {
                            window.location.href = '/chat';
                        }
                    }, 800);
                } else {
                    showFeedback(data.error || 'Invalid code.', 'error');
                    verifyBtn.disabled = false;
                }
            } catch (err) {
                showFeedback('Verification failed. Try again.', 'error');
                verifyBtn.disabled = false;
            }
        });

        document.getElementById('otp-resend-btn').addEventListener('click', () => {
            otpSection.hidden = true;
            phoneSection.hidden = false;
            document.getElementById('login-submit-btn').disabled = false;
            showFeedback('', 'info');
        });

        function showFeedback(msg, type) {
            if (!feedback) return;
            feedback.textContent = msg;
            feedback.className = `auth-feedback auth-feedback-${type}`;
            feedback.hidden = !msg;
        }
    });
</script>
