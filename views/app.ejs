<!-- Kurukoo visual system: warm cream/white OS canvas, Space Grotesk hierarchy, Inter UI rhythm, terracotta single-action emphasis, evidence-led states. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= selected.title %> · Kurukoo</title>
  <meta name="description" content="<%= selected.description %>">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-client-foundation.css?v=2">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=5">
  <link rel="stylesheet" href="/css/kurukoo-os-final.css?v=routes1">
  <link rel="stylesheet" href="/css/kurukoo-desktop-final.css?v=routes2">
  <script src="/js/fcm-client.js?v=routes2" defer></script>
</head>
<body class="k-app-page workspace-page k-app-section-<%= section %>" data-workspace-section="<%= section %>" data-app-section="<%= section %>">
  <% const icon = (name) => `<svg class="k-app-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; %>
  <div class="k-app-shell">
    <header class="k-app-header">
      <a href="/" class="k-app-brand"><img src="/assets/brand/logo-icon.png" alt="Kurukoo" width="34" height="34"><span>Kurukoo</span></a>
      <div class="k-app-header-actions">
        <span class="k-app-identity"><strong><%= displayName %></strong><small><%= phone %></small></span>
        <a class="k-app-ask" href="/chat">Ask</a>
      </div>
    </header>
    <aside class="k-app-sidebar" aria-label="Kurukoo application navigation">
      <a class="k-app-new" href="/chat">＋ New conversation</a>
      <nav class="k-app-nav" aria-label="Primary">
        <a class="<%= section === 'desk' ? 'active' : '' %>" href="/desk"><%= icon('chat') %><span>Desk</span></a>
        <a class="<%= section === 'discover' ? 'active' : '' %>" href="/discover"><%= icon('discover') %><span>Discover</span></a>
        <a class="<%= section === 'requests' ? 'active' : '' %>" href="/requests"><%= icon('request') %><span>Requests</span></a>
        <a class="<%= section === 'tasks' ? 'active' : '' %>" href="/tasks"><%= icon('work') %><span>Tasks</span></a>
        <a class="<%= section === 'connect' ? 'active' : '' %>" href="/connect"><%= icon('settings') %><span>Connect</span></a>
      </nav>
      <div class="k-app-divider"></div>
      <nav class="k-app-nav" aria-label="Workspace">
        <a class="<%= section === 'agents' ? 'active' : '' %>" href="/agents"><%= icon('chat') %><span>Agents</span></a>
        <a class="<%= section === 'capabilities' ? 'active' : '' %>" href="/capabilities"><%= icon('work') %><span>Capabilities</span></a>
        <a class="<%= section === 'opportunities' ? 'active' : '' %>" href="/opportunities"><%= icon('discover') %><span>Opportunities</span></a>
        <a class="<%= section === 'topics' ? 'active' : '' %>" href="/topics"><%= icon('discover') %><span>Topics</span></a>
        <a class="<%= section === 'wallet' ? 'active' : '' %>" href="/wallet"><%= icon('points') %><span>Wallet</span></a>
        <a class="<%= section === 'points' ? 'active' : '' %>" href="/points"><%= icon('points') %><span>Points</span></a>
        <a class="<%= section === 'top-up' ? 'active' : '' %>" href="/top-up"><%= icon('points') %><span>Top Up</span></a>
        <a class="<%= section === 'subscriptions' ? 'active' : '' %>" href="/subscriptions"><%= icon('saved') %><span>Subscriptions</span></a>
        <a class="<%= section === 'checkout' ? 'active' : '' %>" href="/checkout"><%= icon('request') %><span>Checkout</span></a>
        <a class="<%= section === 'confirmations' ? 'active' : '' %>" href="/confirmations"><%= icon('success') %><span>Confirmations</span></a>
        <a class="<%= section === 'artifacts' ? 'active' : '' %>" href="/artifacts"><%= icon('saved') %><span>Artifacts</span></a>
        <a class="<%= section === 'prayer' ? 'active' : '' %>" href="/prayer"><%= icon('chat') %><span>Prayer</span></a>
        <a class="<%= section === 'call' ? 'active' : '' %>" href="/call"><%= icon('mic') %><span>Call</span></a>
        <a class="<%= section === 'safety' ? 'active' : '' %>" href="/safety"><%= icon('safety') %><span>Safety</span></a>
      </nav>
      <div class="k-app-divider"></div>
      <nav class="k-app-nav" aria-label="Account">
        <a class="<%= section === 'memory' ? 'active' : '' %>" href="/memory"><%= icon('saved') %><span>Memory</span></a>
        <a class="<%= section === 'notifications' ? 'active' : '' %>" href="/notifications"><%= icon('notification') %><span>Notifications</span></a>
        <a href="/settings"><%= icon('settings') %><span>Settings</span></a>
        <a href="/help"><%= icon('help') %><span>Help</span></a>
      </nav>
    </aside>
    <main class="k-app-main">
      <div class="k-app-container">
        <div class="k-app-eyebrow"><%= selected.eyebrow %></div>
        <div class="k-app-title-row">
          <div><h1><%= selected.title %></h1><p><%= selected.description %></p></div>
          <a class="k-app-primary" href="<%= selected.cta %>"><%= selected.ctaLabel %></a>
        </div>
        <section class="ko-context" aria-label="Kurukoo continuity context">
          <span class="ko-context-mark" aria-hidden="true">K</span>
          <div><div class="ko-context-title"><%= selected.eyebrow %></div><div class="ko-context-meta">This surface remains part of the same Kurukoo relationship. Return to Chat to continue with the exact context, ask a follow-up or take the next supported action.</div></div>
          <a class="ko-context-action" href="/chat">Continue in Chat</a>
        </section>
        <% if (section === 'desk') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Conversation</span><h2>One place to ask, coordinate and continue.</h2><p>Chat remains the source of truth for requests, reminders, safety, memory, agents and actions.</p><a href="/chat" class="k-app-card-action">Open Web Chat →</a></article><article class="k-app-card"><span class="k-app-card-label">Continuity</span><h2>Keep active work alive.</h2><p>Interruption, authentication, pause/resume and cross-channel continuation remain owned by the canonical context layer.</p><a href="/requests" class="k-app-card-action">View Requests →</a></article></section>
        <% } else if (section === 'connect') { %>
          <section class="k-app-card k-connect-workspace" aria-labelledby="connect-workspace-title" data-workspace-owned-surface="connect">
            <div class="k-connect-workspace-head"><div><span class="k-app-card-label">Connection readiness</span><h2 id="connect-workspace-title">Your authorized resources</h2><p>Connections remain owner-authorized and evidence-bound. This surface reports readiness; it does not claim data access, delivery, or action success before the canonical provider callback confirms it.</p></div><a class="k-app-primary" href="/channels">Channel readiness</a></div>
            <div class="k-connect-resource-grid" data-connect-resource-grid aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading canonical connection readiness…</div></div>
            <div class="k-app-empty" data-connect-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Connection readiness is unavailable</h3><p>Kurukoo could not read the canonical connection authority. No provider state is inferred locally.</p><a class="k-app-card-action" href="/connect">Retry Connect →</a></div></div>
          </section>
          <section class="k-app-grid two k-connect-boundary-grid" data-workspace-owned-surface="connect"><article class="k-app-card"><span class="k-app-card-label">Channels</span><h2>WhatsApp · Telegram · Push</h2><p>Pairing, notification permissions, device delivery and linked-channel receipt remain separate provider and device states.</p><a href="/channels" class="k-app-card-action">View channel readiness →</a></article><article class="k-app-card"><span class="k-app-card-label">Source boundary</span><h2>Sheets · Notion · Microsoft</h2><p>Bounded owner-authorized reads preserve one identity and memory boundary without creating a background mirror.</p><a href="/chat?prompt=Help%20me%20manage%20my%20connected%20sources" class="k-app-card-action">Continue in Chat →</a></article></section>
        <% } else if (section === 'wallet' || section === 'points' || section === 'top-up' || section === 'subscriptions') { %>
          <section class="k-app-grid three"><article class="k-app-card"><span class="k-app-card-label">Wallet</span><h2>Money controls</h2><p>Wallet state is separate from provider success and always reflects canonical economic evidence.</p><a href="/wallet" class="k-app-card-action">Wallet →</a></article><article class="k-app-card"><span class="k-app-card-label">Points</span><h2>Closed-loop utility</h2><p>Points remain independent from cash payment rails and can be governed without a payment provider.</p><a href="/points" class="k-app-card-action">Points →</a></article><article class="k-app-card"><span class="k-app-card-label">Billing</span><h2>Top Up &amp; Subscriptions</h2><p>These surfaces remain ready even when the live payment provider is disabled or awaiting verification.</p><div><a href="/top-up" class="k-app-card-action">Top Up →</a> · <a href="/subscriptions" class="k-app-card-action">Subscriptions →</a></div></article></section>
        <% } else if (section === 'checkout' || section === 'confirmations') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Economic truth</span><h2>Explicit confirmation before irreversible action.</h2><p>Checkout and confirmations use canonical request state, payment policy and evidence. UI never turns intent into claimed success.</p><a href="/requests" class="k-app-card-action">View Requests →</a></article><article class="k-app-card"><span class="k-app-card-label">Recovery</span><h2>Continue, retry or recover.</h2><p>Failed, pending, cancelled and completed states remain visible and resumable without losing the originating conversation.</p><a href="/chat" class="k-app-card-action">Continue in Chat →</a></article></section>
        <% } else if (section === 'requests') { %>
          <section class="k-app-grid three k-request-metrics" aria-label="Canonical Economic Request summary" data-workspace-owned-surface="requests">
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Work in motion</span><strong data-request-metric="open">—</strong><p>Canonical requests that remain active in sourcing, matching, quoting, payment, fulfilment or recovery.</p></article>
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Needs your action</span><strong data-request-metric="action">—</strong><p>Only explicit confirmation or payment-pending states appear here; a request is not completed by display alone.</p></article>
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Completed</span><strong data-request-metric="completed">—</strong><p>Only canonical completed requests are counted. Provider, payment and fulfilment evidence remain independently owned.</p></article>
          </section>
          <section class="k-app-card k-request-workspace" aria-labelledby="request-workspace-title" data-workspace-owned-surface="requests">
            <div class="k-request-workspace-head"><div><span class="k-app-card-label">Economic Request lifecycle</span><h2 id="request-workspace-title">Your work in motion</h2><p>Review request state, explicit next actions and source-aware continuation without creating a parallel order or payment record.</p></div><a class="k-app-primary" href="/chat?prompt=Show%20me%20my%20requests">Continue in Chat</a></div>
            <div class="k-app-data-list" data-requests-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading canonical Economic Request state…</div></div>
            <div class="k-app-empty" data-requests-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>No Economic Requests yet</h3><p>Start in Chat when you are ready to source, compare, prepare, or continue a request. No provider availability, price, booking, payment, or fulfilment state is assumed here.</p><a class="k-app-card-action" href="/chat">Start in Chat →</a></div></div>
            <div class="k-app-empty" data-requests-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Request state is unavailable</h3><p>Kurukoo could not read the canonical Economic Request authority. No request status is inferred locally.</p><a class="k-app-card-action" href="/requests">Retry Requests →</a></div></div>
          </section>
        <% } else if (section === 'tasks') { %>
          <section class="k-app-grid three k-task-metrics" aria-label="Canonical task work summary" data-workspace-owned-surface="tasks">
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">Available work</span><strong data-task-metric="available">—</strong><p>Work shown here is currently available to this authenticated identity.</p></article>
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">In progress</span><strong data-task-metric="progress">—</strong><p>Accepted work remains linked to its source and accountable to the canonical task lifecycle.</p></article>
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">Completed</span><strong data-task-metric="completed">—</strong><p>Only work in the canonical completed state is counted here; review and payout are separate states.</p></article>
          </section>
          <section class="k-app-card k-task-workspace" aria-labelledby="task-workspace-title" data-workspace-owned-surface="tasks">
            <div class="k-task-workspace-head"><div><span class="k-app-card-label">Task work queue</span><h2 id="task-workspace-title">Work that needs attention</h2><p>Review available and active tasks with source-aware continuation. Acceptance and completion remain explicit, canonical actions.</p></div><a class="k-app-primary" href="/chat?prompt=Show%20me%20my%20tasks">Continue in Chat</a></div>
            <div class="k-app-data-list" data-tasks-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading your canonical task summary…</div></div>
            <div class="k-app-empty" data-tasks-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>No task work is waiting</h3><p>No available, in-progress or completed task records are currently visible to this authenticated identity.</p><a class="k-app-card-action" href="/chat">Continue in Chat →</a></div></div>
            <div class="k-app-empty" data-tasks-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Task state is unavailable</h3><p>The task authority could not be read. No task status is inferred locally; try again once the connection is restored.</p><a class="k-app-card-action" href="/tasks">Retry Tasks →</a></div></div>
          </section>
        <% } else if (section === 'memory' || section === 'notifications') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label"><%= section === 'memory' ? 'Memory Profile' : 'Notifications' %></span><h2><%= section === 'memory' ? 'One owner-scoped memory authority.' : 'Continuation without fragmentation.' %></h2><p><%= selected.description %></p><a href="/chat" class="k-app-card-action">Continue in Chat →</a></article><article class="k-app-card"><span class="k-app-card-label">Cross-client</span><h2>Same state across Web, PWA and native.</h2><p>Durable state comes from the canonical OS; clients keep only cache, device and rendering state locally.</p><a href="/desk" class="k-app-card-action">Open Desk →</a></article></section>
        <% } else if (section === 'topics') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Community context</span><h2>Useful local knowledge, clearly labelled.</h2><p>Topics are community-shared questions, reports and experiences. They provide context and discovery signals but do not confirm provider status, price, stock, availability, booking or payment.</p><a href="/topics" class="k-app-primary">Browse Topics</a></article><article class="k-app-card"><span class="k-app-card-label">Moderation boundary</span><h2>Share with a review boundary.</h2><p>Authenticated Topics and replies remain subject to moderation and reporting. Community content never silently creates a provider, offer, economic request or transaction.</p><a href="/topics#create-topic" class="k-app-card-action">Share a Topic →</a></article></section>
        <% } else if (section === 'reminders') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Reminder timeline</span><h2>Keep planned follow-through visible.</h2><p>Upcoming, overdue, completed and recurring reminders remain tied to their canonical conversation and notification state. Create or change a reminder through Chat.</p><a href="/chat?prompt=Show%20me%20my%20reminders" class="k-app-primary">Manage reminders in Chat</a></article><article class="k-app-card"><span class="k-app-card-label">Recovery</span><h2>Pause, resume or cancel without losing context.</h2><p>If a reminder is unavailable, delayed or no longer relevant, return to its originating conversation to review, reschedule or cancel it explicitly.</p><a href="/notifications" class="k-app-card-action">Open Notifications →</a></article></section>
        <% } else if (section === 'saved') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Saved context</span><h2>Keep useful items connected to their source.</h2><p>Saved offers, follows and watches remain owner-scoped context. Their current availability, price and provider state are never inferred from a saved entry.</p><a href="/chat?prompt=Show%20me%20my%20saved%20items" class="k-app-primary">Review saved items in Chat</a></article><article class="k-app-card"><span class="k-app-card-label">Next action</span><h2>Recheck before making an economic request.</h2><p>Open the original conversation or source to refresh availability and evidence before moving an item into a request or checkout flow.</p><a href="/requests" class="k-app-card-action">Open Requests →</a></article></section>
        <% } else if (section === 'cart') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Request preparation</span><h2>Review sourced context before commitment.</h2><p>Cart preparation is not payment or fulfilment. Current offer, quantity, price and provider evidence must be confirmed through the canonical Economic Request lifecycle.</p><a href="/requests" class="k-app-primary">Review requests</a></article><article class="k-app-card"><span class="k-app-card-label">Checkout boundary</span><h2>Confirmation stays evidence-gated.</h2><p>Proceed only after the request has a truthful quote and payment readiness. Pending, failed and cancelled outcomes remain distinct from successful completion.</p><a href="/checkout" class="k-app-card-action">Open Checkout →</a></article></section>
        <% } else if (section === 'agents') { %>
          <section class="k-app-card"><span class="k-app-card-label">Agent Runtime</span><h2>First-class agents, one runtime.</h2><p>Agent goals, actions, budgets, retries, pause/resume, evidence and recovery remain governed by the same canonical runtime. Use Chat to create or control an agent goal.</p><a href="/chat?prompt=Show%20me%20my%20agents" class="k-app-primary">Manage agents in Chat</a></section>
        <% } else if (section === 'capabilities') { %>
          <section class="k-app-card"><span class="k-app-card-label">Capability Portfolio</span><h2>Many roles. One identity.</h2><p>A user can be a barber, contributor, delivery worker, seller and buyer at the same time without creating separate accounts or memories.</p><a href="/chat?prompt=Show%20me%20my%20capabilities" class="k-app-primary">Open Capability Portfolio</a></section>
        <% } else if (section === 'opportunities') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Proactive Opportunity Engine</span><h2>Useful ideas without noise.</h2><p>Quiet-user engagement, daily picks and network opportunities are surfaced only when relevant and clearly labelled.</p><a href="/daily-picks" class="k-app-card-action">Open Daily Picks →</a></article><article class="k-app-card"><span class="k-app-card-label">Truth boundary</span><h2>No invented opportunity.</h2><p>Availability, provider status, price and fulfilment remain evidence-gated.</p><a href="/discover" class="k-app-card-action">Explore the network →</a></article></section>
        <% } else if (section === 'artifacts') { %>
          <section class="k-app-card"><span class="k-app-card-label">ArtifactService</span><h2>Your files, recordings and transcripts.</h2><p>Artifact metadata is owner-scoped; Google Drive is preferred for durable user-owned storage, with managed fallback only when appropriate.</p><a href="/connect" class="k-app-primary">Open Artifact History</a></section>
        <% } else if (section === 'prayer') { %>
          <section class="k-app-card"><span class="k-app-card-label">Prayer Companion</span><h2>A first-class Kurukoo agent.</h2><p>Prayer requests can become personalized written prayers, routines, reminders and voice experiences through the existing Agent Runtime and voice/artifact boundaries.</p><a href="/chat?prompt=I%20would%20like%20a%20prayer" class="k-app-primary">Start a prayer conversation</a></section>
        <% } else if (section === 'call') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">AI voice</span><h2>Talk to Kurukoo.</h2><p>Realtime AI voice uses the canonical conversation and tool boundary.</p><a href="/chat?voice=1" class="k-app-primary">Open AI voice</a></article><article class="k-app-card"><span class="k-app-card-label">Kurukoo Call</span><h2>Realtime peer communication.</h2><p>WebRTC calling uses the canonical identity and signalling layer; production relay/provider readiness remains externally gated.</p><a href="/call" class="k-app-card-action">Open Call →</a></article></section>
        <% } else if (section === 'safety') { %>
          <section class="k-app-card"><span class="k-app-card-label">Safety</span><h2>Explicit, consent-bound safety support.</h2><p>Manage check-ins, trusted contacts and safety continuity without implying emergency-service delivery.</p><a href="/safety" class="k-app-primary">Open Safety →</a></section>
        <% } else if (section === 'discover') { %>
          <section class="k-app-grid two k-discover-route-links"><article class="k-app-card"><span class="k-app-card-label">Nearby Pulse</span><h2>Local presence with consent and truth.</h2><p>Presence and availability are surfaced from the canonical Pulse/network boundary rather than guessed from stale UI state.</p><a href="/discover" class="k-app-card-action">Open Discover →</a></article><article class="k-app-card"><span class="k-app-card-label">Opportunities</span><h2>Find useful things.</h2><p>Explore products, providers, Topics and opportunities without leaving the same Kurukoo relationship.</p><a href="/daily-picks" class="k-app-card-action">Open Opportunities →</a></article></section>
        <% } else { %>
          <section class="k-app-card"><span class="k-app-card-label"><%= selected.eyebrow %></span><h2><%= selected.title %> remains connected to the same Kurukoo OS.</h2><p><%= selected.description %></p><a href="<%= selected.cta %>" class="k-app-primary"><%= selected.ctaLabel %></a></section>
        <% } %>
        <section class="k-app-status-row">
          <span class="k-status" data-state="success">OS connected</span>
          <span class="k-status" data-state="info"><%= surfaces.length %> Web surfaces</span>
          <span class="k-status">External integrations: <%= enabledIntegrations %>/<%= integrationCount %> implemented</span>
        </section>
      </div>
    </main>
  </div>
  <nav class="k-mobile-tabbar" aria-label="Kurukoo application navigation">
    <a href="/desk" aria-current="<%= section === 'desk' ? 'page' : 'false' %>"><span><%= icon('chat') %></span><span>Desk</span></a>
    <a href="/discover" aria-current="<%= section === 'discover' ? 'page' : 'false' %>"><span><%= icon('discover') %></span><span>Discover</span></a>
    <a href="/requests" aria-current="<%= section === 'requests' ? 'page' : 'false' %>"><span><%= icon('request') %></span><span>Requests</span></a>
    <a href="/tasks" aria-current="<%= section === 'tasks' ? 'page' : 'false' %>"><span><%= icon('work') %></span><span>Tasks</span></a>
    <a href="/connect" aria-current="<%= section === 'connect' ? 'page' : 'false' %>"><span><%= icon('settings') %></span><span>Connect</span></a>
  </nav>
  <script src="/js/kurukoo-workspace.js?v=routes1" defer></script>
  <script src="/js/kurukoo-app-shell.js?v=4" defer></script>
</body>
</html>
