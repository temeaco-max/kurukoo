<!-- Kurukoo visual system: warm cream/white OS canvas, Space Grotesk hierarchy, Inter UI rhythm, terracotta single-action emphasis, evidence-led states. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= selected.title %> · Kurukoo</title>
  <meta name="description" content="<%= selected.description %>">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-client-foundation.css?v=2">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=5">
  <link rel="stylesheet" href="/css/kurukoo-os-final.css?v=visual4">
  <link rel="stylesheet" href="/css/kurukoo-desktop-final.css?v=1">
  <link rel="stylesheet" href="/css/kurukoo-os-visual-advancement.css?v=1">
  <link rel="stylesheet" href="/css/kurukoo-app-ia.css?v=1">
  <% if (section === 'requests') { %>
  <link rel="stylesheet" href="/css/kurukoo-requests-convergence.css?v=1">
  <% } %>
  <% if (section === 'tasks') { %>
  <link rel="stylesheet" href="/css/kurukoo-tasks-convergence.css?v=1">
  <% } %>
  <% if (section === 'discover') { %>
  <link rel="stylesheet" href="/css/kurukoo-discover-convergence.css?v=1">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <script src="/js/kurukoo-discover-convergence.js?v=1" defer></script>
  <script src="/js/kurukoo-discover-map-loader.js?v=1" defer></script>
  <% } %>
  <% if (section === 'notifications') { %>
  <link rel="stylesheet" href="/css/kurukoo-notifications-convergence.css?v=1">
  <script src="/js/kurukoo-notifications-convergence.js?v=1" defer></script>
  <% } %>
  <% if (section === 'connect') { %>
  <link rel="stylesheet" href="/css/kurukoo-contacts-convergence.css?v=1">
  <script src="/js/kurukoo-contacts-convergence.js?v=1" defer></script>
  <% } %>
  <% if (section === 'memory') { %>
  <link rel="stylesheet" href="/css/kurukoo-memory-convergence.css?v=1">
  <script src="/js/kurukoo-memory-convergence.js?v=1" defer></script>
  <% } %>
  <script src="/js/fcm-client.js?v=routes2" defer></script>
</head>
<body class="k-app-page workspace-page k-app-section-<%= section %>" data-workspace-section="<%= section %>" data-app-section="<%= section %>" data-canonical-path="<%= canonicalPath %>">
  <div class="k-app-shell">
    <%- include('_partials/app-header', { selected, section, canonicalPath, displayName, phone }) %>
    <%- include('_partials/app-sidebar', { selected, section, canonicalPath, displayName, phone }) %>
    <main class="k-app-main">
      <div class="k-app-container">
        <%- include('_partials/app-page-header', { selected, section, canonicalPath, displayName, phone }) %>
        <%- include('_partials/app-context-bridge', { selected, section, canonicalPath, displayName, phone }) %>
        <% if (section === 'desk') { %>
          <section class="k-desk-live" data-desk-root data-workspace-owned-surface="desk" aria-label="Live Home summary">
            <div class="k-desk-loading" data-desk-loading aria-live="polite">Loading what matters now…</div>
          </section>
        <% } else if (section === 'connect') { %>
          <section class="k-app-card k-connect-workspace" aria-labelledby="connect-workspace-title" data-workspace-owned-surface="connect">
            <div class="k-connect-workspace-head"><div><span class="k-app-card-label">Connection readiness</span><h2 id="connect-workspace-title">Your connected resources</h2><p>See what is ready to use. Kurukoo only describes access, delivery, or completed actions after they are confirmed.</p></div><a class="k-app-primary" href="/channels">Channel readiness</a></div>
            <div class="k-connect-resource-grid" data-connect-resource-grid aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading connection readiness…</div></div>
            <div class="k-app-empty" data-connect-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Connection readiness is unavailable</h3><p>Kurukoo could not load your connection status. Nothing is shown as connected until it can be confirmed.</p><a class="k-app-card-action" href="/connect">Retry Connect →</a></div></div>
          </section>
          <section class="k-app-grid two k-connect-boundary-grid" data-workspace-owned-surface="connect"><article class="k-app-card"><span class="k-app-card-label">Channels</span><h2>WhatsApp · Telegram · Push</h2><p>Each channel shows its own pairing, permissions, and delivery readiness.</p><a href="/channels" class="k-app-card-action">View channel readiness →</a></article><article class="k-app-card"><span class="k-app-card-label">Connected sources</span><h2>Sheets · Notion · Microsoft</h2><p>Connect sources you choose. Kurukoo only reads data you authorize.</p><a href="/chat?prompt=Help%20me%20manage%20my%20connected%20sources" class="k-app-card-action">Continue in Chat →</a></article></section>
          <section class="k-connect-people" data-connect-people-root aria-live="polite" aria-busy="true"></section>
        <% } else if (section === 'wallet' || section === 'points' || section === 'top-up' || section === 'subscriptions') { %>
          <section class="k-app-grid three"><article class="k-app-card"><span class="k-app-card-label">Wallet</span><h2>Money controls</h2><p>Wallet state is separate from provider success and always reflects current economic status.</p><a href="/wallet" class="k-app-card-action">Wallet →</a></article><article class="k-app-card"><span class="k-app-card-label">Points</span><h2>Closed-loop utility</h2><p>Points remain independent from cash payment rails and can be governed without a payment provider.</p><a href="/points" class="k-app-card-action">Points →</a></article><article class="k-app-card"><span class="k-app-card-label">Billing</span><h2>Top Up & Subscriptions</h2><p>These surfaces remain ready even when the live payment provider is disabled or awaiting verification.</p><div><a href="/top-up" class="k-app-card-action">Top Up →</a> · <a href="/subscriptions" class="k-app-card-action">Subscriptions →</a></div></article></section>
        <% } else if (section === 'checkout' || section === 'confirmations') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Economic truth</span><h2>Explicit confirmation before irreversible action.</h2><p>Checkout and confirmations use the current request state and payment details. UI never turns intent into claimed success.</p><a href="/activity" class="k-app-card-action">View Activity →</a></article><article class="k-app-card"><span class="k-app-card-label">Recovery</span><h2>Continue, retry or recover.</h2><p>Failed, pending, cancelled and completed states remain visible and resumable without losing the originating conversation.</p><a href="/chat" class="k-app-card-action">Continue in Chat →</a></article></section>
        <% } else if (section === 'requests') { %>
          <section class="k-app-grid three k-request-metrics" aria-label="Activity summary" data-workspace-owned-surface="requests">
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Work in motion</span><strong data-request-metric="open">—</strong><p>Requests that are still being prepared, matched, reviewed, fulfilled, or recovered.</p></article>
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Needs your action</span><strong data-request-metric="action">—</strong><p>Only explicit confirmation or payment-pending states appear here; display alone never makes a request complete.</p></article>
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Completed</span><strong data-request-metric="completed">—</strong><p>Only confirmed completed requests are counted. Provider, payment, and fulfilment updates remain distinct.</p></article>
          </section>
          <section class="k-app-card k-request-workspace" aria-labelledby="request-workspace-title" data-workspace-owned-surface="requests">
            <div class="k-request-workspace-head"><div><span class="k-app-card-label">Activity</span><h2 id="request-workspace-title">Your work in motion</h2><p>Review what is happening, what needs you, and the next useful action without losing the conversation that started it.</p></div><a class="k-app-primary" href="/chat?prompt=Show%20me%20my%20requests">Continue in Chat</a></div>
            <div class="k-app-data-list" data-requests-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading your activity…</div></div>
            <div class="k-app-empty" data-requests-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>No activity yet</h3><p>Start in Chat when you are ready to compare options, prepare a request, or continue existing work. Availability, price, booking, payment, and fulfilment are only shown when confirmed.</p><a class="k-app-card-action" href="/chat">Start in Chat →</a></div></div>
            <div class="k-app-empty" data-requests-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Activity is unavailable</h3><p>Kurukoo could not read your activity details right now. No activity status is shown until it can be confirmed.</p><a class="k-app-card-action" href="/activity">Retry Activity →</a></div></div>
          </section>
        <% } else if (section === 'tasks') { %>
          <section class="k-app-grid three k-task-metrics" aria-label="Work summary" data-workspace-owned-surface="tasks">
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">Available work</span><strong data-task-metric="available">—</strong><p>Work shown here is currently available to this authenticated identity.</p></article>
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">In progress</span><strong data-task-metric="progress">—</strong><p>Accepted work remains linked to the request, objective, or conversation that started it.</p></article>
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">Completed</span><strong data-task-metric="completed">—</strong><p>Only confirmed completed work is counted here; review and payout remain separate states.</p></article>
          </section>
          <section class="k-app-card k-task-workspace" aria-labelledby="task-workspace-title" data-workspace-owned-surface="tasks">
            <div class="k-task-workspace-head"><div><span class="k-app-card-label">Work</span><h2 id="task-workspace-title">Work that needs attention</h2><p>Review available and active tasks with a clear link back to what they support. Accepting and completing work always stays explicit.</p></div><a class="k-app-primary" href="/chat?prompt=Show%20me%20my%20tasks">Continue in Chat</a></div>
            <div class="k-app-data-list" data-tasks-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading your work…</div></div>
            <div class="k-app-empty" data-tasks-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>No task work is waiting</h3><p>No available, in-progress or completed task records are currently visible to this authenticated identity.</p><a class="k-app-card-action" href="/chat">Continue in Chat →</a></div></div>
            <div class="k-app-empty" data-tasks-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Work is unavailable</h3><p>Kurukoo could not read your work details right now. No task status is shown until it can be confirmed; try again once the connection is restored.</p><a class="k-app-card-action" href="/tasks">Retry Work →</a></div></div>
          </section>
        <% } else if (section === 'memory') { %>
          <section class="k-memory-live" data-memory-root data-workspace-owned-surface="memory" aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading your memory…</div></section>
        <% } else if (section === 'notifications') { %>
          <section class="k-notifications-live" data-notifications-root data-workspace-owned-surface="notifications" aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading your notifications…</div></section>
        <% } else if (section === 'topics') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Community context</span><h2>Useful local knowledge, clearly labelled.</h2><p>Topics are community-shared questions, reports and experiences. They provide context and discovery signals but do not confirm provider status, price, stock, availability, booking or payment.</p><a href="/topics" class="k-app-primary">Browse Topics</a></article><article class="k-app-card"><span class="k-app-card-label">Moderation</span><h2>Share with a review boundary.</h2><p>Authenticated Topics and replies remain subject to moderation and reporting. Community content never silently becomes a transaction or provider status.</p><a href="/topics#create-topic" class="k-app-card-action">Share a Topic →</a></article></section>
        <% } else if (section === 'reminders') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Reminder timeline</span><h2>Keep planned follow-through visible.</h2><p>Upcoming, overdue, completed and recurring reminders remain tied to the conversation and notification state that support them. Create or change a reminder through Chat.</p><a href="/chat?prompt=Show%20me%20my%20reminders" class="k-app-primary">Manage reminders in Chat</a></article><article class="k-app-card"><span class="k-app-card-label">Recovery</span><h2>Pause, resume or cancel without losing context.</h2><p>If a reminder is unavailable, delayed or no longer relevant, return to its originating conversation to review, reschedule or cancel it explicitly.</p><a href="/notifications" class="k-app-card-action">Open Notifications →</a></article></section>
        <% } else if (section === 'saved') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Saved context</span><h2>Keep useful items connected to their source.</h2><p>Saved offers, follows and watches remain owner-scoped context. Their current availability, price and provider state are never inferred from a saved entry.</p><a href="/chat?prompt=Show%20me%20my%20saved%20items" class="k-app-primary">Review saved items in Chat</a></article><article class="k-app-card"><span class="k-app-card-label">Next action</span><h2>Recheck before making an economic request.</h2><p>Open the original conversation or source to refresh availability before moving an item into a request or checkout flow.</p><a href="/activity" class="k-app-card-action">Open Activity →</a></article></section>
        <% } else if (section === 'cart') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Request preparation</span><h2>Review sourced context before commitment.</h2><p>Cart preparation is not payment or fulfilment. Current offer, quantity, price and provider information must be confirmed before a request is committed.</p><a href="/activity" class="k-app-primary">Review Activity</a></article><article class="k-app-card"><span class="k-app-card-label">Checkout boundary</span><h2>Confirmation stays clear.</h2><p>Proceed only after the request has a truthful quote and payment readiness. Pending, failed and cancelled outcomes remain distinct from successful completion.</p><a href="/checkout" class="k-app-card-action">Open Checkout →</a></article></section>
        <% } else if (section === 'agents') { %>
          <section class="k-app-card" aria-labelledby="agents-title" data-workspace-owned-surface="agents"><span class="k-app-card-label">Objectives</span><h2 id="agents-title">What Kurukoo is working on</h2><p>Review active objectives, their progress, what needs your input, and what has been completed. Each objective stays connected to the conversation that started it.</p><div class="k-app-data-list" data-agents-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading objectives…</div></div><div class="k-app-empty" data-agents-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>No active objectives</h3><p>When Kurukoo is tracking an objective, it appears here. Use Chat to start or control it.</p><a class="k-app-card-action" href="/chat?prompt=Show%20me%20my%20agents">Go to Chat →</a></div></div></section>
          <script src="/js/kurukoo-agents-convergence.js?v=1" defer></script>
        <% } else if (section === 'capabilities') { %>
          <section class="k-app-card"><span class="k-app-card-label">Capabilities</span><h2>Many roles. One identity.</h2><p>A user can be a barber, contributor, delivery worker, seller and buyer at the same time without creating separate accounts or memories.</p><a href="/chat?prompt=Show%20me%20my%20capabilities" class="k-app-primary">Open Capabilities</a></section>
        <% } else if (section === 'opportunities') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Opportunities</span><h2>Useful ideas without noise.</h2><p>Quiet-user engagement, daily picks and network opportunities are surfaced only when relevant and clearly labelled.</p><a href="/explore" class="k-app-card-action">Open Explore →</a></article><article class="k-app-card"><span class="k-app-card-label">Truth</span><h2>No invented opportunity.</h2><p>Availability, provider status, price and fulfilment are shown only when supported by current information.</p><a href="/explore" class="k-app-card-action">Explore the network →</a></article></section>
        <% } else if (section === 'artifacts') { %>
          <section class="k-app-card"><span class="k-app-card-label">Files</span><h2>Your files, recordings and transcripts.</h2><p>Your files remain tied to your account and supported storage connections.</p><a href="/connect" class="k-app-primary">Open File History</a></section>
        <% } else if (section === 'prayer') { %>
          <section class="k-app-card"><span class="k-app-card-label">Prayer Companion</span><h2>A personal way to pray.</h2><p>Prayer requests can become personalized written prayers, routines, reminders and supported voice experiences through Kurukoo.</p><a href="/chat?prompt=I%20would%20like%20a%20prayer" class="k-app-primary">Ask Kurukoo</a></section>
        <% } else if (section === 'call') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">AI voice</span><h2>Talk to Kurukoo.</h2><p>Realtime AI voice uses the same conversation and action boundaries as Chat.</p><a href="/chat?voice=1" class="k-app-primary">Open AI voice</a></article><article class="k-app-card"><span class="k-app-card-label">Kurukoo Call</span><h2>Realtime peer communication.</h2><p>Peer calling uses the same identity and signalling layer; production relay/provider readiness remains externally gated.</p><a href="/call" class="k-app-card-action">Open Call →</a></article></section>
        <% } else if (section === 'safety') { %>
          <section class="k-app-card"><span class="k-app-card-label">Safety</span><h2>Explicit, consent-bound safety support.</h2><p>Manage check-ins, trusted contacts and safety continuity without implying emergency-service delivery.</p><a href="/safety" class="k-app-primary">Open Safety →</a></section>
        <% } else if (section === 'discover') { %>
          <section class="k-app-grid two k-discover-route-links"><article class="k-app-card"><span class="k-app-card-label">Nearby</span><h2>Local presence with consent and truth.</h2><p>Presence and availability are surfaced from current network information rather than guessed from stale UI state.</p><a href="/explore" class="k-app-card-action">Open Explore →</a></article><article class="k-app-card"><span class="k-app-card-label">Opportunities</span><h2>Find useful things.</h2><p>Explore products, providers, Topics and opportunities without leaving the same Kurukoo relationship.</p><a href="/explore" class="k-app-card-action">Explore opportunities →</a></article></section>
        <% } else { %>
          <section class="k-app-card"><span class="k-app-card-label"><%= selected.eyebrow %></span><h2><%= selected.title %> remains connected to Kurukoo.</h2><p><%= selected.description %></p><a href="<%= selected.cta %>" class="k-app-primary"><%= selected.ctaLabel %></a></section>
        <% } %>
        <section class="k-app-status-row" aria-label="Workspace guidance">
          <span class="k-status" data-state="ready">Kurukoo is ready</span>
          <span class="k-status">Continue from Chat whenever you need the next step.</span>
        </section>
        <%- include('_partials/app-footer', { selected, section, canonicalPath, displayName, phone }) %>
      </div>
    </main>
  </div>
  <%- include('_partials/app-mobile-nav', { selected, section, canonicalPath, displayName, phone }) %>
  <script src="/js/kurukoo-workspace.js?v=routes1" defer></script>
  <% if (section === 'desk') { %>
  <script src="/js/kurukoo-desk-data.js?v=1" defer></script>
  <% } %>
  <% if (section === 'requests') { %>
  <script src="/js/kurukoo-requests-convergence.js?v=1" defer></script>
  <% } %>
  <% if (section === 'tasks') { %>
  <script src="/js/kurukoo-tasks-convergence.js?v=1" defer></script>
  <% } %>
  <script src="/js/kurukoo-app-shell.js?v=4" defer></script>
</body>
</html>
