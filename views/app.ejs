<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= selected.title %> · Kurukoo</title>
  <meta name="description" content="<%= selected.description %>">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-client-foundation.css?v=2">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=5">
</head>
<body class="k-app-page workspace-page" data-kurukoo-app data-app-section="<%= section %>">
  <% const icon = (name) => `<svg class="k-app-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; %>
  <div class="k-app-shell">
    <header class="k-app-header">
      <a href="/" class="k-app-brand"><img src="/assets/brand/logo-icon.png" alt="Kurukoo" width="34" height="34"><span>Kurukoo</span></a>
      <div class="k-app-header-actions"><span class="k-app-identity"><strong><%= displayName %></strong><small><%= phone %></small></span><button class="k-app-menu" type="button" data-action="toggle-sidebar" aria-label="Open navigation">Menu</button><a class="k-app-ask" href="/chat">Ask</a></div>
    </header>
    <aside class="k-app-sidebar" id="app-sidebar" aria-label="Kurukoo application navigation">
      <a class="k-app-new" href="/chat">＋ New conversation</a>
      <nav class="k-app-nav" aria-label="Primary">
        <a class="<%= section === 'agent' ? 'active' : '' %>" href="/app/agent"><%= icon('chat') %><span>Agent</span></a><a class="<%= section === 'discover' ? 'active' : '' %>" href="/app/discover"><%= icon('discover') %><span>Discover</span></a><a class="<%= section === 'requests' ? 'active' : '' %>" href="/app/requests"><%= icon('request') %><span>Requests</span></a><a class="<%= section === 'tasks' ? 'active' : '' %>" href="/app/tasks"><%= icon('work') %><span>Tasks</span></a><a class="<%= section === 'connect' ? 'active' : '' %>" href="/app/connect"><%= icon('settings') %><span>Connect</span></a>
      </nav>
      <div class="k-app-divider"></div>
      <nav class="k-app-nav" aria-label="Workspace">
        <a href="/app/agents"><%= icon('chat') %><span>Agents</span></a><a href="/app/capabilities"><%= icon('work') %><span>Capabilities</span></a><a href="/app/opportunities"><%= icon('discover') %><span>Opportunities</span></a><a class="<%= section === 'topics' ? 'active' : '' %>" href="/app/topics"><%= icon('discover') %><span>Topics</span></a><a href="/app/wallet"><%= icon('points') %><span>Wallet</span></a><a href="/app/points"><%= icon('points') %><span>Points</span></a><a href="/app/top-up"><%= icon('points') %><span>Top Up</span></a><a href="/app/subscriptions"><%= icon('saved') %><span>Subscriptions</span></a><a href="/app/checkout"><%= icon('request') %><span>Checkout</span></a><a href="/app/confirmations"><%= icon('success') %><span>Confirmations</span></a><a href="/app/artifacts"><%= icon('saved') %><span>Artifacts</span></a><a href="/app/prayer"><%= icon('chat') %><span>Prayer</span></a><a href="/app/call"><%= icon('mic') %><span>Call</span></a><a href="/app/safety"><%= icon('safety') %><span>Safety</span></a>
      </nav>
      <div class="k-app-divider"></div>
      <nav class="k-app-nav" aria-label="Account"><a href="/app/memory"><%= icon('saved') %><span>Memory</span></a><a href="/app/notifications"><%= icon('notification') %><span>Notifications</span></a><a href="/settings"><%= icon('settings') %><span>Settings</span></a><a href="/help"><%= icon('help') %><span>Help</span></a></nav>
    </aside>
    <main class="k-app-main"><div class="k-app-container">
      <div class="k-app-eyebrow"><%= selected.eyebrow %></div>
      <div class="k-app-title-row"><div><h1><%= selected.title %></h1><p><%= selected.description %></p></div><a class="k-app-primary" href="<%= selected.cta %>"><%= selected.ctaLabel %></a></div>
      <% if (section === 'agent') { %>
        <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Conversation</span><h2>One place to ask, coordinate and continue.</h2><p>Chat remains the source of truth for requests, reminders, safety, memory, agents and actions.</p><a href="/chat" class="k-app-card-action">Open Web Chat →</a></article><article class="k-app-card"><span class="k-app-card-label">Continuity</span><h2>Keep active work alive.</h2><p>Interruption, authentication, pause/resume and cross-channel continuation remain owned by the canonical context layer.</p><a href="/app/requests" class="k-app-card-action">View Requests →</a></article></section>
      <% } else if (section === 'requests') { %>
        <section class="k-app-grid three"><article class="k-app-stat"><span>Open</span><strong data-request-count="open">—</strong></article><article class="k-app-stat"><span>Needs you</span><strong data-request-count="action">—</strong></article><article class="k-app-stat"><span>Completed</span><strong data-request-count="completed">—</strong></article></section><section class="k-app-card"><div class="k-action-row"><h2>Your requests</h2><button class="k-app-card-action" type="button" data-action="refresh" data-refresh-target="/app/requests">Refresh</button></div><div data-request-list aria-live="polite"><p class="k-muted">Loading canonical request state…</p></div></section>
      <% } else if (section === 'tasks') { %>
        <section class="k-app-card"><div class="k-action-row"><h2>Available tasks</h2><button class="k-app-card-action" type="button" data-action="refresh" data-refresh-target="/app/tasks">Refresh</button></div><p>Tasks are offered by the canonical task authority. Accepting a task creates an owned task state; completion requires the task result.</p><div data-task-list aria-live="polite"><p class="k-muted">Loading available tasks…</p></div></section>
      <% } else if (section === 'connect') { %>
        <section class="k-app-grid three"><article class="k-app-card"><span class="k-app-card-label">Storage</span><h2>Google Drive</h2><p>User-owned Drive is the preferred durable home for artifacts. OAuth and feature flags determine live availability.</p><a href="/connect" class="k-app-card-action">Open Connect →</a></article><article class="k-app-card"><span class="k-app-card-label">Channels</span><h2>WhatsApp · Telegram · Push</h2><p>Pairing and notifications use the same Kurukoo identity and conversation.</p><a href="/channels" class="k-app-card-action">View readiness →</a></article><article class="k-app-card"><span class="k-app-card-label">Sources</span><h2>Sheets · Notion · Microsoft</h2><p>Bounded owner-authorized source reads are available without creating background mirrors.</p><a href="/connect" class="k-app-card-action">Manage sources →</a></article></section>
      <% } else if (section === 'wallet' || section === 'points' || section === 'top-up' || section === 'subscriptions' || section === 'checkout' || section === 'confirmations') { %>
        <section class="k-app-grid three"><article class="k-app-card"><span class="k-app-card-label">Economic truth</span><h2>Explicit state, no implied success.</h2><p>Balances, quotes, payment and confirmation state are shown only from canonical economic evidence.</p><a href="/app/requests" class="k-app-card-action">View Requests →</a></article><article class="k-app-card"><span class="k-app-card-label">Review</span><h2>Confirm before irreversible action.</h2><p>Pending, failed, cancelled and completed states remain distinct.</p><a href="/chat" class="k-app-card-action">Continue in Chat →</a></article><article class="k-app-card"><span class="k-app-card-label">Points</span><h2>Closed-loop utility.</h2><p>Points remain independent from cash payment rails.</p><a href="/app/points" class="k-app-card-action">Open Points →</a></article></section>
      <% } else if (section === 'notifications') { %>
        <section class="k-app-card"><h2>Notifications</h2><p>Notifications are loaded from the canonical notification authority.</p><div data-notification-list aria-live="polite"><p class="k-muted">Loading notification state…</p></div></section>
      <% } else if (section === 'memory') { %>
        <section class="k-app-card"><h2>Memory</h2><p>Memory remains user-controlled and owner-scoped. This surface does not invent local client memory.</p><a href="/memory" class="k-app-primary">Manage Memory →</a></section>
      <% } else if (section === 'discover') { %>
        <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Nearby Pulse</span><h2>Local presence with consent and truth.</h2><p>Presence and availability come from the canonical discovery/network boundary.</p><a href="/discover" class="k-app-card-action">Open Discover →</a></article><article class="k-app-card"><span class="k-app-card-label">Opportunities</span><h2>Find useful things.</h2><p>Explore products, providers, Topics and opportunities without leaving the Kurukoo relationship.</p><a href="/daily-picks" class="k-app-card-action">Open Opportunities →</a></article></section>
      <% } else if (section === 'safety') { %>
        <section class="k-app-card"><span class="k-app-card-label">Safety</span><h2>Explicit, consent-bound safety support.</h2><p>Manage check-ins, trusted contacts and safety continuity without implying emergency-service delivery.</p><a href="/safety" class="k-app-primary">Open Safety →</a></section>
      <% } else if (section === 'artifacts') { %>
        <section class="k-app-card"><span class="k-app-card-label">ArtifactService</span><h2>Your files, recordings and transcripts.</h2><p>Artifact metadata remains owner-scoped and storage-provider state is explicit.</p><a href="/connect" class="k-app-primary">Open Artifact History</a></section>
      <% } else if (section === 'agents' || section === 'capabilities') { %>
        <section class="k-app-card"><span class="k-app-card-label"><%= section === 'agents' ? 'Agent Runtime' : 'Capability Portfolio' %></span><h2><%= section === 'agents' ? 'First-class agents, one runtime.' : 'Many roles. One identity.' %></h2><p><%= selected.description %></p><a href="/chat?prompt=<%= encodeURIComponent(section === 'agents' ? 'Show me my agents' : 'Show me my capabilities') %>" class="k-app-primary">Continue in Chat →</a></section>
      <% } else if (section === 'topics' || section === 'opportunities' || section === 'prayer' || section === 'call') { %>
        <section class="k-app-card"><span class="k-app-card-label"><%= selected.eyebrow %></span><h2><%= selected.title %></h2><p><%= selected.description %></p><a href="<%= selected.cta %>" class="k-app-primary"><%= selected.ctaLabel %></a></section>
      <% } else { %>
        <section class="k-app-card"><span class="k-app-card-label"><%= selected.eyebrow %></span><h2><%= selected.title %> remains connected to the same Kurukoo OS.</h2><p><%= selected.description %></p><a href="<%= selected.cta %>" class="k-app-primary"><%= selected.ctaLabel %></a></section>
      <% } %>
      <section class="k-app-status-row"><span class="k-status k-status--ready">OS connected</span><span class="k-status"><%= surfaces.length %> Web surfaces</span><span class="k-status">External integrations: <%= enabledIntegrations %>/<%= integrationCount %></span></section>
    </div></main>
  </div>
  <nav class="k-mobile-tabbar" aria-label="Kurukoo application navigation"><a href="/app/agent" aria-current="<%= section === 'agent' ? 'page' : 'false' %>"><%= icon('chat') %><span>Agent</span></a><a href="/app/discover" aria-current="<%= section === 'discover' ? 'page' : 'false' %>"><%= icon('discover') %><span>Discover</span></a><a href="/app/requests" aria-current="<%= section === 'requests' ? 'page' : 'false' %>"><%= icon('request') %><span>Requests</span></a><a href="/app/tasks" aria-current="<%= section === 'tasks' ? 'page' : 'false' %>"><%= icon('work') %><span>Tasks</span></a><a href="/app/connect" aria-current="<%= section === 'connect' ? 'page' : 'false' %>"><%= icon('settings') %><span>Connect</span></a></nav>
  <script src="/js/kurukoo-app.js?v=3" defer></script>
</body>
</html>