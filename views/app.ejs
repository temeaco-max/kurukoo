<!-- Kurukoo visual system: warm cream/white OS canvas, Space Grotesk hierarchy, Inter UI rhythm, terracotta single-action emphasis, evidence-led states. -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title><%= selected.title %> · Kurukoo</title>
  <meta name="description" content="<%= selected.description %>">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-client-foundation.css?v=2">
  <link rel="stylesheet" href="/css/kurukoo-product-os-convergence.css?v=1">
  <% if (section === 'chat') { %>
  <link rel="stylesheet" href="/css/kurukoo-chat.css?v=18">
  <% } %>
  <% if (section === 'requests') { %>
  <link rel="stylesheet" href="/css/kurukoo-requests-convergence.css?v=1">
  <% } %>
  <% if (section === 'tasks') { %>
  <link rel="stylesheet" href="/css/kurukoo-tasks-convergence.css?v=1">
  <% } %>
  <link rel="stylesheet" href="/css/kurukoo-product-os-revamp.css?v=2">
  <script src="/js/fcm-client.js?v=routes2" defer></script>
</head>
<body class="k-app-page workspace-page k-app-section-<%= section %><%= section === 'chat' ? ' kurukoo-chat-page' : '' %>" data-workspace-section="<%= section %>" data-app-section="<%= section %>" data-display-name="<%= displayName %>">
  <% const icon = (name) => `<svg class="k-app-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; const accountInitial = (String(displayName || '').match(/[a-z]/i) || ['K'])[0].toUpperCase(); %>
  <div class="k-app-shell k-reference-shell <%= section === 'chat' ? 'chat-template-shell' : '' %>">
    <header class="k-app-header k-reference-app-header" aria-label="Kurukoo workspace controls">
      <div class="k-reference-header-start">
        <button class="k-app-icon-button k-app-mobile-menu header-drawer" id="open-sidebar" type="button" aria-label="Open workspace navigation" aria-expanded="false"><%- icon('menu') %></button>
        <a href="/desk" class="k-app-brand k-reference-brand" aria-label="Open your Kurukoo Desk"><img src="/assets/brand/logo-icon.png" alt="" width="28" height="28"><span>Kurukoo</span></a>
        <a class="k-reference-agent-switcher" href="/chat" aria-label="Open Agent workspace" title="Open Agent"><span class="k-reference-agent-mark"><img src="/assets/brand/logo-icon.png" alt="" width="18" height="18"></span><span><strong>Agent</strong><small>Coordinate what matters</small></span><%- icon('more') %></a>
      </div>
      <div class="k-app-header-actions k-reference-header-actions">
        <form class="k-reference-header-search" id="k-reference-header-search" action="/discover" method="get" role="search"><%- icon('search') %><label class="sr-only" for="k-reference-header-search-input">Search Kurukoo</label><input id="k-reference-header-search-input" name="q" type="search" placeholder="Search Kurukoo" autocomplete="off"><button type="submit" aria-label="Search Kurukoo" title="Search Kurukoo"><%- icon('arrow-right') %></button></form>
        <a class="k-reference-header-control" id="header-nearby-radar" href="/discover?view=nearby#nearby-radar" aria-label="Open Nearby Radar" title="Nearby Radar"><span class="k-reference-control-icon"><%- icon('radar') %><span class="k-reference-radar-pulse" aria-hidden="true"></span></span><span class="k-reference-control-label">Nearby</span></a>
        <% if (section === 'chat') { %>
        <button class="k-reference-header-control k-reference-new-conversation" id="new-chat" type="button" aria-label="Start a new conversation" title="New conversation"><%- icon('chat') %><span class="k-reference-control-label">New</span></button>
        <a class="k-reference-header-control" id="header-notifications" href="/notifications" aria-label="Open notifications" title="Updates"><%- icon('notification') %><span class="notification-badge" id="notification-badge" hidden>0</span><span class="k-reference-control-label">Updates</span></a>
        <% } else { %>
        <a class="k-reference-header-control" id="header-messages" href="/chat" aria-label="Open Agent conversations" title="Messages"><%- icon('chat') %><span class="k-reference-control-label">Messages</span></a>
        <a class="k-reference-header-control" id="header-notifications" href="/notifications" aria-label="Open notifications" title="Updates"><%- icon('notification') %><span class="k-reference-control-label">Updates</span></a>
        <% } %>
        <a class="k-reference-header-control" id="header-points" href="/points" aria-label="Open points balance" title="Points"><%- icon('points') %><span class="k-reference-control-label">Points</span></a>
        <a class="k-reference-header-control" id="header-cart" href="/cart" aria-label="Open cart" title="Cart"><%- icon('cart') %><span class="k-reference-control-label">Cart</span></a>
        <details class="k-reference-account-menu" id="header-account"><summary class="k-reference-account-button" aria-label="Open account and configuration" title="Account and settings"><span><%= accountInitial %></span></summary><div class="k-reference-account-menu-panel"><div class="k-reference-account-menu-heading"><strong><%= displayName || 'Your account' %></strong><span>Account and configuration</span></div><a href="/settings">Settings</a><a href="/subscriptions">Plan and subscription</a><a href="/wallet">Wallet and billing</a><a href="/notifications">Notifications</a><a href="/channels">Connections</a><a href="/memory">Memory and privacy</a><a href="/safety">Safety and check-ins</a><a href="/help">Help and support</a><a href="/explore">Explore capabilities</a><button type="button" id="workspace-logout">Log out</button></div></details>
      </div>
    </header>
    <aside class="k-app-sidebar k-reference-sidebar" id="chat-sidebar" aria-label="Kurukoo application navigation">
      <div class="k-app-sidebar-top"><div class="k-app-sidebar-label">Workspace</div><button class="k-app-icon-button k-app-sidebar-close" id="close-sidebar" type="button" aria-label="Close workspace navigation"><%- icon('close') %></button></div>
      <nav class="k-app-nav k-reference-primary-nav" aria-label="Primary workspace">
        <a class="<%= section === 'desk' ? 'active' : '' %>" href="/desk"><%- icon('work') %><span>Desk</span></a>
        <a class="<%= section === 'chat' ? 'active' : '' %>" href="/chat"><%- icon('chat') %><span>Agent</span></a>
        <a class="<%= section === 'requests' ? 'active' : '' %>" href="/requests"><%- icon('request') %><span>Requests</span></a>
        <a class="<%= section === 'tasks' ? 'active' : '' %>" href="/tasks"><%- icon('work') %><span>Tasks</span></a>
        <a class="<%= section === 'discover' ? 'active' : '' %>" href="/discover"><%- icon('discover') %><span>Discover</span></a>
      </nav>
      <div class="k-app-divider"></div>
      <nav class="k-app-nav k-reference-secondary-nav" aria-label="Supporting workspace">
        <a class="<%= section === 'reminders' ? 'active' : '' %>" href="/reminders"><%- icon('reminder') %><span>Reminders</span></a>
      </nav>
      <% if (section === 'chat') { %>
      <section class="k-app-sidebar-conversation k-reference-conversation-nav" aria-label="Agent conversation utilities">
        <div class="k-app-sidebar-section-head"><span>History</span><button class="k-app-sidebar-text" type="button" id="sidebar-more-toggle" aria-controls="sidebar-more-items" aria-expanded="false">View all</button></div>
        <div class="k-app-history-list" id="history-list"></div>
        <div class="k-app-sidebar-radar"><a href="/discover?view=nearby#nearby-radar" id="radar-toggle" class="radar-toggle is-active" aria-label="Open Nearby Radar"><span class="k-app-radar-mark"></span><span><strong>Nearby Radar</strong><small id="radar-status">Explore nearby</small></span><%- icon('arrow-right') %></a></div>
        <button class="k-app-sponsored" id="sidebar-promo" type="button" aria-label="Open sponsored local service" hidden><img src="" alt="" loading="lazy"><span class="sidebar-sponsored-tag">Sponsored</span></button>
        <a class="k-app-sidebar-advertise" href="/advertise"><%- icon('discover') %><span>Promote on Kurukoo</span></a>
        <div class="k-app-sidebar-more" id="sidebar-more-items" hidden><a href="/saved">Saved items</a><a href="/notifications">Updates</a><a href="/advertise">Advertising</a></div>
      </section>
      <% } %>

    </aside>
    <main class="k-app-main">
      <% if (section === 'chat') { %>
        <%- include('partials/chat-workspace') %>
      <% } else { %>
      <div class="k-app-container">
        <% if (!['settings', 'call'].includes(section)) { %>
        <div class="k-app-eyebrow"><%= selected.eyebrow %></div>
        <div class="k-app-title-row">
          <div><h1><%= selected.title %></h1><p><%= selected.description %></p></div>
          <a class="k-app-primary" href="<%= selected.cta %>"><%= selected.ctaLabel %></a>
        </div>
        <section class="ko-context" aria-label="Kurukoo continuity context">
          <span class="ko-context-mark" aria-hidden="true">K</span>
          <div><div class="ko-context-title">Keep this work connected</div><div class="ko-context-meta">Open any item to see what changed, what is next, and the conversation that started it.</div></div>
          <a class="ko-context-action" href="/chat">Ask Kurukoo</a>
        </section>
        <% } %>
        <% if (section === 'desk') { %>
          <section class="k-desk-live" data-desk-root data-workspace-owned-surface="desk" aria-label="Live Desk summary">
            <div class="k-desk-loading" data-desk-loading aria-live="polite">Loading your Desk…</div>
          </section>
        <% } else if (section === 'connect') { %>
          <section class="k-app-card k-connect-workspace" aria-labelledby="connect-workspace-title" data-workspace-owned-surface="connect">
            <div class="k-connect-workspace-head"><div><span class="k-app-card-label">Connection readiness</span><h2 id="connect-workspace-title">Your connected resources</h2><p>See what is ready to use. Kurukoo only describes access, delivery, or completed actions after they are confirmed.</p></div><a class="k-app-primary" href="/channels">Channel readiness</a></div>
            <div class="k-connect-resource-grid" data-connect-resource-grid aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading connection readiness…</div></div>
            <div class="k-app-empty" data-connect-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Connection readiness is unavailable</h3><p>Kurukoo could not load your connection status. Nothing is shown as connected until it can be confirmed.</p><a class="k-app-card-action" href="/connect">Retry Connect →</a></div></div>
          </section>
          <section class="k-app-grid two k-connect-boundary-grid" data-workspace-owned-surface="connect"><article class="k-app-card"><span class="k-app-card-label">Channels</span><h2>WhatsApp · Telegram · Push</h2><p>Each channel shows its own pairing, permissions, and delivery readiness.</p><a href="/channels" class="k-app-card-action">View channel readiness →</a></article><article class="k-app-card"><span class="k-app-card-label">Connected sources</span><h2>Sheets · Notion · Microsoft</h2><p>Connect sources you choose. Kurukoo only reads data you authorize.</p><a href="/chat?prompt=Help%20me%20manage%20my%20connected%20sources" class="k-app-card-action">Continue in Chat →</a></article></section>
          <section class="k-connect-people" data-connect-people-root aria-live="polite" aria-busy="true"></section>

        <% } else if (section === 'wallet' || section === 'points' || section === 'top-up' || section === 'subscriptions') { %>
          <% const moneyLinks = section === 'wallet' ? { first: ['/points', 'Review points'], second: ['/top-up', 'Review top-ups'], third: ['/subscriptions', 'Manage subscription'] } : section === 'points' ? { first: ['/wallet', 'Open wallet'], second: ['/top-up', 'Review top-ups'], third: ['/subscriptions', 'Manage subscription'] } : section === 'top-up' ? { first: ['/wallet', 'Open wallet'], second: ['/points', 'Review points'], third: ['/subscriptions', 'Manage subscription'] } : { first: ['/wallet', 'Open wallet'], second: ['/points', 'Review points'], third: ['/top-up', 'Review top-ups'] }; %>
          <section class="k-app-grid three"><article class="k-app-card"><span class="k-app-card-label">Wallet</span><h2>Money controls</h2><p>Wallet state is separate from provider success and always reflects canonical economic evidence.</p><a href="<%= moneyLinks.first[0] %>" class="k-app-card-action"><%= moneyLinks.first[1] %> →</a></article><article class="k-app-card"><span class="k-app-card-label">Points</span><h2>Closed-loop utility</h2><p>Points remain independent from cash payment rails and can be governed without a payment provider.</p><a href="<%= moneyLinks.second[0] %>" class="k-app-card-action"><%= moneyLinks.second[1] %> →</a></article><article class="k-app-card"><span class="k-app-card-label">Billing</span><h2>Plan and billing</h2><p>Review plan and payment readiness; completion is only shown when a configured provider returns evidence.</p><a href="<%= moneyLinks.third[0] %>" class="k-app-card-action"><%= moneyLinks.third[1] %> →</a></article></section>
        <% } else if (section === 'checkout' || section === 'confirmations') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Economic truth</span><h2>Explicit confirmation before irreversible action.</h2><p>Checkout and confirmations use canonical request state, payment policy and evidence. UI never turns intent into claimed success.</p><a href="/requests" class="k-app-card-action">View Requests →</a></article><article class="k-app-card"><span class="k-app-card-label">Recovery</span><h2>Continue, retry or recover.</h2><p>Failed, pending, cancelled and completed states remain visible and resumable without losing the originating conversation.</p><a href="/chat" class="k-app-card-action">Continue in Chat →</a></article></section>
        <% } else if (section === 'requests') { %>
          <section class="k-app-grid three k-request-metrics" aria-label="Request summary" data-workspace-owned-surface="requests">
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Moving forward</span><strong data-request-metric="open">—</strong><p>Requests Kurukoo is preparing, coordinating, or following through.</p></article>
            <article class="k-app-card k-request-metric is-attention"><span class="k-app-card-label">Needs you</span><strong data-request-metric="action">—</strong><p>Only decisions or information that need your input appear here.</p></article>
            <article class="k-app-card k-request-metric"><span class="k-app-card-label">Done</span><strong data-request-metric="completed">—</strong><p>Only outcomes confirmed by the canonical request lifecycle are counted.</p></article>
          </section>
          <section class="k-app-card k-request-workspace" aria-labelledby="request-workspace-title" data-workspace-owned-surface="requests">
            <div class="k-request-workspace-head"><div><span class="k-app-card-label">Your coordination</span><h2 id="request-workspace-title">Requests Kurukoo is moving forward</h2><p>See the latest change, what is waiting, and the next useful step without losing the conversation that started it.</p></div><a class="k-app-primary" href="/chat?prompt=Show%20me%20my%20requests">Ask about a request</a></div>
            <div class="k-app-data-list" data-requests-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading your requests…</div></div>
            <div class="k-app-empty" data-requests-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>Nothing is being arranged right now</h3><p>When you need something arranged, Kurukoo will keep it here and show the next step when there is one.</p><a class="k-app-card-action" href="/chat">Tell Kurukoo what you need →</a></div></div>
            <div class="k-app-empty" data-requests-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Request state is unavailable</h3><p>Kurukoo could not read your request details right now. No request status is shown until it can be confirmed.</p><a class="k-app-card-action" href="/requests">Retry Requests →</a></div></div>
          </section>
        <% } else if (section === 'tasks') { %>
          <section class="k-app-grid three k-task-metrics" aria-label="Task work summary" data-workspace-owned-surface="tasks">
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">Ready to do</span><strong data-task-metric="available">—</strong><p>Concrete next actions that are ready for you.</p></article>
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">Moving forward</span><strong data-task-metric="progress">—</strong><p>Actions already underway, connected to the request or goal they support.</p></article>
            <article class="k-app-card k-task-metric"><span class="k-app-card-label">Done</span><strong data-task-metric="completed">—</strong><p>Actions with a recorded completion, kept separate from any later review.</p></article>
          </section>
          <section class="k-app-card k-task-workspace" aria-labelledby="task-workspace-title" data-workspace-owned-surface="tasks">
            <div class="k-task-workspace-head"><div><span class="k-app-card-label">Your next actions</span><h2 id="task-workspace-title">Small steps that move work forward</h2><p>Each task stays connected to the request, objective, or conversation it supports. Completing work always stays explicit.</p></div><a class="k-app-primary" href="/chat?prompt=Show%20me%20my%20tasks">Ask about tasks</a></div>
            <div class="k-app-data-list" data-tasks-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading your task summary…</div></div>
            <div class="k-app-empty" data-tasks-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>Nothing needs doing right now</h3><p>When a concrete next action is ready, Kurukoo will keep it here with the context it supports.</p><a class="k-app-card-action" href="/chat">Ask Kurukoo what to do next →</a></div></div>
            <div class="k-app-empty" data-tasks-error hidden role="alert"><span class="k-app-empty-mark" aria-hidden="true">!</span><div><h3>Task state is unavailable</h3><p>Kurukoo could not read your task details right now. No task status is shown until it can be confirmed; try again once the connection is restored.</p><a class="k-app-card-action" href="/tasks">Retry Tasks →</a></div></div>
          </section>
        <% } else if (section === 'memory') { %>
          <section class="k-memory-live" data-memory-root data-workspace-owned-surface="memory" aria-live="polite" aria-busy="true">
            <div class="k-app-list-loading">Loading your memory…</div>
          </section>
        <% } else if (section === 'notifications') { %>
          <section class="k-notifications-live" data-notifications-root data-workspace-owned-surface="notifications" aria-live="polite" aria-busy="true">
            <div class="k-app-list-loading">Loading your notifications…</div>
          </section>
        <% } else if (section === 'topics') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Community context</span><h2>Useful local knowledge, clearly labelled.</h2><p>Topics are community-shared questions, reports and experiences. They provide context and discovery signals but do not confirm provider status, price, stock, availability, booking or payment.</p><a href="/discover" class="k-app-primary">Return to Discover</a></article><article class="k-app-card"><span class="k-app-card-label">Moderation boundary</span><h2>Share with a review boundary.</h2><p>Authenticated Topics and replies remain subject to moderation and reporting. Community content never silently creates a provider, offer, economic request or transaction.</p><a href="/topics#create-topic" class="k-app-card-action">Share a Topic →</a></article></section>
        <% } else if (section === 'reminders') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Reminder timeline</span><h2>Keep planned follow-through visible.</h2><p>Upcoming, overdue, completed and recurring reminders remain tied to their canonical conversation and notification state. Create or change a reminder through Chat.</p><a href="/chat?prompt=Show%20me%20my%20reminders" class="k-app-primary">Manage reminders in Chat</a></article><article class="k-app-card"><span class="k-app-card-label">Recovery</span><h2>Pause, resume or cancel without losing context.</h2><p>If a reminder is unavailable, delayed or no longer relevant, return to its originating conversation to review, reschedule or cancel it explicitly.</p><a href="/notifications" class="k-app-card-action">Open Notifications →</a></article></section>
        <% } else if (section === 'saved') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Saved context</span><h2>Keep useful items connected to their source.</h2><p>Saved offers, follows and watches remain owner-scoped context. Their current availability, price and provider state are never inferred from a saved entry.</p><a href="/chat?prompt=Show%20me%20my%20saved%20items" class="k-app-primary">Review saved items in Chat</a></article><article class="k-app-card"><span class="k-app-card-label">Next action</span><h2>Recheck before making an economic request.</h2><p>Open the original conversation or source to refresh availability and evidence before moving an item into a request or checkout flow.</p><a href="/requests" class="k-app-card-action">Open Requests →</a></article></section>
        <% } else if (section === 'cart') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Request preparation</span><h2>Review sourced context before commitment.</h2><p>Cart preparation is not payment or fulfilment. Current offer, quantity, price and provider evidence must be confirmed through the canonical Economic Request lifecycle.</p><a href="/requests" class="k-app-primary">Review requests</a></article><article class="k-app-card"><span class="k-app-card-label">Checkout boundary</span><h2>Confirmation stays evidence-gated.</h2><p>Proceed only after the request has a truthful quote and payment readiness. Pending, failed and cancelled outcomes remain distinct from successful completion.</p><a href="/checkout" class="k-app-card-action">Open Checkout →</a></article></section>
        <% } else if (section === 'agents') { %>
          <section class="k-app-card" aria-labelledby="agents-title" data-workspace-owned-surface="agents"><span class="k-app-card-label">Work overview</span><h2 id="agents-title">What Kurukoo is keeping moving</h2><p>Inspect active work, what is waiting, what needs you, and recent outcomes. Everyday coordination still starts in Chat.</p><div class="k-app-data-list" data-agents-list aria-live="polite" aria-busy="true"><div class="k-app-list-loading">Loading work overview…</div></div><div class="k-app-empty" data-agents-empty hidden><span class="k-app-empty-mark" aria-hidden="true">K</span><div><h3>Nothing is running right now</h3><p>Tell Kurukoo what you want to get done, and this view will keep the work in context.</p><a class="k-app-card-action" href="/chat">Start in Chat →</a></div></div></section>
          <script src="/js/kurukoo-agents-convergence.js?v=1" defer></script>
        <% } else if (section === 'capabilities') { %>
          <section class="k-app-card"><span class="k-app-card-label">Capability Portfolio</span><h2>Many roles. One identity.</h2><p>A user can be a barber, contributor, delivery worker, seller and buyer at the same time without creating separate accounts or memories.</p><a href="/chat?prompt=Show%20me%20my%20capabilities" class="k-app-primary">Open Capability Portfolio</a></section>
        <% } else if (section === 'opportunities') { %>
          <section class="k-app-grid two"><article class="k-app-card"><span class="k-app-card-label">Proactive Opportunity Engine</span><h2>Useful ideas without noise.</h2><p>Quiet-user engagement, daily picks and network opportunities are surfaced only when relevant and clearly labelled.</p><a href="/discover" class="k-app-card-action">Open Discover →</a></article><article class="k-app-card"><span class="k-app-card-label">Truth boundary</span><h2>No invented opportunity.</h2><p>Availability, provider status, price and fulfilment remain evidence-gated.</p><a href="/network" class="k-app-card-action">Explore the network →</a></article></section>
        <% } else if (section === 'artifacts') { %>
          <section class="k-app-card"><span class="k-app-card-label">ArtifactService</span><h2>Your files, recordings and transcripts.</h2><p>Artifact metadata is owner-scoped; Google Drive is preferred for durable user-owned storage, with managed fallback only when appropriate.</p><a href="/connect" class="k-app-primary">Open Artifact History</a></section>
        <% } else if (section === 'prayer') { %>
          <section class="k-app-card"><span class="k-app-card-label">Prayer Companion</span><h2>A first-class Kurukoo agent.</h2><p>Prayer requests can become personalized written prayers, routines, reminders and voice experiences through the existing Agent Runtime and voice/artifact boundaries.</p><a href="/chat?prompt=I%20would%20like%20a%20prayer" class="k-app-primary">Start a prayer conversation</a></section>
        <% } else if (section === 'call') { %>
          <%- include('partials/call-workspace') %>
        <% } else if (section === 'safety') { %>
          <section class="k-app-card"><span class="k-app-card-label">Safety</span><h2>Explicit, consent-bound safety support.</h2><p>Manage check-ins, trusted contacts and safety continuity without implying emergency-service delivery.</p><a href="/settings#k-settings-safety" class="k-app-primary">Review safety preferences</a></section>
        <% } else if (section === 'discover') { %>
          <section class="k-app-grid two k-discover-route-links"><article class="k-app-card"><span class="k-app-card-label">Nearby Radar</span><h2>Local context with consent.</h2><p>Presence and availability stay approximate, source-aware, and distinct from any provider confirmation.</p><a href="/topics" class="k-app-card-action">Browse community context →</a></article><article class="k-app-card"><span class="k-app-card-label">Opportunities</span><h2>Find useful next steps.</h2><p>Explore products, providers, Topics and opportunities without losing the context that made them useful.</p><a href="/opportunities" class="k-app-card-action">View opportunities →</a></article></section>
        <% } else if (section === 'settings') { %>
          <section class="k-settings-hub" id="k-settings-hub" aria-label="Settings and account hub">
            <header class="k-settings-hub-intro"><span class="k-app-card-label">Account and workspace</span><h2>Settings that keep Kurukoo working your way</h2><p>Manage your plan, billing, channels, notifications and personal preferences from one place. Actions remain explicit and provider state remains separate from readiness.</p></header>
            <div class="k-settings-grid"><article class="k-settings-card" id="k-settings-subscription"><span class="k-settings-icon"><%- icon('points') %></span><div><h3>Subscription and plan</h3><p>Review plan options, included features and renewal details.</p></div><a href="/subscriptions">Manage subscription</a></article><article class="k-settings-card" id="k-settings-billing"><span class="k-settings-icon"><%- icon('cart') %></span><div><h3>Wallet and billing</h3><p>Review points, top-ups and payment readiness without treating them as confirmed transactions.</p></div><a href="/wallet">Open wallet</a></article><article class="k-settings-card" id="k-settings-connections"><span class="k-settings-icon"><%- icon('channels') %></span><div><h3>Connections</h3><p>Choose the channels and sources you want Kurukoo to use.</p></div><a href="/channels">Manage channels</a></article><article class="k-settings-card" id="k-settings-notifications"><span class="k-settings-icon"><%- icon('notification') %></span><div><h3>Notifications and reminders</h3><p>Decide which updates deserve your attention and where they should appear.</p></div><div class="k-settings-card-actions"><a href="/notifications">Review updates</a><span id="k-settings-notification-optin"></span></div></article><article class="k-settings-card" id="k-settings-privacy"><span class="k-settings-icon"><%- icon('saved') %></span><div><h3>Memory and privacy</h3><p>Review what is remembered and the context you have chosen to keep available.</p></div><a href="/memory">Review memory</a></article><article class="k-settings-card" id="k-settings-safety"><span class="k-settings-icon"><%- icon('safety') %></span><div><h3>Safety and check-ins</h3><p>Manage consent-bound check-ins and trusted contacts without implying emergency response.</p></div><a href="/safety">Open safety</a></article><article class="k-settings-card" id="k-settings-support"><span class="k-settings-icon"><%- icon('help') %></span><div><h3>Help and support</h3><p>Find product guidance, account assistance and available support routes.</p></div><a href="/help">Get help</a></article></div>
          </section>
        <% } else { %>
          <section class="k-app-card"><span class="k-app-card-label"><%= selected.eyebrow %></span><h2><%= selected.title %> remains connected to the same Kurukoo OS.</h2><p><%= selected.description %></p><a href="<%= selected.cta %>" class="k-app-primary"><%= selected.ctaLabel %></a></section>
        <% } %>
      </div>
      <% } %>
    </main>
    <% if (section !== 'chat') { %>
    <aside class="k-reference-context-rail" aria-label="Helpful workspace context">
      <div class="k-reference-rail-heading"><span>Context</span><button type="button" class="k-reference-rail-collapse" aria-label="Collapse workspace context" disabled><%- icon('chevron-left') %></button></div>
      <section class="k-reference-rail-card"><span class="k-reference-rail-label">Keep in view</span><strong><%= section === 'requests' ? 'Requests need clear decisions' : section === 'tasks' ? 'Tasks move requests forward' : section === 'discover' ? 'Results remain source-aware' : 'What matters next' %></strong><p><%= section === 'requests' ? 'Review the next decision, evidence, or response that keeps an outcome moving.' : section === 'tasks' ? 'Each action remains connected to the request or outcome it supports.' : section === 'discover' ? 'Nearby information is useful only when its source and current availability are clear.' : 'Kurukoo keeps useful context close without turning it into an unverified claim.' %></p></section>
      <section class="k-reference-rail-card"><span class="k-reference-rail-label">Shortcuts</span><a href="/notifications"><%- icon('notification') %><span>Updates</span></a><a href="/reminders"><%- icon('reminder') %><span>Reminders</span></a><a href="/settings#k-settings-privacy"><%- icon('saved') %><span>Memory &amp; privacy</span></a></section>
      <section class="k-reference-rail-card k-reference-rail-card-muted"><span class="k-reference-rail-label">Availability</span><p>Details that need provider, source, or delivery confirmation stay clearly marked until they are verified.</p></section>
    </aside>
    <% } %>
  </div>
  <nav class="k-mobile-tabbar" aria-label="Primary workspace navigation">
    <a href="/chat" aria-current="<%= section === 'chat' ? 'page' : 'false' %>"><span><%- icon('chat') %></span><span>Agent</span></a>
    <a href="/discover" aria-current="<%= section === 'discover' ? 'page' : 'false' %>"><span><%- icon('discover') %></span><span>Discover</span></a>
    <a href="/requests" aria-current="<%= section === 'requests' ? 'page' : 'false' %>"><span><%- icon('request') %></span><span>Requests</span></a>
    <a href="/tasks" aria-current="<%= section === 'tasks' ? 'page' : 'false' %>"><span><%- icon('work') %></span><span>Tasks</span></a>
    <button class="k-reference-mobile-more" id="k-reference-mobile-more" type="button" aria-label="Open more workspace tools" aria-controls="k-reference-mobile-more-sheet" aria-expanded="false"><span><%- icon('more') %></span><span>More</span></button>
  </nav>
  <aside class="k-reference-sheet k-reference-mobile-more-sheet" id="k-reference-mobile-more-sheet" aria-label="More workspace tools" hidden>
    <div class="k-reference-sheet-handle" aria-hidden="true"></div><div class="k-reference-sheet-heading"><strong>More</strong><button id="k-reference-mobile-more-close" type="button" aria-label="Close more workspace tools"><%- icon('close') %></button></div>
    <nav><a href="/desk"><%- icon('work') %><span>Desk</span></a><a href="/reminders"><%- icon('reminder') %><span>Reminders</span></a><a href="/connect"><%- icon('channels') %><span>Connect</span></a><a href="/memory"><%- icon('saved') %><span>Memory</span></a><a href="/safety"><%- icon('safety') %><span>Safety</span></a><a href="/settings"><%- icon('settings') %><span>Settings</span></a></nav>
  </aside>
  <script src="/js/kurukoo-workspace.js?v=routes1" defer></script>
  <% if (section === 'desk') { %>
  <script src="/js/kurukoo-desk-data.js?v=1" defer></script>
  <% } %>
  <% if (section === 'requests') { %>
  <script src="/js/kurukoo-requests-convergence.js?v=1" defer></script>
  <% } %>
  <% if (section === 'tasks') { %>
  <script src="/js/kurukoo-tasks-convergence.js?v=1" defer></script>
  <% } %>
  <script src="/js/kurukoo-app-shell.js?v=5" defer></script>
  <% if (section === 'call') { %>
  <script src="/js/kurukoo-call.js?v=2" defer></script>
  <% } %>
  <% if (section === 'chat') { %>
  <script src="https://cdn.jsdelivr.net/npm/marked@15.0.7/marked.min.js" async></script>
  <script src="https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.11.1/highlight.min.js" async></script>
  <script src="/js/kurukoo-speech-output.js?v=1" defer></script>
  <script src="/js/kurukoo-agent-presence.js?v=1" defer></script>
  <script src="/js/kurukoo-primary-chat.js?v=22" defer></script>
  <script type="module" src="/js/kurukoo-voice.js?v=1"></script>
  <script src="/js/kurukoo-qr.js?v=1" defer></script>
  <script src="/js/kurukoo-pwa.js?v=6" defer></script>
  <% } %>
</body>
</html>
