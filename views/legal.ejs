<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main>
    <section class="viewslegalejs-st-1 section" >
        <div class="container">
            <h1  class="viewslegalejs-st-2">Legal & Privacy</h1>
            <p  class="viewslegalejs-st-3">Last Updated: July 2026</p>
        </div>
    </section>

    <section class="section container">
        <div class="viewslegalejs-st-4 grid" >
            <aside  class="viewslegalejs-st-5">
                <ul class="viewslegalejs-st-6 footer-links" >
                    <li><a href="/legal/privacy" class="<%= section === 'privacy' ? 'legal-active-link' : '' %>">Privacy Policy</a></li>
                    <li><a href="/legal/terms" class="<%= section === 'terms' ? 'legal-active-link' : '' %>">Terms of Service</a></li>
                    <li><a href="/legal/cookies" class="<%= section === 'cookies' ? 'legal-active-link' : '' %>">Cookie Policy</a></li>
                </ul>
            </aside>
            
            <div class="viewslegalejs-st-7 card" >
                <% if (section === 'privacy') { %>
                    <h2  class="viewslegalejs-st-8">Privacy Policy</h2>
                    <p  class="viewslegalejs-st-9">At Kurukoo, we take your privacy seriously. This policy explains how we collect, use, and protect your personal information.</p>
                    
                    <h3  class="viewslegalejs-st-10">1. Data Collection</h3>
                    <p  class="viewslegalejs-st-11">We collect minimal data necessary to provide our services, including your phone number, location (when requested), and service preferences.</p>
                    
                    <h3  class="viewslegalejs-st-10">2. How We Use Your Data</h3>
                    <p  class="viewslegalejs-st-11">Your data is used to match you with service providers, process payments, and improve our AI's understanding of your needs.</p>
                    
                    <h3  class="viewslegalejs-st-10">3. Data Security</h3>
                    <p  class="viewslegalejs-st-11">All personal phone numbers are masked via a privacy bridge. We use AES-256 encryption at rest and TLS 1.3 in transit.</p>
                <% } else if (section === 'terms') { %>
                    <h2  class="viewslegalejs-st-8">Terms of Service</h2>
                    <p  class="viewslegalejs-st-9">By using Kurukoo, you agree to these terms. Please read them carefully.</p>
                    
                    <h3  class="viewslegalejs-st-10">1. Service Description</h3>
                    <p  class="viewslegalejs-st-11">Kurukoo is a utility platform connecting users with service providers. We act as an intermediary for most services.</p>
                    
                    <h3  class="viewslegalejs-st-10">2. User Responsibilities</h3>
                    <p  class="viewslegalejs-st-11">Users are responsible for providing accurate information and respecting the providers they connect with.</p>
                    
                    <h3  class="viewslegalejs-st-10">3. Points & Payments</h3>
                    <p  class="viewslegalejs-st-11">Points are non-refundable but can be used for any service on the platform. Lead charges are deducted upon job acceptance.</p>
                <% } else { %>
                    <h2  class="viewslegalejs-st-8">Cookie Policy</h2>
                    <p  class="viewslegalejs-st-9">We use cookies to enhance your experience on our platform.</p>
                    <p  class="viewslegalejs-st-11">These are essential for maintaining your session and remembering your preferences across the App and website.</p>
                <% } %>
            </div>
        </div>
    </section>
</main>

<%- include('_partials/footer') %>
