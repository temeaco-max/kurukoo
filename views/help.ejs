<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main>
    <section class="section help-hero">
        <div class="container text-center">
            <span class="badge help-badge">Kurukoo Help Centre</span>
            <h1 class="help-title">How can we help?</h1>
            <div class="help-search">
                <form class="input-group help-search-box">
                    <input type="text" class="help-search-input" placeholder="Search for answers, guides, or troubleshooting...">
                    <button class="btn btn-primary btn-charcoal ml-8">Search</button>
                </form>
            </div>
        </div>
    </section>

    <section class="section container">
        <div class="pattern-bg"></div>
        <div class="grid grid-3 help-category-grid">
            <a href="#setup" class="help-category card">
                <div class="help-category-icon">🚀</div>
                <h3>Getting Started</h3>
                <p class="text-gray mt-12 text-0_9rem">New to Kurukoo? Learn how to set up your profile and make your first request.</p>
            </a>
            <a href="/legal/privacy" class="help-category card">
                <div class="help-category-icon">🔒</div>
                <h3>Privacy &amp; request boundaries</h3>
                <p class="text-gray mt-12 text-0_9rem">Understand how Kurukoo handles account data and when protected request actions require identity.</p>
            </a>
            <a href="#earning" class="help-category card">
                <div class="help-category-icon">💰</div>
                <h3>Provider participation</h3>
                <p class="text-gray mt-12 text-0_9rem">Learn how to describe a skill and discuss provider participation through Web Chat.</p>
            </a>
        </div>

        <div id="guides" class="help-guides-section">
            <h2 class="help-guides-title">How-To Guides</h2>
            
            <div class="grid grid-2 gap-40">
                <div class="card" id="setup">
                    <span class="category-tag">Setup</span>
                    <h3 class="help-guide-title">How to use Kurukoo in Web Chat</h3>
                    <p class="text-gray mb-20">Describe what you need first. Sign in only when a protected action needs your identity.</p>
                    <ol class="help-guide-list pl-20">
                        <li>Open Web Chat from any page.</li>
                        <li>Describe the request in your own words.</li>
                        <li>Use the sign-in step when Kurukoo needs to preserve or protect the request.</li>
                    </ol>
                </div>

                <div class="card" id="earning">
                    <span class="category-tag">Earning</span>
                    <h3 class="help-guide-title">Adding your skills as a Provider</h3>
                    <p class="text-gray mb-20">Describe the capability you can offer. Participation, matching, and any payment terms require separate confirmation.</p>
                    <ul class="help-guide-list list-none">
                        <li>✓ Type "Add skill" in the chat.</li>
                        <li>✓ Select your primary skill category (e.g., Plumbing).</li>
                        <li>✓ Toggle "Available for work" in your profile settings.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="grid grid-2 help-questions-section">
            <div>
                <h2 class="mb-40">Common Questions</h2>
                <div class="flex-column gap-24">
                    <div class="help-question-item">
                        <h4 class="mb-8">How do I top up my Points?</h4>
                        <p class="text-gray text-0_95rem">Open Web Chat and ask about Points. Kurukoo shows only the funding paths configured for the current deployment.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Can I use another channel?</h4>
                        <p class="text-gray text-0_95rem">Web Chat is the available channel in this deployment. Messaging, USSD, and SMS are shown only when their adapters are connected.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Is my phone number private?</h4>
                        <p class="text-gray text-0_95rem">Kurukoo uses your authenticated account to keep your requests together. Review the Privacy Policy before sharing information with a provider.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">What if no one is available right now?</h4>
                        <p class="text-gray text-0_95rem">Kurukoo can record a deferred request when matching cannot continue immediately. Any notification depends on a configured delivery channel.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Can I share photos or videos for quotes?</h4>
                        <p class="text-gray text-0_95rem">You can attach supported images, PDFs, and videos in Web Chat. A provider may use that context when preparing a quote.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Can I book a football match or join a league?</h4>
                        <p class="text-gray text-0_95rem">Describe the activity you need. Kurukoo will clarify the available fulfilment path rather than promise a booking or league connection.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Can I get a security guard or bodyguard?</h4>
                        <p class="text-gray text-0_95rem">Describe the need in Web Chat. Any provider presentation remains subject to capability, verification, and authorization checks.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Can I hire a car or motorbike?</h4>
                        <p class="text-gray text-0_95rem">Describe the vehicle need in Web Chat. Kurukoo will clarify the next available fulfilment step.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Can I find a resort, motel, lounge, or play zone?</h4>
                        <p class="text-gray text-0_95rem">Describe the venue need in Web Chat. Availability and a booking path are never implied until they are confirmed.</p>
                    </div>
                    <div class="help-question-item">
                        <h4 class="mb-8">Can I get reminders for important things?</h4>
                        <p class="text-gray text-0_95rem">Use your calendar or device reminders for time-sensitive commitments. Kurukoo does not represent reminder delivery unless that capability is configured.</p>
                    </div>
                </div>
            </div>
            
            <div class="card help-support-card">
                <h3 class="mb-24">Still need help?</h3>
                <p class="text-gray mb-32">Use Web Chat to describe a product issue or share feedback. For a written enquiry, use the contact page.</p>
                
                <div class="flex-column gap-20">
                    <a href="/chat" class="btn btn-primary">Open Web Chat</a>
                    <a href="/contact" class="btn btn-secondary w-full flex-center">Open Contact Guidance</a>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const searchForm = document.querySelector('.help-search-box');
    const searchInput = document.querySelector('.help-search-input');
    const categoryGrid = document.querySelector('.help-category-grid');
    const guidesSection = document.getElementById('guides');
    const questionSection = document.querySelector('.help-questions-section');
    
    // Create elements for feedback
    const feedbackDiv = document.createElement('div');
    feedbackDiv.className = 'card text-center mt-24 py-40';
    feedbackDiv.style.display = 'none';
    feedbackDiv.style.gridColumn = '1 / -1';
    feedbackDiv.innerHTML = `
        <div class="search-empty-icon">🔍</div>
        <h3 class="mb-8">No matching answers found</h3>
        <p class="text-gray mb-16">Try searching for terms like "Web Chat", "Points", "provider", or "Earning".</p>
        <button class="btn btn-secondary btn-sm" id="reset-help-search">Reset Search</button>
    `;
    
    // Append feedback inside container
    const container = document.querySelector('.help-questions-section').parentElement;
    container.insertBefore(feedbackDiv, questionSection.nextSibling);

    const resetBtn = feedbackDiv.querySelector('#reset-help-search');
    resetBtn.addEventListener('click', (e) => {
        e.preventDefault();
        searchInput.value = '';
        performSearch('');
    });

    searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const query = searchInput.value.trim().toLowerCase();
        performSearch(query);
    });

    searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();
        performSearch(query);
    });

    function performSearch(query) {
        if (!query) {
            // Restore everything
            categoryGrid.style.display = '';
            guidesSection.style.display = '';
            questionSection.style.display = '';
            feedbackDiv.style.display = 'none';
            
            // Show all nested items
            document.querySelectorAll('.help-category, .help-guides-section .card, .help-question-item').forEach(el => {
                el.style.display = '';
            });
            return;
        }

        // Hide category cards since they are top-level navigation, or filter them
        categoryGrid.style.display = 'none';
        
        let matchCount = 0;

        // Filter How-To Guides
        const guideCards = document.querySelectorAll('.help-guides-section .card');
        let guidesVisible = false;
        guideCards.forEach(card => {
            const text = card.textContent.toLowerCase();
            if (text.includes(query)) {
                card.style.display = '';
                matchCount++;
                guidesVisible = true;
            } else {
                card.style.display = 'none';
            }
        });
        guidesSection.style.display = guidesVisible ? '' : 'none';

        // Filter Common Questions
        const questions = document.querySelectorAll('.help-question-item');
        let questionsVisible = false;
        questions.forEach(q => {
            const text = q.textContent.toLowerCase();
            if (text.includes(query)) {
                q.style.display = '';
                matchCount++;
                questionsVisible = true;
            } else {
                q.style.display = 'none';
            }
        });

        // Always keep the support card visible but manage the parent section
        questionSection.style.display = ''; // keep section to show support card or matching questions

        if (matchCount === 0) {
            feedbackDiv.style.display = 'block';
            guidesSection.style.display = 'none';
            // Hide the question columns parent if no questions matched, but keep support card
            document.querySelector('.help-questions-section > div').style.display = 'none';
        } else {
            feedbackDiv.style.display = 'none';
            document.querySelector('.help-questions-section > div').style.display = '';
        }
    }
});
</script>

<%- include('_partials/footer') %>
