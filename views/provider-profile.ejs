<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container provider-main">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar">
        <a href="/" class="breadcrumb-link">Home</a> /
        <span>Provider</span>
    </div>

    <!-- Provider Header -->
    <div class="provider-header">
        <div class="provider-avatar">
            <%= provider.initials %>
        </div>
        <div>
            <h1 class="provider-h1">
                <%= provider.name %>
            </h1>
            <div class="provider-meta-row">
                <span>&#128205; Listed service area: <%= provider.location %></span>
                <span>Request details require confirmation</span>
            </div>
        </div>
    </div>

    <!-- Skills -->
    <section class="section-mb-40">
        <h2 class="section-h2">Services offered</h2>
        <div class="skills-grid">
            <% provider.skills.forEach(function(skill) { %>
            <div class="skill-card">
                <div class="skill-name"><%= skill.skill %></div>
                <div class="skill-meta">
                    <span>Listed capability</span>
                    <% if (skill.hourlyRate > 0) { %><span>Rate subject to confirmation</span><% } %>
                </div>
            </div>
            <% }) %>
        </div>
    </section>

    <!-- CTA -->
    <div class="banner-cta-card">
        <h2 class="banner-cta-h2">
            Connect with <%= provider.name %>
        </h2>
        <p class="banner-cta-p">
            Start a request in Web Chat. Kurukoo will preserve the provider reference and present the next supported action only after the required checks.
        </p>
        <a href="/chat?prompt=I%20want%20to%20request%20a%20service%20from%20<%= encodeURIComponent(provider.name) %>"
           class="btn-wa-green">
            &rightarrow;&nbsp;Start in Web Chat
        </a>
    </div>

    <!-- Trust & Safety -->
    <section class="section-mb-40">
        <h2 class="section-h2">Trust &amp; safety</h2>
        <div class="trust-safety-card">
            <ul class="trust-list">
                <li class="trust-item">
                    <span class="check-green">&#10003;</span> Provider details are reviewed in the request flow before a protected action is presented.
                </li>
                <li class="trust-item">
                    <span class="check-green">&#10003;</span> Payment and escrow steps apply only when their verified integrations are available.
                </li>
                <li class="trust-item">
                    <span class="check-green">&#10003;</span> The canonical request lifecycle records applicable evidence and dispute steps when those actions are used.
                </li>
            </ul>
        </div>
    </section>

    <!-- FAQ Section (§53.2.2 — visible, indexable FAQ accordion) -->
    <% if (faqs && faqs.length > 0) { %>
    <section class="section-mb-40">
        <h2 class="section-h2">Frequently asked questions</h2>
        <div>
            <% faqs.forEach(function(f) { %>
            <details class="faq-item-details">
                <summary class="faq-item-summary"><%= f.question %></summary>
                <p class="faq-item-answer"><%= f.answer %></p>
            </details>
            <% }) %>
        </div>
    </section>
    <% } %>

    <!-- Privacy Notice -->
    <p class="privacy-notice-text">
        &#128274; This public profile does not display a phone number. Any follow-up begins in Web Chat and presents only the next supported action.
    </p>
</main>

<%- include('_partials/footer') %>