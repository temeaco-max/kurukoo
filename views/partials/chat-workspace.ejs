<section class="k-chat-workspace chat-main" data-workspace-owned-surface="chat" aria-label="Kurukoo Agent">
  <header class="k-chat-subheader" aria-label="Agent workspace">
    <div class="k-chat-subheader-copy">
      <button class="k-chat-subheader-back" id="surface-header-back" type="button" aria-label="Back to Agent" title="Back to Agent" hidden>
        <svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#chevron-left"></use></svg>
      </button>
      <div>
        <span class="k-chat-subheader-eyebrow">Agent</span>
        <strong id="header-context-title">Coordinate what matters</strong>
      </div>
    </div>
  </header>

  <section class="chat-scroll" id="chat-scroll" aria-live="polite">
    <div class="chat-content" id="chat-content">
      <div class="welcome" id="welcome">
        <img class="welcome-logo" src="/assets/brand/logo-icon.png" alt="Kurukoo" width="42" height="42">
        <h1 id="welcome-title">How can Kurukoo help today?</h1>
        <p id="welcome-copy">Ask a question, coordinate something, or pick up where you left off.</p>
      </div>
    </div>
  </section>

  <section class="composer-wrap">
    <div class="qr-context-banner" id="qr-context-banner" role="status" aria-live="polite" hidden></div>
    <div class="voice-status" id="voice-status" role="status" aria-live="polite" hidden></div>
    <button class="voice-end" id="voice-end" type="button" hidden>End voice</button>
    <div class="deferred-status" id="deferred-status" hidden></div>
    <div class="native-assistance-status" id="native-assistance-status" role="status" hidden></div>
    <div class="attachment-preview" id="attachment-preview" hidden></div>
    <div class="composer">
      <input type="file" id="file-input" hidden accept="image/png,image/jpeg,image/webp,image/gif,application/pdf,video/mp4,video/webm">
      <button class="composer-btn" id="attach-file" type="button" aria-label="Attach file" title="Attach file"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#attach"></use></svg></button>
      <textarea id="message-input" rows="1" maxlength="12000" placeholder="Ask anything…" aria-label="Ask Kurukoo"></textarea>
      <button class="composer-btn" id="voice-input" type="button" aria-label="Use voice input" title="Use voice input"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#mic"></use></svg></button>
      <button class="send-btn" id="send-message" type="button" aria-label="Ask Kurukoo" title="Ask Kurukoo"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#send"></use></svg></button>
      <button class="send-btn stop-btn" id="stop-generation" type="button" aria-label="Stop generation" title="Stop generation" hidden><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#stop"></use></svg></button>
    </div>
    <div class="composer-footer"><span>Kurukoo can be wrong. Check important details.</span></div>
  </section>
  <div class="chat-toast-region" id="chat-toast-region" aria-live="polite" aria-atomic="true"></div>
</section>

<aside class="chat-inspector" id="chat-inspector" aria-label="Relevant conversation details" hidden>
  <div class="inspector-header"><span class="inspector-context-label" id="inspector-title">Details</span><button class="icon-btn inspector-collapse-button" id="inspector-collapse" type="button" aria-label="Collapse details panel" title="Collapse details panel"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#chevron-left"></use></svg></button><button class="icon-btn inspector-close-button" id="close-inspector" type="button" aria-label="Close details panel" title="Close details panel">×</button></div>
  <section class="inspector-card context-intro" id="active-work-context-card" data-context-card="requests tasks reminders" hidden><div class="inspector-label">Active work</div><p>The request, task, reminder, or decision you opened appears here while it is relevant to this conversation.</p></section>
  <div class="inspector-discovery-stack" id="discovery-context-card" data-context-card="discover daily-picks" hidden><button class="inspector-image-card inspector-image-card-button" id="daily-picks-promo-card" type="button" data-surface-view="daily-picks" aria-label="Daily Picks. Open discovery." hidden><img id="daily-picks-promo-image" src="" alt="" loading="lazy"><span class="inspector-card-tag">Daily Picks</span><span class="inspector-card-arrow" aria-hidden="true"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg></span></button></div>
  <div class="inspector-card" id="proactive-context-card" data-context-card="requests tasks discover daily-picks cart" hidden><div class="inspector-label">Next steps</div><div class="proactive-context-list" id="proactive-context-list"></div></div>
  <div class="inspector-card" id="agent-goal-card" data-context-card="requests tasks reminders" hidden><div class="inspector-label">Work in progress</div><div class="agent-goal-presence" data-agent-presence="idle"><span class="k-desk-presence-dot" aria-hidden="true"></span><span class="agent-goal-presence-label" aria-label="Agent Presence">Available</span></div><strong id="agent-goal-status">Checking</strong><p class="inspector-note" id="agent-goal-summary">Kurukoo will show confirmed next steps here.</p><div class="agent-goal-doing"><span class="inspector-label">What is happening</span><p class="agent-goal-doing-text" id="agent-goal-doing">Kurukoo is checking the current objective.</p></div><div class="agent-goal-needs"><span class="inspector-label">What is needed from you</span><p class="agent-goal-needs-text" id="agent-goal-needs">Waiting to confirm the next step.</p></div><div class="agent-goal-next"><span class="inspector-label">Next step</span><p class="agent-goal-next-text" id="agent-goal-next">Continue in Agent when you are ready.</p></div><div class="inspector-list" id="agent-goal-events"></div><div class="agent-goal-actions"><button class="text-btn" id="agent-goal-pause" type="button" hidden>Pause</button><button class="text-btn" id="agent-goal-cancel" type="button" hidden>Stop follow-up</button></div></div>
  <section class="inspector-card" id="nearby-context-card" data-context-card="discover daily-picks" hidden><div class="inspector-label" id="nearby-context-label">Nearby results</div><div class="radar-list" id="radar-list"><div class="empty-state">Nearby results appear only when you ask for local discovery.</div></div></section>
  <section class="inspector-card task-context-card" id="task-context-card" data-context-card="tasks requests" hidden><div class="inspector-label">Next actions</div><div class="task-context-list" id="task-context-list"><div class="empty-state">Checking for pending tasks…</div></div><button class="inspector-menu-link task-context-link" type="button" data-surface-view="tasks"><span class="inspector-link-icon"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#work"></use></svg></span><span class="inspector-link-copy"><strong>Open Tasks</strong><small>See the full task workspace</small></span><svg class="k-icon inspector-link-chevron"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg></button></section>
  <section class="inspector-card" id="reminders-card" data-context-card="reminders requests tasks" hidden><div class="inspector-label">Reminders</div><div class="empty-state" id="reminder-list">No active reminders.</div></section>
  <section class="inspector-card" id="memory-context-card" data-context-card="memory settings" hidden><div class="inspector-label">Saved preferences</div><div class="empty-state" id="inspector-memory">Manage personal context in Settings.</div></section>
  <section class="inspector-card" id="safety-card" data-context-card="safety requests" hidden><div class="inspector-label">Safety</div><p class="inspector-note">Safety and check-ins are managed from account settings.</p><div id="inspector-feedback" class="inspector-feedback" role="status" hidden></div><div id="safety-contact-list" class="inspector-list"></div><div id="safety-checkin-list" class="inspector-list"></div></section>
  <section class="inspector-card" id="connect-context-card" data-context-card="connect" hidden><div class="inspector-label">Connections</div><button class="inspector-menu-link" type="button" data-surface-view="connect"><span class="inspector-link-copy"><strong>Manage connections</strong><small>Choose how Kurukoo can reach you</small></span><svg class="k-icon inspector-link-chevron"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg></button></section>
</aside>
