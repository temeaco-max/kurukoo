<section class="k-chat-workspace chat-main" data-workspace-owned-surface="chat" aria-label="Kurukoo conversation">
<header class="k-chat-subheader" aria-label="Conversation workspace">
  <div class="k-chat-subheader-copy">
    <button class="k-chat-subheader-back" id="surface-header-back" type="button" aria-label="Back to conversation" title="Back to conversation" hidden>
      <svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#chevron-left"></use></svg>
    </button>
    <div>
      <span class="k-chat-subheader-eyebrow">Conversation</span>
      <strong id="header-context-title">Kurukoo</strong>
    </div>
  </div>
  <span class="k-chat-subheader-status" id="chat-subheader-status">Context stays with this conversation</span>
</header>
<section class="chat-scroll" id="chat-scroll" aria-live="polite"><div class="chat-content" id="chat-content"><div class="welcome" id="welcome"><img class="welcome-logo" src="/assets/brand/logo-icon.png" alt="Kurukoo" width="42" height="42"><h1>What would you like to move forward?</h1><p>Tell Kurukoo what you need. We can think it through, keep it in context, and make the next step clear together.</p><div class="quick-actions" id="quick-actions"><button type="button" data-prompt="I need help with something"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#chat"></use></svg> I need help with something</button><button type="button" data-prompt="Remind me tomorrow at 8 to call Mum"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#reminder"></use></svg> Set a reminder</button><button type="button" data-prompt="I need to buy or source something"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#package"></use></svg> Find or arrange something</button><button type="button" data-prompt="I need to get somewhere"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#ride"></use></svg> Plan a journey</button><button type="button" data-prompt="Manage my safety contacts and check-ins"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#safety"></use></svg> Safety & check-ins</button></div></div></div></section>
<section class="composer-wrap"><div class="qr-context-banner" id="qr-context-banner" role="status" aria-live="polite" hidden></div><div class="voice-status" id="voice-status" role="status" aria-live="polite" hidden></div><button class="voice-end" id="voice-end" type="button" hidden>End voice</button><div class="deferred-status" id="deferred-status" hidden></div><div class="native-assistance-status" id="native-assistance-status" role="status" hidden></div><div class="composer-quick-actions" id="composer-quick-actions"><button type="button" data-prompt="Set a reminder"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#reminder"></use></svg> Reminder</button><button type="button" data-prompt="Manage my safety contacts and check-ins"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#safety"></use></svg> Safety</button><button type="button" data-prompt="I need something sourced"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#package"></use></svg> Source something</button><button type="button" data-prompt="I need to get somewhere"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#ride"></use></svg> Get somewhere</button><button type="button" data-prompt="Help me earn money"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#work"></use></svg> Earn</button></div><div class="attachment-preview" id="attachment-preview" hidden></div><div class="composer"><input type="file" id="file-input" hidden accept="image/png,image/jpeg,image/webp,image/gif,application/pdf,video/mp4,video/webm"><button class="composer-btn" id="attach-file" type="button" aria-label="Attach file"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#attach"></use></svg></button><textarea id="message-input" rows="1" maxlength="12000" placeholder="Tell Kurukoo what you want to move forward…" aria-label="Message Kurukoo"></textarea><button class="composer-btn" id="voice-input" type="button" aria-label="Use voice input"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#mic"></use></svg></button><button class="send-btn" id="send-message" type="button" aria-label="Send message" title="Send message"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#send"></use></svg></button><button class="send-btn stop-btn" id="stop-generation" type="button" aria-label="Stop generation" title="Stop generation" hidden><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#stop"></use></svg></button></div><div class="composer-footer"><span>Kurukoo may make mistakes. Check important information.</span></div></section><div class="chat-toast-region" id="chat-toast-region" aria-live="polite" aria-atomic="true"></div>
</section>
<aside class="chat-inspector" id="chat-inspector" aria-label="Conversation context"><div class="inspector-header"><span class="inspector-context-label" id="inspector-title">Context</span><button class="icon-btn inspector-collapse-button" id="inspector-collapse" type="button" aria-label="Collapse context panel" title="Collapse context panel"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#chevron-left"></use></svg></button><button class="icon-btn inspector-close-button" id="close-inspector" type="button" aria-label="Close context panel" title="Close context panel">×</button></div><div class="inspector-card context-intro" data-context-card="all requests saved"><div class="inspector-label">Current work</div><p>The latest detail, decision, and next step appear here when Kurukoo is coordinating something with you.</p></div><div class="inspector-discovery-stack" id="discovery-context-card" data-context-card="discover daily-picks requests cart"><button class="inspector-image-card inspector-image-card-button" id="daily-picks-promo-card" type="button" data-surface-view="daily-picks" aria-label="Daily Picks. Open the streamlined discovery view." hidden><img id="daily-picks-promo-image" src="" alt="" loading="lazy"><span class="inspector-card-tag">Daily Picks</span><span class="inspector-card-arrow" aria-hidden="true"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg></span></button></div><div class="inspector-card" id="connect-context-card" data-context-card="connect"><div class="inspector-label">Ways to stay connected</div><div class="channel-context-list"><div><strong>Web Chat</strong><small>Ready now</small></div><div><strong>WhatsApp</strong><small>Setup required</small></div><div><strong>Telegram</strong><small>Setup required</small></div></div><button class="inspector-menu-link" type="button" data-surface-view="connect"><span class="inspector-link-copy"><strong>Manage connections</strong><small>Choose how Kurukoo can reach you</small></span><svg class="k-icon inspector-link-chevron"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg></button></div><div class="inspector-card" id="proactive-context-card" data-context-card="requests tasks discover daily-picks cart" hidden><div class="inspector-label">Suggested next steps</div><div class="proactive-context-list" id="proactive-context-list"></div></div><div class="inspector-card" id="agent-goal-card" hidden><div class="inspector-label">Work in progress</div><div class="agent-goal-presence" data-agent-presence="idle"><span class="k-desk-presence-dot" aria-hidden="true"></span><span class="agent-goal-presence-label" aria-label="Agent Presence">Available</span></div><strong id="agent-goal-status">Checking</strong><p class="inspector-note" id="agent-goal-summary">Kurukoo will show confirmed next steps here.</p><div class="agent-goal-doing"><span class="inspector-label">What is happening</span><p class="agent-goal-doing-text" id="agent-goal-doing">Kurukoo is checking the current objective.</p></div><div class="agent-goal-needs"><span class="inspector-label">What is needed from you</span><p class="agent-goal-needs-text" id="agent-goal-needs">Waiting to confirm the next step.</p></div><div class="agent-goal-next"><span class="inspector-label">Next step</span><p class="agent-goal-next-text" id="agent-goal-next">Continue in Chat when you are ready.</p></div><div class="inspector-list" id="agent-goal-events"></div><div class="agent-goal-actions"><button class="text-btn" id="agent-goal-pause" type="button" hidden>Pause</button><button class="text-btn" id="agent-goal-cancel" type="button" hidden>Stop follow-up</button></div></div><div class="inspector-card" id="nearby-context-card" data-context-card="discover requests cart daily-picks"> <div class="inspector-label" id="nearby-context-label">Nearby</div><div class="radar-list" id="radar-list"><div class="empty-state">Ask Kurukoo what is nearby when local discovery is useful.</div></div></div><div class="inspector-card task-context-card" id="task-context-card" data-context-card="tasks requests"><div class="inspector-label">Next actions</div><div class="task-context-list" id="task-context-list"><div class="empty-state">Checking for pending tasks…</div></div><button class="inspector-menu-link task-context-link" type="button" data-surface-view="tasks"><span class="inspector-link-icon"><svg class="k-icon"><use href="/icons/kurukoo-icons.svg#work"></use></svg></span><span class="inspector-link-copy"><strong>Open Tasks</strong><small>See the full task workspace</small></span><svg class="k-icon inspector-link-chevron"><use href="/icons/kurukoo-icons.svg#chevron-right"></use></svg></button></div><div class="inspector-card" id="memory-context-card" data-context-card="memory settings safety"><div class="inspector-label">Nearby context</div><div class="empty-state" id="inspector-memory">Shared from your Memory Profile when you are signed in.</div></div><div class="inspector-card" id="reminders-card" data-context-card="reminders requests tasks" hidden><div class="inspector-label">Reminders</div><div class="empty-state" id="reminder-list">No active reminders.</div></div><div class="inspector-card" id="safety-card" data-context-card="safety requests" hidden><div class="inspector-label">Personal safety</div><p class="inspector-note">Kurukoo can coordinate safety instructions, but it is not an emergency responder. Contact notifications require a configured delivery service.</p><form id="safety-contact-form" class="inspector-form"><input id="safety-contact-name" required placeholder="Contact name"><input id="safety-contact-phone" required placeholder="Phone number"><input id="safety-contact-relationship" placeholder="Relationship (optional)"><button class="primary-btn" type="submit">Add contact</button></form><div id="inspector-feedback" class="inspector-feedback" role="status" hidden></div><div id="safety-contact-list" class="inspector-list"></div><div id="safety-checkin-list" class="inspector-list"></div></div></aside>
