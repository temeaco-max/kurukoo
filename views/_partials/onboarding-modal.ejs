<!-- Kurukoo Simplified Unified Entry Gateway Modal -->
<div id="kurukoo-onboarding-modal" class="k-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="k-gateway-title">
    <div class="k-modal-card">
        <button type="button" class="k-modal-close" id="k-modal-close-btn" aria-label="Close modal" data-onboarding-close>&times;</button>
        
        <div class="k-modal-body">
            <div class="k-gateway-header">
                <span class="badge-pill k-gateway-badge">🚀 Unified Entry Gateway</span>
                <h2 id="k-gateway-title" class="k-gateway-title">Start Chatting with Kurukoo</h2>
                <p class="k-gateway-desc">Choose your favorite channel for instant conversational assistance, or enter your number to synchronize your Living Economic Profile.</p>
            </div>

            <!-- 1-Click Fast Channel Selector Grid -->
            <div class="k-gateway-channels-section">
                <label class="k-section-subtitle">Instant Direct Access (1-Click Launch)</label>
                <div class="k-gateway-channels-grid">
                    <a href="https://wa.me/2347000?text=Hi%2C%20Kurukoo%20I%20want%20to%20get%20started" target="_blank" class="k-channel-direct-card k-channel-wa" id="gateway-wa-link" data-onboarding-channel="whatsapp">
                        <div class="k-channel-card-icon">💬</div>
                        <div class="k-channel-card-body">
                            <strong class="k-channel-card-title">WhatsApp 7000</strong>
                            <span class="k-channel-card-sub">Chat directly on 7000</span>
                        </div>
                        <span class="k-channel-card-badge">Popular</span>
                    </a>

                    <a href="https://t.me/kurukoo_bot" target="_blank" class="k-channel-direct-card k-channel-tg" id="gateway-tg-link" data-onboarding-channel="telegram">
                        <div class="k-channel-card-icon">✈️</div>
                        <div class="k-channel-card-body">
                            <strong class="k-channel-card-title">Telegram Bot</strong>
                            <span class="k-channel-card-sub">Instant response &amp; bot</span>
                        </div>
                        <span class="k-channel-card-badge free-badge">Free</span>
                    </a>

                    <a href="/dashboard.html" class="k-channel-direct-card k-channel-pwa" id="gateway-pwa-link" data-onboarding-channel="pwa">
                        <div class="k-channel-card-icon">🌐</div>
                        <div class="k-channel-card-body">
                            <strong class="k-channel-card-title">Web App (PWA)</strong>
                            <span class="k-channel-card-sub">Fast, offline &amp; free</span>
                        </div>
                        <span class="k-channel-card-badge pwa-badge">Recommended</span>
                    </a>

                    <a href="tel:*7000%23" class="k-channel-direct-card k-channel-ussd" id="gateway-ussd-link" data-onboarding-channel="ussd">
                        <div class="k-channel-card-icon">📞</div>
                        <div class="k-channel-card-body">
                            <strong class="k-channel-card-title">Dial *7000#</strong>
                            <span class="k-channel-card-sub">No internet required</span>
                        </div>
                        <span class="k-channel-card-badge ussd-badge">Offline</span>
                    </a>
                </div>
            </div>

            <div class="k-gateway-divider">
                <span class="k-divider-label">or personalize your session</span>
            </div>

            <!-- Quick Number Linking Form -->
            <form id="kurukoo-onboarding-form" class="k-gateway-form">
                <div class="k-form-row">
                    <div class="k-form-col">
                        <label for="k-onboard-name" class="form-label">Full Name <span class="label-optional">(optional)</span></label>
                        <input type="text" id="k-onboard-name" class="form-input" placeholder="e.g. Chinedu Okafor" autocomplete="name">
                    </div>

                    <div class="k-form-col">
                        <label for="k-onboard-phone" class="form-label">Phone Number <span class="label-required">*</span></label>
                        <div class="phone-input-group">
                            <select id="k-onboard-prefix" class="phone-prefix-select" aria-label="Country Code">
                                <option value="+234">🇳🇬 +234</option>
                                <option value="+233">🇬🇭 +233</option>
                                <option value="+44">🇬🇧 +44</option>
                            </select>
                            <input type="tel" id="k-onboard-phone" class="form-input phone-number-input" placeholder="803 000 0000" required autocomplete="tel">
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">What is your primary goal?</label>
                    <div class="goal-chip-group">
                        <label class="goal-chip-label">
                            <input type="radio" name="k_onboard_goal" value="buyer" checked class="goal-chip-radio">
                            <span class="goal-chip-box">
                                <span class="goal-chip-icon">🛒</span>
                                <span>Find &amp; Buy Services</span>
                            </span>
                        </label>
                        <label class="goal-chip-label">
                            <input type="radio" name="k_onboard_goal" value="seller" class="goal-chip-radio">
                            <span class="goal-chip-box">
                                <span class="goal-chip-icon">🛠️</span>
                                <span>Offer Skills &amp; Sell</span>
                            </span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block k-gateway-submit-btn" id="k-onboard-submit-btn">
                    <span>Connect &amp; Start Chatting</span>
                    <span class="btn-arrow">→</span>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    // Unified Entry Gateway Controller
    let onboardingReturnFocus = null;
    window.openKurukooOnboarding = function(goal, category, originalUrl) {
        onboardingReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        const modal = document.getElementById('kurukoo-onboarding-modal');
        if (!modal) return;

        // Auto-fill from localStorage if available
        const savedPhone = localStorage.getItem('kurukoo_user_phone');
        const savedName = localStorage.getItem('kurukoo_user_name');
        
        if (savedPhone) {
            const phoneInput = document.getElementById('k-onboard-phone');
            if (phoneInput) {
                let clean = savedPhone;
                if (clean.startsWith('+234')) clean = clean.substring(4);
                else if (clean.startsWith('+233')) clean = clean.substring(4);
                else if (clean.startsWith('+44')) clean = clean.substring(3);
                phoneInput.value = clean.trim();
            }
        }
        if (savedName) {
            const nameInput = document.getElementById('k-onboard-name');
            if (nameInput && !nameInput.value) nameInput.value = savedName;
        }

        if (goal) {
            const radio = document.querySelector(`input[name="k_onboard_goal"][value="${goal}"]`);
            if (radio) radio.checked = true;
        }

        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
        requestAnimationFrame(() => document.getElementById('k-modal-close-btn')?.focus());
    };

    // Alias for developer convenience
    window.openUnifiedEntryGateway = window.openKurukooOnboarding;

    window.closeKurukooOnboarding = function() {
        const modal = document.getElementById('kurukoo-onboarding-modal');
        if (!modal) return;
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('modal-open');
        onboardingReturnFocus?.focus?.();
    };

    function handleChannelClick(channel) {
        const name = document.getElementById('k-onboard-name')?.value.trim();
        const rawPhone = document.getElementById('k-onboard-phone')?.value.trim();
        const prefix = document.getElementById('k-onboard-prefix')?.value || '+234';

        if (rawPhone) {
            const fullPhone = prefix + rawPhone.replace(/\D/g, '');
            localStorage.setItem('kurukoo_user_phone', fullPhone);
        }
        if (name) {
            localStorage.setItem('kurukoo_user_name', name);
        }
        localStorage.setItem('kurukoo_preferred_channel', channel);
        closeKurukooOnboarding();
    }

    function handleOnboardingFormSubmit(e) {
        e.preventDefault();
        const name = document.getElementById('k-onboard-name')?.value.trim();
        const rawPhone = document.getElementById('k-onboard-phone')?.value.trim();
        const prefix = document.getElementById('k-onboard-prefix')?.value || '+234';
        const goalEl = document.querySelector('input[name="k_onboard_goal"]:checked');
        const goal = goalEl ? goalEl.value : 'buyer';

        if (!rawPhone) return;

        const fullPhone = prefix + rawPhone.replace(/\D/g, '');
        localStorage.setItem('kurukoo_user_phone', fullPhone);
        if (name) localStorage.setItem('kurukoo_user_name', name);
        localStorage.setItem('kurukoo_user_goal', goal);

        // Sync with API
        fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: fullPhone, name: name || 'Kurukoo User', goal: goal })
        }).catch(() => null);

        closeKurukooOnboarding();

        // The PWA is served from one canonical public URL; the goal remains query context.
        window.location.href = `/dashboard.html?goal=${encodeURIComponent(goal)}`;
    }

    function bindOnboardingControls() {
        const modal = document.getElementById('kurukoo-onboarding-modal');
        if (!modal || modal.dataset.eventsBound) return;
        modal.dataset.eventsBound = 'true';

        document.querySelectorAll('[data-onboarding-goal]').forEach(trigger => {
            trigger.addEventListener('click', () => openKurukooOnboarding(trigger.dataset.onboardingGoal || 'buyer'));
        });
        modal.querySelector('[data-onboarding-close]')?.addEventListener('click', closeKurukooOnboarding);
        modal.querySelectorAll('[data-onboarding-channel]').forEach(link => {
            link.addEventListener('click', () => handleChannelClick(link.dataset.onboardingChannel));
        });
        modal.querySelector('#kurukoo-onboarding-form')?.addEventListener('submit', handleOnboardingFormSubmit);
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeKurukooOnboarding();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && modal.classList.contains('active')) closeKurukooOnboarding();
        });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindOnboardingControls);
    else bindOnboardingControls();
</script>
