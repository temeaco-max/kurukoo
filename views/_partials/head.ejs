<!DOCTYPE html>
<html lang="<%= typeof locale !== 'undefined' ? locale : 'en' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%
        const seoTitle = (typeof seo !== 'undefined' && seo.title) ? seo.title : 'Kurukoo — Tell us what you need.';
        const seoDesc = (typeof seo !== 'undefined' && seo.meta_description) ? seo.meta_description : 'Kurukoo is a conversational fulfillment network. Tell us what you need, and we figure out who or what can fulfil it.';
        const seoCanonical = (typeof seo !== 'undefined' && (seo.canonical_url || seo.canonical)) ? (seo.canonical_url || seo.canonical) : 'https://kurukoo.com' + (typeof reqPath !== 'undefined' ? reqPath : '');
        const seoOgTitle = (typeof seo !== 'undefined' && seo.og_title) ? seo.og_title : seoTitle;
        const seoOgDesc = (typeof seo !== 'undefined' && seo.og_description) ? seo.og_description : seoDesc;
        const seoOgImage = (typeof seo !== 'undefined' && seo.og_image) ? seo.og_image : 'https://kurukoo.com/assets/icon-512.png';
    %>
    <title><%= seoTitle %></title>
    <meta name="description" content="<%= seoDesc %>">
    <link rel="canonical" href="<%= seoCanonical %>">
    <% if (typeof seo !== 'undefined' && seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>"><% } %>
    <meta property="og:title" content="<%= seoOgTitle %>">
    <meta property="og:description" content="<%= seoOgDesc %>">
    <meta property="og:url" content="<%= seoCanonical %>">
    <meta property="og:image" content="<%= seoOgImage %>">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cormorant+Garamond:wght@500;600&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/site.css?v=1.3.0">
    <% if (typeof pageStyles !== 'undefined' && Array.isArray(pageStyles)) { pageStyles.forEach((pageStyle) => { %>
    <link rel="stylesheet" href="<%= pageStyle %>">
    <% }); } %>
    <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg">
    <link rel="manifest" href="/manifest.json">
</head>
<body>
