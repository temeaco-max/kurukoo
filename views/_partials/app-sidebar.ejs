<% const icon = (name) => `<svg class="k-app-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; %>
<aside class="k-app-sidebar" aria-label="Kurukoo application navigation" data-kurukoo-shared="app-sidebar">
  <a class="k-app-new" href="/chat">＋ Start with Kurukoo</a>
  <nav class="k-app-nav k-app-nav-primary" aria-label="Primary">
    <a class="<%= canonicalPath === '/chat' ? 'active' : '' %>" href="/chat"><%- icon('chat') %><span>Chat</span></a>
    <a class="<%= canonicalPath === '/home' || section === 'desk' ? 'active' : '' %>" href="/home"><%- icon('home') %><span>Home</span></a>
    <a class="<%= canonicalPath === '/discover' || section === 'discover' ? 'active' : '' %>" href="/discover"><%- icon('discover') %><span>Discover</span></a>
    <a class="<%= canonicalPath === '/activity' || section === 'requests' ? 'active' : '' %>" href="/activity"><%- icon('request') %><span>Activity</span></a>
    <a class="<%= canonicalPath === '/work' || section === 'tasks' ? 'active' : '' %>" href="/work"><%- icon('work') %><span>Work</span></a>
  </nav>
  <div class="k-app-divider"></div>
  <details class="k-app-nav-fold" open>
    <summary><span>Context</span><span class="k-more-chevron" aria-hidden="true">⌄</span></summary>
    <nav class="k-app-nav" aria-label="Context">
      <a class="<%= section === 'reminders' ? 'active' : '' %>" href="/reminders"><%- icon('notification') %><span>Reminders</span></a>
      <a class="<%= section === 'saved' ? 'active' : '' %>" href="/saved"><%- icon('saved') %><span>Saved</span></a>
      <a class="<%= section === 'notifications' ? 'active' : '' %>" href="/notifications"><%- icon('notification') %><span>Notifications</span></a>
    </nav>
  </details>
  <details class="k-app-nav-fold">
    <summary><span>Network</span><span class="k-more-chevron" aria-hidden="true">⌄</span></summary>
    <nav class="k-app-nav" aria-label="Network">
      <a class="<%= section === 'topics' ? 'active' : '' %>" href="/topics"><%- icon('topic') %><span>Topics</span></a>
      <a class="<%= section === 'opportunities' ? 'active' : '' %>" href="/opportunities"><%- icon('opportunity') %><span>Opportunities</span></a>
    </nav>
  </details>
  <details class="k-app-nav-fold">
    <summary><span>You</span><span class="k-more-chevron" aria-hidden="true">⌄</span></summary>
    <nav class="k-app-nav" aria-label="You">
      <a class="<%= section === 'wallet' ? 'active' : '' %>" href="/wallet"><%- icon('wallet') %><span>Wallet</span></a>
      <a class="<%= section === 'points' ? 'active' : '' %>" href="/points"><%- icon('points') %><span>Points</span></a>
      <a class="<%= section === 'subscriptions' ? 'active' : '' %>" href="/subscriptions"><%- icon('plan') %><span>Plans</span></a>
    </nav>
  </details>
  <div class="k-app-sidebar-spacer"></div>
  <nav class="k-app-nav k-app-nav-account" aria-label="Settings">
    <a class="<%= section === 'connect' ? 'active' : '' %>" href="/connect"><%- icon('connect') %><span>Connect</span></a>
    <a class="<%= section === 'settings' ? 'active' : '' %>" href="/settings"><%- icon('settings') %><span>Settings</span></a>
    <a href="/help"><%- icon('help') %><span>Help</span></a>
  </nav>
</aside>
