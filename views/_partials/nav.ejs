<script>
    // Update User Icon / Status based on localStorage
    function updateNavUserUI() {
        const userBtn = document.getElementById('nav-user-btn');
        const userIconWrap = document.getElementById('nav-user-icon-wrap');
        if (!userBtn || !userIconWrap) return;

        let userPhone = '';
        let userName = '';
        try {
            userPhone = localStorage.getItem('kurukoo_user_phone') || '';
            userName = localStorage.getItem('kurukoo_user_name') || '';
        } catch (err) {}

        if (userPhone) {
            userBtn.classList.add('is-logged-in');
            userBtn.classList.remove('is-logged-out');
            userBtn.setAttribute('title', `Logged in as ${userName || userPhone} — Click to view profile`);
            userBtn.setAttribute('href', '/dashboard.html');

            userIconWrap.innerHTML = `
                <svg class="nav-user-svg logged-in-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    <circle cx="19" cy="5" r="3.5" fill="#25D366" stroke="#ffffff" stroke-width="1.5"/>
                </svg>
            `;
        } else {
            userBtn.classList.add('is-logged-out');
            userBtn.classList.remove('is-logged-in');
            userBtn.setAttribute('title', 'Sign In or Register');
            userBtn.setAttribute('href', '/login');

            userIconWrap.innerHTML = `
                <svg class="nav-user-svg logged-out-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            `;
        }
    }

    // Direct Mobile Menu Toggle & Accordion Script
    const mobileToggleBtn = document.getElementById('mobile-toggle-btn');
    const mainNavLinks = document.getElementById('main-nav-links');
    const mobileNavOverlay = document.getElementById('mobile-nav-overlay');

    function openMobileNav() {
        if (!mainNavLinks || !mobileToggleBtn) return;
        mainNavLinks.classList.add('active');
        mobileToggleBtn.classList.add('active');
        mobileToggleBtn.setAttribute('aria-expanded', 'true');
        const icon = mobileToggleBtn.querySelector('.mobile-toggle-icon');
        if (icon) icon.textContent = '✕';
        if (mobileNavOverlay) mobileNavOverlay.classList.add('active');
        document.body.classList.add('mobile-nav-open');
    }

    function closeMobileNav() {
        if (!mainNavLinks || !mobileToggleBtn) return;
        mainNavLinks.classList.remove('active');
        mobileToggleBtn.classList.remove('active');
        mobileToggleBtn.setAttribute('aria-expanded', 'false');
        const icon = mobileToggleBtn.querySelector('.mobile-toggle-icon');
        if (icon) icon.textContent = '☰';
        if (mobileNavOverlay) mobileNavOverlay.classList.remove('active');
        document.body.classList.remove('mobile-nav-open');
    }

    if (mobileToggleBtn) {
        mobileToggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (mainNavLinks && mainNavLinks.classList.contains('active')) {
                closeMobileNav();
            } else {
                openMobileNav();
            }
        });
    }

    if (mobileNavOverlay) {
        mobileNavOverlay.addEventListener('click', () => {
            closeMobileNav();
        });
    }

    // Mobile Accordion toggles for dropdown items
    const dropdownToggles = document.querySelectorAll('.nav-link-dropdown-toggle');
    dropdownToggles.forEach(toggle => {
        toggle.addEventListener('click', (e) => {
            if (window.innerWidth <= 992) {
                e.preventDefault();
                e.stopPropagation();
                const container = toggle.closest('.nav-dropdown-container');
                if (container) {
                    const isOpen = container.classList.contains('accordion-open');
                    document.querySelectorAll('.nav-dropdown-container').forEach(c => {
                        c.classList.remove('accordion-open');
                    });
                    if (!isOpen) {
                        container.classList.add('accordion-open');
                    }
                }
            }
        });
    });

    // Close mobile menu on direct link click
    if (mainNavLinks) {
        mainNavLinks.querySelectorAll('a:not(.dropdown-toggle)').forEach(link => {
            link.addEventListener('click', () => {
                if (window.innerWidth <= 992) {
                    closeMobileNav();
                }
            });
        });
    }

    // ESC key listener
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeMobileNav();
        }
    });

    window.addEventListener('resize', () => {
        if (window.innerWidth > 992) {
            closeMobileNav();
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        updateNavUserUI();
    });
</script>
