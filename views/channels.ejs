<%- include('_partials/head', { pageStyles: ['/css/kurukoo-public-pages.css?v=4','/css/kurukoo-channel-page.css?v=4'] }) %>
<%- include('_partials/nav') %>
<%
  const integrations = Array.isArray(integrationReadiness) ? integrationReadiness : [];
  const byId = (id) => integrations.find((item) => item.id === id);
  const sourceIntegrations = integrations.filter((item) => item.category === 'sources');
  const channelIntegrations = integrations.filter((item) => item.category === 'channels');
  const externalIntegrations = integrations.filter((item) => !['sources', 'channels'].includes(item.category));
  const readinessLabel = (item) => item ? String(item.uiState || 'CREDENTIALS_REQUIRED').replaceAll('_', ' ') : 'Not registered';
  const stateClass = (item) => item?.uiState === 'PRODUCTION_ACTIVE' ? 'available' : 'gated';
  const actionFor = (item) => {
    if (!item || item.uiState === 'NOT_IMPLEMENTED') return null;
    if (['google_drive', 'google_sheets', 'notion', 'outlook', 'onedrive'].includes(item.id)) return { href: '/login?return=%2Fconnect', label: 'Connect in workspace' };
    if (['whatsapp', 'telegram'].includes(item.id)) return { href: '/login?return=%2Fconnect', label: 'View connection settings' };
    return { href: '/help', label: 'View activation checklist' };
  };
  const iconFor = (id) => ({ google_drive: 'document', google_sheets: 'list', notion: 'note', outlook: 'mail', onedrive: 'folder' }[id] || 'settings');
  const dimensionLabel = (key) => key.replaceAll('_', ' ').toLowerCase().replace(/\b\w/g, (character) => character.toUpperCase());
%>
<main class="container page-container frontend-channel-page" aria-labelledby="channels-title">
  <section class="page-header-center frontend-channel-page__header"><span class="badge-pill">Channels &amp; connections</span><h1 id="channels-title" class="page-title">One Kurukoo relationship, different access points.</h1><p class="page-desc">Every external connection has an explicit lifecycle. Kurukoo distinguishes what is implemented and contract-tested from what has credentials, independently verified provider evidence, an enabled feature flag, and production activation.</p></section>

  <section class="channel-group" aria-labelledby="kurukoo-channels-title">
    <h2 id="kurukoo-channels-title" class="channel-group-title">Kurukoo communication channels</h2>
    <p class="channel-note">Web Chat remains available now. Each other channel is shown with its actual repository and activation state; configuration alone never means that an external message was delivered.</p>
    <div class="channel-cards">
      <article class="channel-card available"><div class="channel-icon">W</div><span class="channel-state active">IMPLEMENTED</span><h3>Web Chat</h3><p>Start a conversation, review request details, manage reminders and continue protected actions when identity is required.</p><a href="/chat" class="btn btn-primary btn-sm">Start chatting</a></article>
      <% channelIntegrations.forEach((item) => { const action = actionFor(item); %>
        <article id="<%= item.id %>" class="channel-card <%= stateClass(item) %>"><div class="channel-icon"><%= ({ whatsapp: 'WA', telegram: 'TG', sms: 'SMS', ussd: 'US', email: 'EM', fcm: 'FC', voice: 'VO' }[item.id] || 'EX') %></div><span class="channel-state <%= item.uiState === 'PRODUCTION_ACTIVE' ? 'active' : '' %>"><%= readinessLabel(item) %></span><h3><%= item.name %></h3><p><%= item.summary %></p><div class="channel-setup"><strong>Recovery</strong> <%= item.recovery %></div><% if (action) { %><a href="<%= action.href %>" class="btn btn-outline btn-sm"><%= action.label %></a><% } else { %><span class="channel-no-action">Adapter not registered yet</span><% } %></article>
      <% }) %>
      <article id="ai-assistants" class="channel-card <%= stateClass(byId('mcp')) %>"><div class="channel-icon">AI</div><span class="channel-state <%= byId('mcp')?.uiState === 'PRODUCTION_ACTIVE' ? 'active' : '' %>"><%= readinessLabel(byId('mcp')) %></span><h3>AI assistants</h3><p><%= byId('mcp')?.summary || 'The MCP app boundary is not registered.' %></p><div class="channel-setup"><strong>One Kurukoo MCP endpoint</strong> Compatible clients may use their own remote-MCP/custom-app connection without sharing passwords or subscriptions with Kurukoo.</div><a href="/connect#ai-assistants" class="btn btn-outline btn-sm">View connection settings</a></article>
    </div>
  </section>

  <section class="channel-group frontend-channel-page__sources" aria-labelledby="source-connections-title">
    <h2 id="source-connections-title" class="channel-group-title">Connected sources</h2>
    <p class="channel-note">Sources are owner-controlled information connections, not communication channels or provider claims. Unregistered sources do not display a misleading connect action.</p>
    <div class="frontend-channel-page__cards" aria-label="Source connections">
      <% sourceIntegrations.forEach((item) => { const action = actionFor(item); %>
        <article class="frontend-channel-card frontend-channel-card--<%= item.uiState.toLowerCase() %>"><div class="frontend-channel-card__icon frontend-channel-card__icon--<%= item.id %>"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#<%= iconFor(item.id) %>"></use></svg></div><h3><%= item.name %></h3><p><%= item.summary %></p><span class="frontend-channel-card__state"><%= readinessLabel(item) %></span><small><%= item.canonicalBoundary %></small><% if (action) { %><a class="btn btn-outline" href="<%= action.href %>"><%= action.label %></a><% } else { %><span class="channel-no-action">No adapter registered</span><% } %></article>
      <% }) %>
    </div>
  </section>

  <section class="frontend-provider-readiness" aria-labelledby="provider-readiness-title">
    <div class="frontend-provider-readiness__heading"><div><span class="eyebrow">External integration matrix</span><h2 id="provider-readiness-title">Completion and activation are different facts.</h2><p>Each card exposes the exact repository contract. Live verification and production activation remain false until independent provider evidence is captured through the canonical boundary.</p></div><a class="btn btn-outline" href="/help">View setup guidance</a></div>
    <div class="frontend-provider-readiness__grid">
      <% externalIntegrations.forEach((item) => { const action = actionFor(item); %>
        <article class="frontend-provider-state frontend-provider-state--<%= stateClass(item) %>"><div class="frontend-provider-state__top"><h3><%= item.name %></h3><span class="frontend-provider-state__pill"><%= readinessLabel(item) %></span></div><p><%= item.summary %></p><small><strong>Canonical boundary:</strong> <%= item.canonicalBoundary %></small><dl class="frontend-provider-state__dimensions"><% Object.entries(item.readiness).forEach(([key, value]) => { %><div><dt><%= dimensionLabel(key) %></dt><dd class="<%= value === true || value === 'ENABLED' ? 'yes' : 'no' %>"><%= String(value).replaceAll('_', ' ') %></dd></div><% }) %></dl><details class="frontend-provider-state__details"><summary>Activation and recovery</summary><p><strong>Recovery:</strong> <%= item.recovery %></p><ol><% item.activationChecklist.forEach((step) => { %><li><%= step %></li><% }) %></ol></details><% if (action) { %><a class="frontend-provider-state__action" href="<%= action.href %>"><%= action.label %></a><% } %></article>
      <% }) %>
    </div>
  </section>

  <aside class="frontend-channel-readiness"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#info"></use></svg><div><strong>Connection readiness</strong><p>Credential-ready is not live-verified. Kurukoo enables a provider only after an authorized flag change and controlled evidence of the actual external lifecycle.</p></div><a class="btn btn-outline" href="/help">Learn more</a></aside>
</main>
<%- include('_partials/footer') %>
