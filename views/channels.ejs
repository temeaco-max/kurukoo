<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container page-container">
    <section class="section-heading" style="text-align: center; max-width: 800px; margin: 0 auto 60px;">
        <span class="eyebrow">One Kurukoo. Multiple ways to reach it.</span>
        <h1 style="font-size: 3rem; margin: 16px 0;">Connected Everywhere</h1>
        <p class="lead" style="font-size: 1.25rem; color: var(--gray-600);">Kurukoo lives where you are. Your Memory Profile and Economic Requests follow you across every channel.</p>
    </section>

    <div class="channel-group">
        <h2 class="channel-group-title">Available</h2>
        <div class="channel-cards">
            <article class="channel-card channel-card--available">
                <div class="channel-icon" aria-hidden="true">🌐</div>
                <span class="item-badge active" style="margin-bottom: 12px; display: inline-block;">Live & Connected</span>
                <h3>Web Chat</h3>
                <p>Use the full conversation experience in your browser to describe a need, review matching details, and take protected actions when identity is required.</p>
                <a href="/chat" class="btn btn-primary btn-sm">Open Web Chat</a>
            </article>
        </div>
    </div>

    <div class="channel-group">
        <h2 class="channel-group-title">Not connected in this deployment</h2>
        <p class="channel-note">These routes are intentionally unavailable here because no corresponding messaging or carrier adapter is configured. Use Web Chat instead; it is the source of truth for your conversation.</p>
        <div class="channel-cards">
            <article class="channel-card channel-card--unavailable">
                <div class="channel-icon" aria-hidden="true">💬</div>
                <span class="item-badge" style="margin-bottom: 12px; display: inline-block;">Coming Soon</span>
                <h3>WhatsApp</h3>
                <p>WhatsApp messaging is not connected for this deployment. No WhatsApp link is shown so a request cannot be sent to an unconfigured service.</p>
                <a href="/chat" class="btn btn-outline btn-sm">Use Web Chat</a>
            </article>
            <article class="channel-card channel-card--unavailable">
                <div class="channel-icon" aria-hidden="true">🔢</div>
                <span class="item-badge" style="margin-bottom: 12px; display: inline-block;">Not Configured</span>
                <h3>USSD</h3>
                <p>USSD is not connected for this deployment. Use Web Chat while a verified carrier integration is unavailable.</p>
                <a href="/chat" class="btn btn-outline btn-sm">Use Web Chat</a>
            </article>
            <article class="channel-card channel-card--unavailable">
                <div class="channel-icon" aria-hidden="true">📱</div>
                <span class="item-badge" style="margin-bottom: 12px; display: inline-block;">Coming Soon</span>
                <h3>SMS</h3>
                <p>SMS is not connected for this deployment. Use Web Chat for request updates and account access.</p>
                <a href="/chat" class="btn btn-outline btn-sm">Use Web Chat</a>
            </article>
        </div>
    </div>
</main>

<style>
.channel-group { margin-bottom: 60px; }
.channel-group-title { margin-bottom: 20px; font-size: 1.5rem; border-bottom: 2px solid var(--terracotta); display: inline-block; padding-bottom: 8px; }
.channel-note { max-width: 760px; margin: 0 0 24px; color: var(--gray-600); line-height: 1.6; }
.channel-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
.channel-card { padding: 30px; background: var(--white); border: 1px solid var(--gray-200); border-radius: var(--border-radius); display: flex; flex-direction: column; }
.channel-card--available { border-top: 3px solid var(--terracotta); }
.channel-card--unavailable { background: var(--gray-50); }
.channel-icon { font: 700 2rem/1 var(--font-heading, system-ui); margin-bottom: 18px; color: var(--terracotta); }
.channel-card h3 { margin-bottom: 12px; }
.channel-card p { margin-bottom: 24px; color: var(--gray-600); flex: 1; line-height: 1.6; }
</style>

<%- include('_partials/footer') %>
