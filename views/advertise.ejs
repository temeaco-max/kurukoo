<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container advertise-main">
    <section class="advertise-hero">
        <div class="category-badge-pill">
            Advertise
        </div>
        <h1 class="advertise-title">
            Reach customers where they chat
        </h1>
        <p class="advertise-desc">
            Promote your business on the platform millions use for everyday life — in the weekly generosity, Nearby Radar, Explore, and Daily Picks.
        </p>
    </section>

    <div class="placements-card">
        <h2 class="section-h2">Placement options</h2>
        <div class="placements-grid">
            <div class="placement-box">
                <h3 class="placement-box-title">Nearby Radar pins</h3>
                <p class="placement-box-desc">Featured pin on the live map so customers near you find you instantly.</p>
            </div>
            <div class="placement-box">
                <h3 class="placement-box-title">Daily Picks</h3>
                <p class="placement-box-desc">Sponsored card in the Daily Picks carousel, seen by engaged users each day.</p>
            </div>
            <div class="placement-box">
                <h3 class="placement-box-title">Explore category boost</h3>
                <p class="placement-box-desc">Appear at the top of relevant Explore categories with a Sponsored label.</p>
            </div>
        </div>
    </div>

    <div class="advertise-cta-box">
        <h2 class="section-h2">Ready to advertise?</h2>
        <p class="advertise-desc">Self-service advertising is not available in this deployment. You can use Web Chat to describe a proposed placement or partnership.</p>
        <a href="/chat?prompt=I%20want%20to%20discuss%20advertising%20or%20a%20partnership" class="btn advertise-cta-btn">Discuss in Web Chat</a>
    </div>
</main>

<%- include('_partials/footer') %>
