<%- include('_partials/head') %>
<%- include('_partials/nav') %>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<main class="container page-container">
  <section class="page-header-center">
    <span class="badge-pill">Discover · Nearby Radar</span>
    <h1 class="page-title">Nearby providers, when they choose to go live</h1>
    <p class="page-desc">Nearby Radar shows only approximate, time-bounded presence for evidence-verified mobile and stationary providers. It is not a dispatch, emergency, or external broadcast service.</p>
  </section>

  <div class="discover-controls">
    <button id="use-my-location" class="btn btn-primary" type="button">Use my location</button>
  </div>
  <p id="discover-status" class="discover-status" role="status" aria-live="polite"></p>

  <div id="layer-chips" class="layer-chips-bar" aria-label="Nearby Radar layers">
    <button class="layer-chip active" type="button" data-layer="mobile" aria-pressed="true">Mobile providers</button>
    <button class="layer-chip active" type="button" data-layer="stationary" aria-pressed="true">Stationary providers</button>
    <button class="layer-chip is-unavailable" type="button" disabled aria-disabled="true" title="Live geographic agent presence is not configured.">AI agents unavailable</button>
    <button class="layer-chip is-unavailable" type="button" disabled aria-disabled="true" title="Kurukoo does not provide a live emergency-service location feed.">Emergency unavailable</button>
    <button class="layer-chip is-unavailable" type="button" disabled aria-disabled="true" title="No verified live deal-location source is configured.">Deals unavailable</button>
    <button class="layer-chip is-unavailable" type="button" disabled aria-disabled="true" title="No verified live event-location source is configured.">Events unavailable</button>
  </div>

  <div class="discover-layout">
    <aside class="discover-sidebar" aria-label="Nearby activity">
      <h2 class="discover-sidebar-title">Happening nearby</h2>
      <div id="discover-list" class="discover-list-box">
        <div class="muted-info-text">Choose “Use my location” to load approximate nearby presence.</div>
      </div>
    </aside>
    <div id="discover-map" class="discover-map-box" aria-label="Map of approximate nearby provider presence"></div>
  </div>

  <p class="discover-disclaimer">Privacy: provider coordinates are deliberately fuzzed to about 100 metres. Exact coordinates and contact details are not published by Nearby Radar.</p>
</main>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/discover.js" defer></script>
<%- include('_partials/footer') %>
