<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= workspaceTitle %> · Kurukoo</title>
  <meta name="description" content="<%= workspaceDescription %>">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=8">
  <link rel="stylesheet" href="/css/kurukoo-chat.css?v=14">
</head>
<body class="workspace-page" data-workspace-section="<%= workspaceSection %>" data-workspace-fixture="<%= visualQaFixture || '' %>">
  <% const icon = (name) => `<svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; %>
  <div class="workspace-shell chat-template-shell">
    <aside class="workspace-sidebar" id="workspace-sidebar">
      <div class="workspace-brand-row">
        <a href="/chat" class="workspace-brand"><img src="/assets/brand/logo-icon.png" alt="Kurukoo" width="34" height="34"><span>Kurukoo</span></a>
        <button id="workspace-collapse" class="workspace-icon-button" type="button" aria-label="Collapse sidebar">‹</button>
      </div>
      <a href="/chat" class="workspace-new"><span aria-hidden="true">＋</span> New conversation</a>
      <nav class="workspace-nav" aria-label="Workspace">
        <a href="/chat"><span class="workspace-nav-icon"><%- icon('chat') %></span><span>Conversation</span></a>
        <a class="<%= workspaceSection === 'requests' ? 'active' : '' %>" href="/requests"><span class="workspace-nav-icon"><%- icon('request') %></span><span>Requests</span></a>
        <a class="<%= workspaceSection === 'reminders' ? 'active' : '' %>" href="/reminders"><span class="workspace-nav-icon"><%- icon('reminder') %></span><span>Reminders</span></a>
        <a class="<%= workspaceSection === 'saved' ? 'active' : '' %>" href="/saved"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Saved &amp; offers</span></a>
        <a class="<%= workspaceSection === 'cart' ? 'active' : '' %>" href="/cart"><span class="workspace-nav-icon"><%- icon('package') %></span><span>Cart</span></a>
        <button class="workspace-nav-more" id="workspace-more" type="button" aria-expanded="false" aria-controls="workspace-more-items"><span class="workspace-nav-icon"><%- icon('more') %></span><span>More</span></button>
        <div class="workspace-nav-more-items" id="workspace-more-items" hidden>
          <a class="<%= workspaceSection === 'points' ? 'active' : '' %>" href="/points"><span class="workspace-nav-icon"><%- icon('points') %></span><span>Points</span></a><a class="<%= workspaceSection === 'topup' ? 'active' : '' %>" href="/top-up"><span class="workspace-nav-icon"><%- icon('points') %></span><span>Top up</span></a><a class="<%= workspaceSection === 'subscription' ? 'active' : '' %>" href="/subscriptions"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Subscription</span></a>
          <a class="<%= workspaceSection === 'tasks' ? 'active' : '' %>" href="/tasks"><span class="workspace-nav-icon"><%- icon('work') %></span><span>Tasks</span></a><a class="<%= workspaceSection === 'connect' ? 'active' : '' %>" href="/connect"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Connect</span></a>
          <a href="/discover"><span class="workspace-nav-icon"><%- icon('discover') %></span><span>Discover</span></a>
        </div>
      </nav>
      <div class="workspace-sidebar-spacer"></div>
      <nav class="workspace-nav workspace-nav-secondary" aria-label="Account">
        <a class="<%= workspaceSection === 'memory' ? 'active' : '' %>" href="/memory"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Memory</span></a>
        <a class="<%= workspaceSection === 'safety' ? 'active' : '' %>" href="/safety"><span class="workspace-nav-icon"><%- icon('safety') %></span><span>Safety</span></a>
        <a class="<%= workspaceSection === 'call' ? 'active' : '' %>" href="/call"><span class="workspace-nav-icon"><%- icon('mic') %></span><span>Call</span></a>
        <a class="<%= workspaceSection === 'settings' ? 'active' : '' %>" href="/settings"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Settings</span></a>
        <a href="/help"><span class="workspace-nav-icon"><%- icon('help') %></span><span>Help</span></a>
        <button type="button" id="workspace-logout" class="workspace-nav-button"><span class="workspace-nav-icon"><%- icon('logout') %></span><span>Sign out</span></button>
      </nav>
      <div class="workspace-account"><div class="workspace-avatar"><%= (displayName || 'K').slice(0,1).toUpperCase() %></div><div><strong><%= displayName || 'Your Kurukoo account' %></strong><small><%= phone || 'Signed in' %></small></div></div>
    </aside>

    <main class="workspace-main">
      <header class="workspace-header">
        <div class="workspace-header-copy"><a class="workspace-back" href="/chat"><%- icon('chevron-left') %><span>Back to conversation</span></a><span class="workspace-kicker">Your Kurukoo</span><h1><%= workspaceTitle %></h1><p><%= workspaceDescription %></p></div>
        <div class="workspace-header-actions"><a class="workspace-button secondary ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.png" alt="" aria-hidden="true"></span><span>Ask</span></a><button class="workspace-icon-button workspace-mobile-only" id="workspace-open" type="button" aria-label="Open workspace navigation"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#menu"></use></svg></button></div>
      </header>
      <div class="workspace-content">
        <% if (workspaceSection === 'requests') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Request timeline</span><h2>Keep every request in one place.</h2><p>Conversation stays the source of truth. This workspace mirrors each canonical request state without creating a second lifecycle.</p></div><a class="workspace-button" href="/chat">Start a new request</a></section>
          <div class="workspace-grid three">
            <article class="metric-card"><span>Open requests</span><strong data-request-metric="open">—</strong><small>Requests that are still being coordinated.</small></article>
            <article class="metric-card"><span>Waiting on you</span><strong data-request-metric="action">—</strong><small>Confirmations, details or decisions needed to continue.</small></article>
            <article class="metric-card"><span>Completed</span><strong data-request-metric="completed">—</strong><small>Finished requests remain connected to their conversations.</small></article>
          </div>
          <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Fulfilment timeline</span><h2>Your requests</h2></div><span class="status-pill">Live request data</span></div><div class="workspace-data-list" data-requests-list aria-live="polite"></div><div class="empty-workspace" data-requests-empty><div class="empty-icon"><%- icon('request') %></div><h3>No requests yet</h3><p>Tell Kurukoo what you need. A request appears here when it is created through conversation.</p><a class="workspace-text-action ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.png" alt="" aria-hidden="true"></span><span>Ask</span></a></div></section>

        <% } else if (workspaceSection === 'reminders') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Remember the things that matter</span><h2>Reminders that live with your conversations.</h2><p>Create one here or simply tell Kurukoo, “Remind me to renew my MOT in September.”</p></div><a class="workspace-button" href="/chat?prompt=Create%20a%20reminder">Create reminder</a></section>
          <div class="workspace-tabs" aria-label="Reminder views"><button class="active" type="button">Upcoming</button><button type="button" disabled>Today</button><button type="button" disabled>Completed</button><button type="button" disabled>Snoozed</button></div>
          <section class="workspace-panel"><div class="workspace-data-list" data-reminders-list aria-live="polite"></div><div class="empty-workspace" data-reminders-empty><div class="empty-icon"><%- icon('reminder') %></div><h3>No upcoming reminders</h3><p>Your reminder service is connected to this workspace. New reminders will appear here with their schedule and next action.</p><a href="/chat?prompt=Create%20a%20reminder">Ask Kurukoo to remind me</a></div></section>

        <% } else if (workspaceSection === 'saved') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Saved &amp; offers</span><h2>Keep useful options close.</h2><p>Saved things can include offers, providers and request context. Availability and prices are always shown with their truthful state.</p></div><a class="workspace-button" href="/chat">Find something</a></section>
          <section class="workspace-panel"><div class="empty-workspace"><div class="empty-icon"><%- icon('saved') %></div><h3>Nothing saved yet</h3><p>When Kurukoo shows you a useful option, save it from the conversation and it will appear here.</p></div></section>

        <% } else if (workspaceSection === 'cart') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Cart</span><h2>Review items before you request them.</h2><p>Cart is a visual workspace for sourced products. It does not imply inventory, a confirmed quote or a separate payment flow.</p></div><a class="workspace-button" href="/chat">Source something</a></section>
          <% if (visualQaFixture === 'populated') { %>
          <section class="workspace-panel cart-panel" data-cart-live><div class="workspace-data-list"><article class="workspace-data-card"><div class="panel-heading"><div><span class="workspace-eyebrow">Review item</span><h3>Client meeting prep pack</h3></div><span class="status-pill">1 item</span></div><p>Key risks, decisions and draft agenda for the May 20 meeting.</p><div class="workspace-data-card-footer"><span class="status-pill">Source-attributed</span><span class="status-pill">Qty 1</span></div></article><article class="workspace-data-card"><div class="workspace-data-card-footer"><span>Seller</span><strong>Alex Morgan</strong></div><div class="workspace-data-card-footer"><span>Source</span><strong>Kurukoo Network</strong></div><div class="workspace-data-card-footer"><span>Provider type</span><strong>Independent expert</strong></div><div class="workspace-data-card-footer"><span>Location</span><strong>San Francisco, CA</strong></div><div class="workspace-data-card-footer"><span>Response time</span><strong>Within 2 hours</strong></div><div class="workspace-data-card-footer"><span>Completion rate</span><strong>98%</strong></div></article><div class="workspace-notice">This is a request, not an automatic purchase. Price and delivery remain pending until the relevant provider confirms them.</div></div><div class="cart-summary"><span>Price</span><strong>Price pending confirmation</strong><small>Final price will be confirmed by the seller. No payment has been taken.</small><span>Delivery</span><strong>Est. Tue, May 20</strong><small>Timing remains provisional until provider confirmation.</small><button type="button" class="workspace-button">Confirm request</button><button type="button" class="workspace-button secondary">Cancel</button></div></section>
          <% } else { %>
          <section class="workspace-panel cart-panel" data-cart-live><div class="empty-workspace"><div class="empty-icon"><%- icon('package') %></div><h3>Your cart is empty</h3><p>When Kurukoo identifies a product you can request, it can be added here for review.</p></div><div class="cart-summary"><span>Subtotal</span><strong>Not calculated</strong><small>Confirmed prices appear only after the relevant provider confirms a quote.</small><button type="button" class="workspace-button" disabled>Continue</button></div></section>
          <% } %>

        <% } else if (workspaceSection === 'confirmation') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Clear outcome</span><h2>Review and continue with confidence.</h2><p>Kurukoo keeps the action, evidence and next step connected to the originating conversation. External provider or payment states remain pending until evidence confirms them.</p></div><a class="workspace-button" href="/chat">Continue in Chat</a></section>
          <section data-confirmation-live>
          <% if (visualQaFixture === 'populated') { %>
          <div class="workspace-grid three"><article class="metric-card"><span>Internal state</span><strong>Accepted internally</strong><small>Kurukoo recorded the request and preserved its originating Chat context.</small></article><article class="metric-card"><span>Provider state</span><strong>Pending confirmation</strong><small>Alex Morgan still needs to confirm availability, final price and delivery.</small></article><article class="metric-card"><span>Payment status</span><strong>Not completed</strong><small>No payment has been taken. Review the final quote before approving any supported payment boundary.</small></article></div>
          <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Review request</span><h2>Client meeting prep pack</h2></div><span class="status-pill">Request sent</span></div><div class="workspace-data-list"><article class="workspace-data-card"><div class="workspace-data-card-footer"><span>Item</span><strong>Client meeting prep pack</strong></div><div class="workspace-data-card-footer"><span>Qty</span><strong>1</strong></div><div class="workspace-data-card-footer"><span>Seller</span><strong>Alex Morgan · Verified</strong></div><div class="workspace-data-card-footer"><span>Source</span><strong>Kurukoo Network</strong></div><div class="workspace-data-card-footer"><span>Price</span><strong>Pending confirmation</strong></div><div class="workspace-data-card-footer"><span>Delivery</span><strong>Est. Tue, May 20</strong></div></article><div class="workspace-notice">Sandbox/provider-dependent. Kurukoo facilitates the request; availability, pricing and delivery remain unconfirmed until evidence arrives.</div></div></section>
          <% } else { %>
          <div class="workspace-grid three"><article class="metric-card"><span>Internal state</span><strong>Accepted internally</strong><small>Kurukoo can record and queue an action without claiming external completion.</small></article><article class="metric-card"><span>Provider state</span><strong>Pending confirmation</strong><small>Availability, delivery and provider identifiers appear only when evidenced.</small></article><article class="metric-card"><span>Payment status</span><strong>Not completed</strong><small>No payment is taken merely by reviewing this confirmation surface.</small></article></div>
          <% } %>
          <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Request evidence</span><h2>What happens next</h2></div><span class="status-pill">Review required</span></div><div class="workspace-data-list"><article class="workspace-data-row"><div><strong>Accepted internally</strong><small>Kurukoo has prepared the next step and preserved the originating Chat context.</small></div><span class="status-pill">Recorded</span></article><article class="workspace-data-row"><div><strong>Waiting for provider confirmation</strong><small>External delivery, settlement or completion has not been claimed.</small></div><span class="status-pill">Pending</span></article><article class="workspace-data-row"><div><strong>Return to the exact conversation</strong><small>Review the request, ask a question or provide the missing confirmation in Chat.</small></div><a class="workspace-text-action" href="/chat">Continue in Chat</a></article></div></section>
          </section>

        <% } else if (workspaceSection === 'topup') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Balance actions</span><h2>Top up only when a verified payment path is available.</h2><p>Sandbox credits may be available for testing. Production top-ups require a configured payment provider and verified payment evidence.</p></div></section>
          <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Points and credits</span><h2>Choose what you want to review</h2></div><span class="status-pill">Payment-gated</span></div><div class="workspace-grid three"><article class="metric-card"><span>Points</span><strong>Current balance</strong><small>Review your Points balance before a supported top-up action.</small><a class="workspace-text-action" href="/points">Open Points</a></article><article class="metric-card"><span>Credits</span><strong>Deployment-dependent</strong><small>Credits are not presented as cash or guaranteed monetary value.</small><a class="workspace-text-action ask-cta" href="/chat?prompt=Help%20me%20review%20my%20credit%20balance">Ask Kurukoo</a></article><article class="metric-card"><span>Payment</span><strong>Verification required</strong><small>No payment is completed merely by opening this surface.</small><a class="workspace-text-action" href="/channels">Review connected channels</a></article></div></section>

        <% } else if (workspaceSection === 'subscription') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Subscription</span><h2>Review the plan that fits your Kurukoo use.</h2><p>Plan prices, credits and provider tiers are shown only when active pricing and a verified payment boundary are available.</p></div></section>
          <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Plan boundary</span><h2>Manage in Chat</h2></div><span class="status-pill">Payment-gated</span></div><div class="empty-workspace compact"><div class="empty-icon"><%- icon('settings') %></div><h3>No subscription change has been requested</h3><p>Tell Kurukoo whether you are reviewing a consumer plan or a provider tier. It will show the configured option and request the required payment reference before any change.</p><a class="workspace-text-action ask-cta" href="/chat?prompt=Help%20me%20review%20subscription%20options">Ask Kurukoo</a></div></section>

        <% } else if (workspaceSection === 'connect') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">One Kurukoo relationship</span><h2>Connect the channels and AI assistants you already use.</h2><p>Keep Web Chat as the source of truth. Other channels and compatible AI assistants use the same Kurukoo relationship rather than creating a second conversation.</p></div><a class="workspace-button" href="/channels#ai-assistants">AI connections</a></section>
          <div class="workspace-grid two linked-device-workspace-grid">
            <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">AI assistants</span><h2>One MCP connection</h2></div><span class="status-pill"><%= process.env.KURUKOO_MCP_ENABLED === 'true' ? 'READY' : 'NOT CONFIGURED' %></span></div><p>ChatGPT, Claude, Gemini, Grok, Copilot, Dola and other compatible clients can use the same MCP endpoint where their own product supports custom MCP/OAuth connections. Kurukoo does not collect another AI provider's password or subscription credentials.</p><a class="workspace-text-action" href="/channels#ai-assistants">View AI connection</a></section>
            <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Personal WhatsApp</span><h2>Linked device</h2></div><span class="status-pill">Owner-scoped</span></div><p class="channel-readiness-note">Provider readiness: <strong><%= channelStatuses?.whatsapp?.state || 'NOT_CONFIGURED' %></strong>.</p><p>Pair an existing WhatsApp account by scanning a live QR code. This is separate from a Meta Cloud API business number and stays disabled until you explicitly activate it.</p><a class="workspace-text-action" href="/whatsapp-linked-device">Open full pairing view</a></section>
            <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Pair here</span><h2>Scan from this workspace</h2></div><span class="status-pill">Local session</span></div><%- include('_partials/whatsapp-linked-device-panel') %></section>
            <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Personal Telegram</span><h2>Linked device</h2></div><span class="status-pill">MTProto session</span></div><p class="channel-readiness-note">Provider readiness: <strong><%= channelStatuses?.telegram?.state || 'NOT_CONFIGURED' %></strong>.</p><p>Pair a personal Telegram account with a real Telegram QR login. This is separate from the Telegram Bot API and remains unavailable until Telegram API credentials and owner activation are configured.</p><%- include('_partials/telegram-linked-device-panel') %></section>
            <section class="workspace-panel" data-artifact-history><div class="panel-heading"><div><span class="workspace-eyebrow">Your files</span><h2>Artifact history</h2></div><span class="status-pill" data-artifact-storage-state>Checking</span></div><p data-artifact-storage-copy>Artifacts are owned by your Kurukoo account. A connected Drive account is preferred; otherwise Kurukoo shows only its managed fallback state.</p><div class="workspace-data-list" data-artifact-list aria-live="polite"></div><div class="empty-workspace compact" data-artifact-empty><div class="empty-icon"><%- icon('saved') %></div><h3>No saved artifacts</h3><p>Saved voice recordings, images, videos and documents will appear here with their confirmed storage state.</p></div><div class="workspace-data-card-footer"><button class="workspace-text-action" type="button" data-artifact-connect>Connect Google Drive</button><small data-artifact-action-note></small></div></section>
            <section class="workspace-panel" data-google-sheets-source><div class="panel-heading"><div><span class="workspace-eyebrow">Your spreadsheet</span><h2>Google Sheets source</h2></div><span class="status-pill" data-sheets-state>Checking</span></div><p data-sheets-copy>Connect a spreadsheet you own to read a bounded range in this workspace. Kurukoo does not claim write access, background sync, or a successful source read without the provider response.</p><div class="workspace-source-form" data-sheets-form hidden><label>Spreadsheet ID<input type="text" autocomplete="off" spellcheck="false" data-sheets-id placeholder="Paste the Google Sheets ID"></label><label>A1 range<input type="text" autocomplete="off" spellcheck="false" data-sheets-range value="Sheet1!A1:Z100"></label><button class="workspace-button secondary" type="button" data-sheets-read>Read range</button></div><div class="workspace-data-list" data-sheets-results aria-live="polite"></div><div class="empty-workspace compact" data-sheets-empty><div class="empty-icon"><%- icon('list') %></div><h3>No range read yet</h3><p>When your active connection and a valid A1 range are confirmed, a bounded preview appears here. Spreadsheet values are not saved as a Kurukoo artifact.</p></div><div class="workspace-data-card-footer"><span><button class="workspace-text-action" type="button" data-sheets-connect>Connect Google Sheets</button><button class="workspace-text-action" type="button" data-sheets-revoke hidden>Revoke Google Sheets</button></span><small data-sheets-note></small></div></section>
            <section class="workspace-panel" data-notion-source><div class="panel-heading"><div><span class="workspace-eyebrow">Your shared pages</span><h2>Notion source</h2></div><span class="status-pill" data-notion-state>Checking</span></div><p data-notion-copy>Connect only pages you choose to share with Kurukoo’s Notion connection. Search previews are bounded and are not stored as Kurukoo artifacts or a background workspace mirror.</p><div class="workspace-source-form" data-notion-form hidden><label>Search shared page titles<input type="search" autocomplete="off" spellcheck="false" data-notion-query placeholder="Optional title search"></label><button class="workspace-button secondary" type="button" data-notion-search>Search shared pages</button></div><div class="workspace-data-list" data-notion-results aria-live="polite"></div><div class="empty-workspace compact" data-notion-empty><div class="empty-icon"><%- icon('note') %></div><h3>No shared page search yet</h3><p>After you connect and select pages in Notion, a bounded search can show the pages Notion confirms were shared.</p></div><div class="workspace-data-card-footer"><span><button class="workspace-text-action" type="button" data-notion-connect>Connect Notion</button><button class="workspace-text-action" type="button" data-notion-revoke hidden>Revoke Notion</button></span><small data-notion-note></small></div></section>
            <section class="workspace-panel" data-microsoft-source><div class="panel-heading"><div><span class="workspace-eyebrow">Your Microsoft account</span><h2>Outlook and OneDrive sources</h2></div><span class="status-pill" data-microsoft-state>Checking</span></div><p data-microsoft-copy>Connect only one read-only source at a time. Outlook lists basic message metadata without message bodies; OneDrive lists a bounded folder view without importing or syncing files.</p><div class="workspace-source-form"><label>Source<select data-microsoft-kind><option value="outlook">Outlook basic mailbox</option><option value="onedrive">OneDrive files</option></select></label><label>Optional mailbox title search<input type="search" autocomplete="off" spellcheck="false" data-microsoft-query placeholder="Outlook only"></label><button class="workspace-button secondary" type="button" data-microsoft-list>List confirmed items</button></div><div class="workspace-data-list" data-microsoft-results aria-live="polite"></div><div class="empty-workspace compact" data-microsoft-empty><div class="empty-icon"><%- icon('folder') %></div><h3>No Microsoft source list yet</h3><p>Connect a source, then request a bounded list. Kurukoo does not save source content as an artifact or run a background sync.</p></div><div class="workspace-data-card-footer"><span><button class="workspace-text-action" type="button" data-microsoft-connect>Connect selected source</button><button class="workspace-text-action" type="button" data-microsoft-revoke hidden>Remove selected connection</button></span><small data-microsoft-note></small></div></section>
          </div>
        <% } else if (workspaceSection === 'points') { %>
          <div class="workspace-grid two"><article class="balance-card"><span>Your Points balance</span><strong data-points-balance>—</strong><small data-points-tier>Loading current availability.</small></article><article class="workspace-panel compact"><span class="workspace-eyebrow">About Points</span><h2>How Points work</h2><p>Points may support contribution, rewards or other approved flows. They are not presented as cash or a guaranteed monetary value.</p><a href="/resources/points">Learn more</a></article></div>
          <section class="workspace-panel"><div class="panel-heading"><h2>Recent Points activity</h2></div><div class="empty-workspace compact"><div class="empty-icon"><%- icon('points') %></div><h3>No Points activity</h3><p>Eligible activity will appear here when available for your deployment.</p></div></section>

        <% } else if (workspaceSection === 'tasks') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Contribute</span><h2>Small tasks can improve the network.</h2><p>Tasks may ask you to verify a location, update a price, confirm an incident or help onboard someone.</p></div></section>
          <div class="workspace-tabs" aria-label="Task views"><button class="active" type="button">Available</button><a href="/chat?prompt=Show%20me%20available%20tasks">My tasks in Chat</a><a href="/chat?prompt=Show%20my%20completed%20tasks">Completed in Chat</a></div>
          <div class="task-placeholder-grid"><article><span><%- icon('discover') %></span><h3>Verify a location</h3><p>Contributor tasks are claimed, submitted and reviewed through the canonical task authority.</p><a href="/chat?prompt=Show%20me%20available%20tasks">Open available tasks</a></article><article><span><%- icon('points') %></span><h3>Update a price</h3><p>Evidence is reviewed before the existing Points authority awards anything.</p><a href="/chat?prompt=Show%20me%20available%20tasks">Find a task</a></article><article><span><%- icon('safety') %></span><h3>Confirm an incident</h3><p>Safety-sensitive submissions remain review-gated and never create automatic claims.</p><a href="/chat?prompt=Show%20me%20available%20tasks">View task guidance</a></article></div><section class="workspace-panel tasks-activity-panel" data-tasks-activity aria-labelledby="tasks-activity-title"><div class="panel-heading"><div><span class="workspace-eyebrow">Community activity</span><h2 id="tasks-activity-title">Topics you may care about</h2></div><span class="status-pill" data-tasks-activity-status>Loading</span></div><div class="topics-activity-list" data-topics-activity aria-live="polite"><div class="empty-workspace compact"><p>Checking recent public Topics relevant to your area.</p></div></div></section>
        <% } else if (workspaceSection === 'daily-picks') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Daily Picks</span><h2>A calm place for useful suggestions.</h2><p>Recommendations can use available context, reminders and discovery data. Sponsored content is always labelled.</p></div><a class="workspace-button" href="/chat">Ask Kurukoo</a></section>
          <div class="workspace-grid two"><section class="workspace-panel"><span class="workspace-eyebrow">For you</span><h2>Personalised suggestions</h2><div class="suggestion-list" data-daily-picks><div><strong>Review an upcoming reminder</strong><small>Loading your connected reminder context.</small></div><div><strong>Continue a recent request</strong><small>Loading your request context.</small></div></div></section><section class="workspace-panel"><span class="workspace-eyebrow">Sponsored</span><h2>Public promotions</h2><p>Kurukoo promotions are clearly labelled and never interrupt an active conversation.</p><div class="workspace-promo-list"><% if (Array.isArray(ads) && ads.length) { %><% ads.forEach((ad) => { %><article class="workspace-promo-card"><div class="workspace-promo-media"><img src="<%= ad.imageUrl || '/assets/chat/campaign-food-vendor.webp' %>" alt="<%= ad.title || 'Kurukoo community promotion' %>" loading="lazy"><span class="workspace-promo-disclosure"><%= ad.disclosure || 'Sponsored' %></span></div><strong><%= ad.title %></strong><p><%= ad.desc %></p><a href="<%= ad.clickUrl || ad.destination || '/chat' %>" class="workspace-text-action"><%= ad.ctaText || 'Learn more' %></a></article><% }) %><% } else { %><span class="status-pill">No active promotion</span><% } %></div></section></div>

        <% } else if (workspaceSection === 'call') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Call Kurukoo</span><h2>Voice support uses the same Kurukoo relationship.</h2><p>The bounded voice interface is ready when the configured realtime provider is enabled. Text Chat remains available as the fallback.</p></div><a class="workspace-button" href="/chat?voice=1">Open voice entry</a></section><section class="workspace-panel"><div class="empty-workspace"><div class="empty-icon"><%- icon('mic') %></div><h3>Voice activation state</h3><p>Provider credentials, feature flag and runtime quota decide whether a live voice session can start. No separate account or request system is created.</p><a href="/channels#voice">View voice configuration boundary</a></div></section>

        <% } else if (workspaceSection === 'memory') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Living memory</span><h2>What Kurukoo knows about you.</h2><p>Review the useful preferences and context you have chosen to keep connected to your Kurukoo relationship.</p></div><a class="workspace-button secondary" href="/settings#privacy">Manage privacy</a></section>
          <div class="memory-grid"><article><span><%- icon('settings') %></span><h3>Preferences</h3><p>Your useful choices and preferences.</p><a href="/chat?prompt=Show%20my%20saved%20preferences">Review in Chat</a></article><article><span><%- icon('discover') %></span><h3>Locations</h3><p>Places you choose to make useful for future requests.</p><a href="/chat?prompt=Update%20my%20location">Update in Chat</a></article><article><span><%- icon('saved') %></span><h3>Saved providers</h3><p>Providers or businesses you have saved.</p><a href="/chat?prompt=Show%20my%20saved%20providers">Review in Chat</a></article><article><span><%- icon('reminder') %></span><h3>Reminder preferences</h3><p>How Kurukoo should handle reminders and follow-ups.</p><a href="/chat?prompt=Show%20my%20reminder%20preferences">Review in Chat</a></article></div><div class="workspace-notice">You stay in control. You can edit, forget or disable personalisation rather than exposing internal memory structures.</div>

        <% } else if (workspaceSection === 'safety') { %>
          <section class="workspace-hero-card safety-card"><div><span class="workspace-eyebrow">Safety &amp; urgent help</span><h2>Coordination support, not an emergency service.</h2><p>For immediate danger, contact your local emergency service. Kurukoo can help organise relevant information, contacts and configured services where available.</p></div><a class="workspace-button danger" href="/chat?prompt=I%20need%20urgent%20safety%20help">Get safety help</a></section>
          <div class="workspace-grid two"><section class="workspace-panel"><span class="workspace-eyebrow">Emergency contacts</span><h2>Your trusted contacts</h2><p>Contacts are activated only after your owner consent. Activating a contact does not send a notification.</p><a class="workspace-button secondary" href="/chat?prompt=Add%20an%20emergency%20contact">Add contact in chat</a><div class="workspace-data-list" data-safety-contacts aria-live="polite"></div><div class="empty-line" data-safety-contacts-empty>No contacts configured.</div></section><section class="workspace-panel"><span class="workspace-eyebrow">Check-ins</span><h2>Personal check-ins</h2><p>Set an instruction with Kurukoo through conversation. It does not replace emergency services.</p><a class="workspace-button" href="/chat?prompt=Set%20a%20safety%20check-in">Set a check-in</a><div class="workspace-data-list" data-safety-checkins aria-live="polite"></div><div class="empty-line" data-safety-checkins-empty>No active check-ins.</div></section></div>

        <% } else { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Account</span><h2>Make Kurukoo feel like yours.</h2><p>Manage your identity, notifications, reminders, privacy, memory, channels and sessions from one place.</p></div><a class="workspace-button ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.png" alt="" aria-hidden="true"></span><span>Ask</span></a></section>
          <div class="settings-grid"><a id="account" href="#account"><span>Account</span><strong>Name, phone and profile</strong><small>Keep your identity details current.</small></a><a id="notifications" href="#notifications"><span>Notifications</span><strong>Requests and reminders</strong><small>Choose what Kurukoo should notify you about.</small></a><a id="privacy" href="#privacy"><span>Privacy &amp; memory</span><strong>Personalisation controls</strong><small>Edit, forget or disable saved context.</small></a><a id="channels" href="/channels"><span>Connected channels</span><strong>Web is available</strong><small>Other channels are shown as not connected until configured.</small></a><a id="security" href="#security"><span>Security</span><strong>Sign-in and sessions</strong><small>Your phone is the canonical account identity.</small></a><a id="data" href="#data"><span>Your data</span><strong>Export or delete</strong><small>Review available account data controls.</small></a></div>
          <section class="workspace-panel settings-detail"><h2>Account controls</h2><p>Profile editing, notification preferences, channel connections, session management and data export remain protected account operations. This surface reflects available services without promising unavailable controls.</p><div class="settings-control-row"><span>Marketing recommendations</span><a href="/chat?prompt=Manage%20my%20recommendation%20preferences">Manage in Chat</a></div><div class="settings-control-row"><span>Location personalisation</span><a href="/chat?prompt=Manage%20my%20location%20preferences">Manage in Chat</a></div><div class="settings-control-row"><span>Delete account</span><a class="danger-outline" href="/chat?prompt=I%20want%20to%20delete%20my%20account">Request account deletion</a></div></section>
        <% } %>

        <% if (typeof ads === 'undefined' || !Array.isArray(ads) || !ads.length) { %><section class="workspace-promo"><div><span>Sponsored</span><strong>Local service promotion</strong><p>Advertisement placement preview. Sponsored content will never interrupt an active conversation.</p></div><em>No active promotion</em></section><% } %>
        <section class="workspace-proactive" data-proactive-card><span class="workspace-eyebrow">A quick question</span><h2>Was your recent request resolved?</h2><p>Proactive prompts are dismissible and only appear when relevant.</p><div><button type="button" data-proactive-response="yes">Yes</button><button type="button" data-proactive-response="not-yet">Not yet</button><button class="quiet" type="button" data-proactive-dismiss>Dismiss</button></div></section>
      </div>
    </main>
  </div>
  <script src="/js/kurukoo-workspace.js?v=5" defer></script>
</body>
</html>
