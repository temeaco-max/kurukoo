<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= workspaceTitle %> · Kurukoo</title>
  <meta name="description" content="<%= workspaceDescription %>">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=1.2.0">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=5">
</head>
<body class="workspace-page" data-workspace-section="<%= workspaceSection %>">
  <% const icon = (name) => `<svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; %>
  <div class="workspace-shell">
    <aside class="workspace-sidebar" id="workspace-sidebar">
      <div class="workspace-brand-row">
        <a href="/chat" class="workspace-brand"><img src="/assets/brand/logo-icon.svg" alt="Kurukoo" width="34" height="34"><span>Kurukoo</span></a>
        <button id="workspace-collapse" class="workspace-icon-button" type="button" aria-label="Collapse sidebar">‹</button>
      </div>
      <a href="/chat" class="workspace-new"><span aria-hidden="true">＋</span> New conversation</a>
      <nav class="workspace-nav" aria-label="Workspace">
        <a href="/chat"><span class="workspace-nav-icon"><%- icon('chat') %></span><span>Conversation</span></a>
        <a class="<%= workspaceSection === 'requests' ? 'active' : '' %>" href="/requests"><span class="workspace-nav-icon"><%- icon('request') %></span><span>Requests</span></a>
        <a class="<%= workspaceSection === 'reminders' ? 'active' : '' %>" href="/reminders"><span class="workspace-nav-icon"><%- icon('reminder') %></span><span>Reminders</span></a>
        <a class="<%= workspaceSection === 'saved' ? 'active' : '' %>" href="/saved"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Saved &amp; offers</span></a>
        <a class="<%= workspaceSection === 'cart' ? 'active' : '' %>" href="/cart"><span class="workspace-nav-icon"><%- icon('package') %></span><span>Cart</span></a>
        <a class="<%= workspaceSection === 'points' ? 'active' : '' %>" href="/points"><span class="workspace-nav-icon"><%- icon('points') %></span><span>Points</span></a>
        <a class="<%= workspaceSection === 'tasks' ? 'active' : '' %>" href="/tasks"><span class="workspace-nav-icon"><%- icon('work') %></span><span>Tasks</span></a>
        <a class="<%= workspaceSection === 'daily-picks' ? 'active' : '' %>" href="/daily-picks"><span class="workspace-nav-icon"><%- icon('discover') %></span><span>Daily Picks</span></a>
        <a href="/discover"><span class="workspace-nav-icon"><%- icon('discover') %></span><span>Discover</span></a>
      </nav>
      <div class="workspace-sidebar-spacer"></div>
      <nav class="workspace-nav workspace-nav-secondary" aria-label="Account">
        <a class="<%= workspaceSection === 'memory' ? 'active' : '' %>" href="/memory"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Memory</span></a>
        <a class="<%= workspaceSection === 'safety' ? 'active' : '' %>" href="/safety"><span class="workspace-nav-icon"><%- icon('safety') %></span><span>Safety</span></a>
        <a class="<%= workspaceSection === 'call' ? 'active' : '' %>" href="/call"><span class="workspace-nav-icon"><%- icon('mic') %></span><span>Call</span></a>
        <a class="<%= workspaceSection === 'settings' ? 'active' : '' %>" href="/settings"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Settings</span></a>
        <a href="/help"><span class="workspace-nav-icon"><%- icon('help') %></span><span>Help</span></a>
        <button id="workspace-logout" class="workspace-nav-button"><span class="workspace-nav-icon"><%- icon('logout') %></span><span>Sign out</span></button>
      </nav>
      <div class="workspace-account"><div class="workspace-avatar"><%= (displayName || 'K').slice(0,1).toUpperCase() %></div><div><strong><%= displayName || 'Your Kurukoo account' %></strong><small><%= phone || 'Signed in' %></small></div></div>
    </aside>

    <main class="workspace-main">
      <header class="workspace-header">
        <div><span class="workspace-kicker">Your Kurukoo</span><h1><%= workspaceTitle %></h1><p><%= workspaceDescription %></p></div>
        <div class="workspace-header-actions"><a class="workspace-button secondary" href="/chat">Start chatting</a><button class="workspace-icon-button workspace-mobile-only" id="workspace-open" type="button" aria-label="Open workspace navigation">☰</button></div>
      </header>
      <div class="workspace-content">
        <% if (workspaceSection === 'requests') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Request timeline</span><h2>Keep every request in one place.</h2><p>Conversation stays the source of truth. This workspace mirrors each canonical request state without creating a second lifecycle.</p></div><a class="workspace-button" href="/chat">Start a new request</a></section>
          <div class="workspace-grid three">
            <article class="metric-card"><span>Open requests</span><strong data-request-metric="open">—</strong><small>Requests that are still being coordinated.</small></article>
            <article class="metric-card"><span>Waiting on you</span><strong data-request-metric="action">—</strong><small>Confirmations, details or decisions needed to continue.</small></article>
            <article class="metric-card"><span>Completed</span><strong data-request-metric="completed">—</strong><small>Finished requests remain connected to their conversations.</small></article>
          </div>
          <section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Fulfilment timeline</span><h2>Your requests</h2></div><span class="status-pill">Live request data</span></div><div class="workspace-data-list" data-requests-list aria-live="polite"></div><div class="empty-workspace" data-requests-empty><div class="empty-icon"><%- icon('request') %></div><h3>No requests yet</h3><p>Tell Kurukoo what you need. A request appears here when it is created through conversation.</p><a href="/chat">Start chatting</a></div></section>

        <% } else if (workspaceSection === 'reminders') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Remember the things that matter</span><h2>Reminders that live with your conversations.</h2><p>Create one here or simply tell Kurukoo, “Remind me to renew my MOT in September.”</p></div><a class="workspace-button" href="/chat?prompt=Create%20a%20reminder">Create reminder</a></section>
          <div class="workspace-tabs" aria-label="Reminder views"><button class="active" type="button">Upcoming</button><button type="button" disabled>Today</button><button type="button" disabled>Completed</button><button type="button" disabled>Snoozed</button></div>
          <section class="workspace-panel"><div class="workspace-data-list" data-reminders-list aria-live="polite"></div><div class="empty-workspace" data-reminders-empty><div class="empty-icon"><%- icon('reminder') %></div><h3>No upcoming reminders</h3><p>Your reminder service is connected to this workspace. New reminders will appear here with their schedule and next action.</p><a href="/chat?prompt=Create%20a%20reminder">Ask Kurukoo to remind me</a></div></section>

        <% } else if (workspaceSection === 'saved') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Saved &amp; offers</span><h2>Keep useful options close.</h2><p>Saved things can include offers, providers and request context. Availability and prices are always shown with their truthful state.</p></div><a class="workspace-button" href="/chat">Find something</a></section>
          <section class="workspace-panel"><div class="empty-workspace"><div class="empty-icon"><%- icon('saved') %></div><h3>Nothing saved yet</h3><p>When Kurukoo shows you a useful option, save it from the conversation and it will appear here.</p></div></section>

        <% } else if (workspaceSection === 'cart') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Cart</span><h2>Review items before you request them.</h2><p>Cart is a visual workspace for sourced products. It does not imply inventory, a confirmed quote or a separate payment flow.</p></div><a class="workspace-button" href="/chat">Source something</a></section>
          <section class="workspace-panel cart-panel"><div class="empty-workspace"><div class="empty-icon"><%- icon('package') %></div><h3>Your cart is empty</h3><p>When Kurukoo identifies a product you can request, it can be added here for review.</p></div><div class="cart-summary"><span>Subtotal</span><strong>Not calculated</strong><small>Confirmed prices appear only after the relevant provider confirms a quote.</small><button class="workspace-button" disabled>Continue</button></div></section>

        <% } else if (workspaceSection === 'points') { %>
          <div class="workspace-grid two"><article class="balance-card"><span>Your Points balance</span><strong data-points-balance>—</strong><small data-points-tier>Loading current availability.</small></article><article class="workspace-panel compact"><span class="workspace-eyebrow">About Points</span><h2>How Points work</h2><p>Points may support contribution, rewards or other approved flows. They are not presented as cash or a guaranteed monetary value.</p><a href="/resources/points">Learn more</a></article></div>
          <section class="workspace-panel"><div class="panel-heading"><h2>Recent Points activity</h2></div><div class="empty-workspace compact"><div class="empty-icon"><%- icon('points') %></div><h3>No Points activity</h3><p>Eligible activity will appear here when available for your deployment.</p></div></section>

        <% } else if (workspaceSection === 'tasks') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Contribute</span><h2>Small tasks can improve the network.</h2><p>Tasks may ask you to verify a location, update a price, confirm an incident or help onboard someone.</p></div><a class="workspace-button" href="/chat?prompt=Show%20me%20available%20tasks">Find tasks</a></section>
          <div class="workspace-tabs" aria-label="Task views"><button class="active" type="button">Available</button><button type="button" disabled>My tasks</button><button type="button" disabled>Completed</button></div>
          <section class="workspace-panel"><div class="task-placeholder-grid"><article><span><%- icon('discover') %></span><h3>Verify a location</h3><p>Preview task. Activation depends on the contributor service.</p><em>Not yet available</em></article><article><span><%- icon('points') %></span><h3>Update a price</h3><p>Preview task. Submitted information would be reviewed.</p><em>Not yet available</em></article><article><span><%- icon('safety') %></span><h3>Confirm an incident</h3><p>Preview task. Safety-sensitive submissions require review.</p><em>Not yet available</em></article></div></section>

        <% } else if (workspaceSection === 'daily-picks') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Daily Picks</span><h2>A calm place for useful suggestions.</h2><p>Recommendations can use available context, reminders and discovery data. Sponsored content is always labelled.</p></div><a class="workspace-button" href="/chat">Ask Kurukoo</a></section>
          <div class="workspace-grid two"><section class="workspace-panel"><span class="workspace-eyebrow">For you</span><h2>Personalised suggestions</h2><div class="suggestion-list" data-daily-picks><div><strong>Review an upcoming reminder</strong><small>Loading your connected reminder context.</small></div><div><strong>Continue a recent request</strong><small>Loading your request context.</small></div></div></section><section class="workspace-panel"><span class="workspace-eyebrow">Sponsored</span><h2>Local promotion</h2><p>This is a controlled advertisement slot. The active advertising service decides what is eligible to show.</p><span class="status-pill">No active promotion</span></section></div>

        <% } else if (workspaceSection === 'call') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Call Kurukoo</span><h2>Voice support is designed as another way into the same relationship.</h2><p>The visual call surface is ready, but live calling is only available when the voice/call adapter is configured.</p></div><button class="workspace-button" disabled>Call unavailable</button></section><section class="workspace-panel"><div class="empty-workspace"><div class="empty-icon"><%- icon('mic') %></div><h3>Call surface preview</h3><p>Future calls can show connection state, mute, speaker, end call, request context and a return-to-chat action without creating a separate account or request system.</p></div></section>

        <% } else if (workspaceSection === 'memory') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Living memory</span><h2>What Kurukoo knows about you.</h2><p>Review the useful preferences and context you have chosen to keep connected to your Kurukoo relationship.</p></div><a class="workspace-button secondary" href="/settings#privacy">Manage privacy</a></section>
          <div class="memory-grid"><article><span><%- icon('settings') %></span><h3>Preferences</h3><p>Your useful choices and preferences.</p><button type="button" disabled>Not yet available</button></article><article><span><%- icon('discover') %></span><h3>Locations</h3><p>Places you choose to make useful for future requests.</p><button type="button" disabled>Not yet available</button></article><article><span><%- icon('saved') %></span><h3>Saved providers</h3><p>Providers or businesses you have saved.</p><button type="button" disabled>Not yet available</button></article><article><span><%- icon('reminder') %></span><h3>Reminder preferences</h3><p>How Kurukoo should handle reminders and follow-ups.</p><button type="button" disabled>Not yet available</button></article></div><div class="workspace-notice">You stay in control. You can edit, forget or disable personalisation rather than exposing internal memory structures.</div>

        <% } else if (workspaceSection === 'safety') { %>
          <section class="workspace-hero-card safety-card"><div><span class="workspace-eyebrow">Safety &amp; urgent help</span><h2>Coordination support, not an emergency service.</h2><p>For immediate danger, contact your local emergency service. Kurukoo can help organise relevant information, contacts and configured services where available.</p></div><a class="workspace-button danger" href="/chat?prompt=I%20need%20urgent%20safety%20help">Get safety help</a></section>
          <div class="workspace-grid two"><section class="workspace-panel"><span class="workspace-eyebrow">Emergency contacts</span><h2>Your trusted contacts</h2><p>Contacts are activated only after your owner consent. Activating a contact does not send a notification.</p><a class="workspace-button secondary" href="/chat?prompt=Add%20an%20emergency%20contact">Add contact in chat</a><div class="workspace-data-list" data-safety-contacts aria-live="polite"></div><div class="empty-line" data-safety-contacts-empty>No contacts configured.</div></section><section class="workspace-panel"><span class="workspace-eyebrow">Check-ins</span><h2>Personal check-ins</h2><p>Set an instruction with Kurukoo through conversation. It does not replace emergency services.</p><a class="workspace-button" href="/chat?prompt=Set%20a%20safety%20check-in">Set a check-in</a><div class="workspace-data-list" data-safety-checkins aria-live="polite"></div><div class="empty-line" data-safety-checkins-empty>No active check-ins.</div></section></div>

        <% } else { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Account</span><h2>Make Kurukoo feel like yours.</h2><p>Manage your identity, notifications, reminders, privacy, memory, channels and sessions from one place.</p></div><a class="workspace-button" href="/chat">Start chatting</a></section>
          <div class="settings-grid"><a id="account" href="#account"><span>Account</span><strong>Name, phone and profile</strong><small>Keep your identity details current.</small></a><a id="notifications" href="#notifications"><span>Notifications</span><strong>Requests and reminders</strong><small>Choose what Kurukoo should notify you about.</small></a><a id="privacy" href="#privacy"><span>Privacy &amp; memory</span><strong>Personalisation controls</strong><small>Edit, forget or disable saved context.</small></a><a id="channels" href="/channels"><span>Connected channels</span><strong>Web is available</strong><small>Other channels are shown as not connected until configured.</small></a><a id="security" href="#security"><span>Security</span><strong>Sign-in and sessions</strong><small>Your phone is the canonical account identity.</small></a><a id="data" href="#data"><span>Your data</span><strong>Export or delete</strong><small>Review available account data controls.</small></a></div>
          <section class="workspace-panel settings-detail"><h2>Account controls</h2><p>Profile editing, notification preferences, channel connections, session management and data export remain protected account operations. This surface reflects available services without promising unavailable controls.</p><div class="settings-control-row"><span>Marketing recommendations</span><button disabled>Not yet available</button></div><div class="settings-control-row"><span>Location personalisation</span><button disabled>Not yet available</button></div><div class="settings-control-row"><span>Delete account</span><button class="danger-outline" disabled>Not yet available</button></div></section>
        <% } %>

        <section class="workspace-promo"><div><span>Sponsored</span><strong>Local service promotion</strong><p>Advertisement placement preview. Sponsored content will never interrupt an active conversation.</p></div><em>No active promotion</em></section>
        <section class="workspace-proactive" data-proactive-card><span class="workspace-eyebrow">A quick question</span><h2>Was your recent request resolved?</h2><p>Proactive prompts are dismissible and only appear when relevant.</p><div><button type="button" data-proactive-response="yes">Yes</button><button type="button" data-proactive-response="not-yet">Not yet</button><button class="quiet" type="button" data-proactive-dismiss>Dismiss</button></div></section>
      </div>
    </main>
  </div>
  <script src="/js/kurukoo-workspace.js?v=5" defer></script>
</body>
</html>
