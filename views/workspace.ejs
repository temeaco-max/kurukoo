<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= workspaceTitle %> · Kurukoo</title>
  <meta name="description" content="<%= workspaceDescription %>">
  <meta name="theme-color" content="#F7F2EC">
  <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css?v=1.2.1">
  <link rel="stylesheet" href="/css/kurukoo-client-foundation.css?v=1">
  <link rel="stylesheet" href="/css/kurukoo-workspace.css?v=6">
  <link rel="stylesheet" href="/css/kurukoo-chat.css?v=14">
</head>
<body class="workspace-page" data-workspace-section="<%= workspaceSection %>" data-workspace-fixture="<%= visualQaFixture || '' %>">
  <% const icon = (name) => `<svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#${name}"></use></svg>`; %>
  <div class="workspace-shell chat-template-shell">
    <aside class="workspace-sidebar" id="workspace-sidebar">
      <div class="workspace-brand-row"><a href="/chat" class="workspace-brand"><img src="/assets/brand/logo-icon.png" alt="Kurukoo" width="34" height="34"><span>Kurukoo</span></a><button id="workspace-collapse" class="workspace-icon-button" type="button" aria-label="Collapse sidebar">‹</button></div>
      <a href="/chat" class="workspace-new"><span aria-hidden="true">＋</span> New conversation</a>
      <nav class="workspace-nav" aria-label="Workspace">
        <a href="/chat"><span class="workspace-nav-icon"><%- icon('chat') %></span><span>Conversation</span></a>
        <a class="<%= workspaceSection === 'requests' ? 'active' : '' %>" href="/requests"><span class="workspace-nav-icon"><%- icon('request') %></span><span>Requests</span></a>
        <a class="<%= workspaceSection === 'reminders' ? 'active' : '' %>" href="/reminders"><span class="workspace-nav-icon"><%- icon('reminder') %></span><span>Reminders</span></a>
        <a class="<%= workspaceSection === 'saved' ? 'active' : '' %>" href="/saved"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Saved &amp; offers</span></a>
        <a class="<%= workspaceSection === 'cart' ? 'active' : '' %>" href="/cart"><span class="workspace-nav-icon"><%- icon('package') %></span><span>Cart</span></a>
        <button class="workspace-nav-more" id="workspace-more" type="button" aria-expanded="false" aria-controls="workspace-more-items"><span class="workspace-nav-icon"><%- icon('more') %></span><span>More</span></button>
        <div class="workspace-nav-more-items" id="workspace-more-items" hidden>
          <a class="<%= workspaceSection === 'points' ? 'active' : '' %>" href="/points"><span class="workspace-nav-icon"><%- icon('points') %></span><span>Points</span></a><a class="<%= workspaceSection === 'topup' ? 'active' : '' %>" href="/top-up"><span class="workspace-nav-icon"><%- icon('points') %></span><span>Top up</span></a><a class="<%= workspaceSection === 'subscription' ? 'active' : '' %>" href="/subscription"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Subscription</span></a>
          <a class="<%= workspaceSection === 'tasks' ? 'active' : '' %>" href="/tasks"><span class="workspace-nav-icon"><%- icon('work') %></span><span>Tasks</span></a><a class="<%= workspaceSection === 'connect' ? 'active' : '' %>" href="/connect"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Connect</span></a>
          <a class="<%= workspaceSection === 'daily-picks' ? 'active' : '' %>" href="/daily-picks"><span class="workspace-nav-icon"><%- icon('discover') %></span><span>Daily Picks</span></a><a href="/discover"><span class="workspace-nav-icon"><%- icon('discover') %></span><span>Discover</span></a>
        </div>
      </nav>
      <div class="workspace-sidebar-spacer"></div>
      <nav class="workspace-nav workspace-nav-secondary" aria-label="Account">
        <a class="<%= workspaceSection === 'memory' ? 'active' : '' %>" href="/memory"><span class="workspace-nav-icon"><%- icon('saved') %></span><span>Memory</span></a><a class="<%= workspaceSection === 'safety' ? 'active' : '' %>" href="/safety"><span class="workspace-nav-icon"><%- icon('safety') %></span><span>Safety</span></a><a class="<%= workspaceSection === 'call' ? 'active' : '' %>" href="/call"><span class="workspace-nav-icon"><%- icon('mic') %></span><span>Call</span></a><a class="<%= workspaceSection === 'settings' ? 'active' : '' %>" href="/settings"><span class="workspace-nav-icon"><%- icon('settings') %></span><span>Settings</span></a><a href="/help"><span class="workspace-nav-icon"><%- icon('help') %></span><span>Help</span></a><button type="button" id="workspace-logout" class="workspace-nav-button"><span class="workspace-nav-icon"><%- icon('logout') %></span><span>Sign out</span></button>
      </nav>
      <div class="workspace-account"><div class="workspace-avatar"><%= (displayName || 'K').slice(0,1).toUpperCase() %></div><div><strong><%= displayName || 'Your Kurukoo account' %></strong><small><%= phone || 'Signed in' %></small></div></div>
    </aside>
    <main class="workspace-main">
      <header class="workspace-header"><div class="workspace-header-copy"><a class="workspace-back" href="/chat"><%- icon('chevron-left') %><span>Back to conversation</span></a><span class="workspace-kicker">Your Kurukoo</span><h1><%= workspaceTitle %></h1><p><%= workspaceDescription %></p></div><div class="workspace-header-actions"><a class="workspace-button secondary ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.png" alt="" aria-hidden="true"></span><span>Ask</span></a><button class="workspace-icon-button workspace-mobile-only" id="workspace-open" type="button" aria-label="Open workspace navigation"><svg class="k-icon" aria-hidden="true"><use href="/icons/kurukoo-icons.svg#menu"></use></svg></button></div></header>
      <div class="workspace-content">
        <% if (workspaceSection === 'requests') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Request timeline</span><h2>Keep every request in one place.</h2><p>Conversation stays the source of truth. This workspace mirrors each canonical request state without creating a second lifecycle.</p></div><a class="workspace-button" href="/chat">Start a new request</a></section><div class="workspace-grid three"><article class="metric-card"><span>Open requests</span><strong data-request-metric="open">—</strong><small>Requests that are still being coordinated.</small></article><article class="metric-card"><span>Waiting on you</span><strong data-request-metric="action">—</strong><small>Confirmations, details or decisions needed to continue.</small></article><article class="metric-card"><span>Completed</span><strong data-request-metric="completed">—</strong><small>Finished requests remain connected to their conversations.</small></article></div><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Fulfilment timeline</span><h2>Your requests</h2></div><span class="status-pill">Live request data</span></div><div class="workspace-data-list" data-requests-list aria-live="polite"></div><div class="empty-workspace" data-requests-empty><div class="empty-icon"><%- icon('request') %></div><h3>No requests yet</h3><p>Tell Kurukoo what you need. A request appears here when it is created through conversation.</p><a class="workspace-text-action ask-cta" href="/chat"><span class="ask-mark"><img src="/assets/brand/logo-icon.png" alt="" aria-hidden="true"></span><span>Ask</span></a></div></section>
        <% } else if (workspaceSection === 'reminders') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Remember the things that matter</span><h2>Reminders that live with your conversations.</h2><p>Create one here or simply tell Kurukoo, “Remind me to renew my MOT in September.”</p></div><a class="workspace-button" href="/chat?prompt=Create%20a%20reminder">Create reminder</a></section><div class="workspace-tabs" aria-label="Reminder views"><button class="active" type="button">Upcoming</button><button type="button" disabled>Today</button><button type="button" disabled>Completed</button><button type="button" disabled>Snoozed</button></div><section class="workspace-panel"><div class="workspace-data-list" data-reminders-list aria-live="polite"></div><div class="empty-workspace" data-reminders-empty><div class="empty-icon"><%- icon('reminder') %></div><h3>No upcoming reminders</h3><p>Your reminder service is connected to this workspace. New reminders will appear here with their schedule and next action.</p><a href="/chat?prompt=Create%20a%20reminder">Ask Kurukoo to remind me</a></div></section>
        <% } else if (workspaceSection === 'saved') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Saved &amp; offers</span><h2>Keep useful options close.</h2><p>Saved things can include offers, providers and request context. Availability and prices are always shown with their truthful state.</p></div><a class="workspace-button" href="/chat">Find something</a></section><section class="workspace-panel"><div class="empty-workspace"><div class="empty-icon"><%- icon('saved') %></div><h3>Nothing saved yet</h3><p>When Kurukoo shows you a useful option, save it from the conversation and it will appear here.</p></div></section>
        <% } else if (workspaceSection === 'cart') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Cart</span><h2>Review items before you request them.</h2><p>Cart is a visual workspace for sourced products. It does not imply inventory, a confirmed quote or a separate payment flow.</p></div><a class="workspace-button" href="/chat">Source something</a></section>
          <% if (visualQaFixture === 'populated') { %><section class="workspace-panel cart-panel" data-cart-live><div class="workspace-data-list"><article class="workspace-data-card"><div class="panel-heading"><div><span class="workspace-eyebrow">Review item</span><h3>Client meeting prep pack</h3></div><span class="status-pill">1 item</span></div><p>Key risks, decisions and draft agenda for the May 20 meeting.</p><div class="workspace-data-card-footer"><span class="status-pill">Source-attributed</span><span class="status-pill">Qty 1</span></div></article><article class="workspace-data-card"><div class="workspace-data-card-footer"><span>Seller</span><strong>Alex Morgan</strong></div><div class="workspace-data-card-footer"><span>Source</span><strong>Kurukoo Network</strong></div><div class="workspace-data-card-footer"><span>Provider type</span><strong>Independent expert</strong></div><div class="workspace-data-card-footer"><span>Location</span><strong>San Francisco, CA</strong></div><div class="workspace-data-card-footer"><span>Response time</span><strong>Within 2 hours</strong></div><div class="workspace-data-card-footer"><span>Completion rate</span><strong>98%</strong></div></article><div class="workspace-notice">This is a request, not an automatic purchase. Price and delivery remain pending until the relevant provider confirms them.</div></div><div class="cart-summary"><span>Price</span><strong>Price pending confirmation</strong><small>Final price will be confirmed by the seller. No payment has been taken.</small><span>Delivery</span><strong>Est. Tue, May 20</strong><small>Timing remains provisional until provider confirmation.</small><button type="button" class="workspace-button">Confirm request</button><button type="button" class="workspace-button secondary">Cancel</button></div></section>
          <% } else { %><section class="workspace-panel cart-panel" data-cart-live><div class="empty-workspace"><div class="empty-icon"><%- icon('package') %></div><h3>Your cart is empty</h3><p>When Kurukoo identifies a product you can request, it can be added here for review.</p></div><div class="cart-summary"><span>Subtotal</span><strong>Not calculated</strong><small>Confirmed prices appear only after the relevant provider confirms a quote.</small><button type="button" class="workspace-button" disabled>Continue</button></div></section><% } %>
        <% } else if (workspaceSection === 'confirmation') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Clear outcome</span><h2>Review and continue with confidence.</h2><p>Kurukoo keeps the action, evidence and next step connected to the originating conversation. External provider or payment states remain pending until evidence confirms them.</p></div><a class="workspace-button" href="/chat">Continue in Chat</a></section><section data-confirmation-live><% if (visualQaFixture === 'populated') { %><div class="workspace-grid three"><article class="metric-card"><span>Internal state</span><strong>Accepted internally</strong><small>Kurukoo recorded the request and preserved its originating Chat context.</small></article><article class="metric-card"><span>Provider state</span><strong>Pending confirmation</strong><small>Alex Morgan still needs to confirm availability, final price and delivery.</small></article><article class="metric-card"><span>Payment status</span><strong>Not completed</strong><small>No payment has been taken.</small></article></div><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Review request</span><h2>Client meeting prep pack</h2></div><span class="status-pill">Request sent</span></div><div class="workspace-data-list"><article class="workspace-data-card"><div class="workspace-data-card-footer"><span>Item</span><strong>Client meeting prep pack</strong></div><div class="workspace-data-card-footer"><span>Qty</span><strong>1</strong></div><div class="workspace-data-card-footer"><span>Seller</span><strong>Alex Morgan · Verified</strong></div><div class="workspace-data-card-footer"><span>Source</span><strong>Kurukoo Network</strong></div><div class="workspace-data-card-footer"><span>Price</span><strong>Pending confirmation</strong></div><div class="workspace-data-card-footer"><span>Delivery</span><strong>Est. Tue, May 20</strong></div></article><div class="workspace-notice">Sandbox/provider-dependent. Availability, pricing and delivery remain unconfirmed until evidence arrives.</div></div></section><% } else { %><div class="workspace-grid three"><article class="metric-card"><span>Internal state</span><strong>Accepted internally</strong><small>Kurukoo can record and queue an action without claiming external completion.</small></article><article class="metric-card"><span>Provider state</span><strong>Pending confirmation</strong><small>Availability, delivery and provider identifiers appear only when evidenced.</small></article><article class="metric-card"><span>Payment status</span><strong>Not completed</strong><small>No payment is taken merely by reviewing this confirmation surface.</small></article></div><% } %></section>
        <% } else if (workspaceSection === 'points') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Kurukoo Points</span><h2>See your current points balance and tier.</h2><p>Points are a product accounting surface. They are not cash and do not imply a payout or redemption capability that the deployment has not enabled.</p></div><a class="workspace-button" href="/top-up">Top up</a></section><div class="workspace-grid two"><article class="metric-card"><span>Balance</span><strong data-points-balance>—</strong><small>Current balance from the canonical points service.</small></article><article class="metric-card"><span>Tier</span><strong data-points-tier>—</strong><small>Tier information is shown only when provided by the points service.</small></article></div>
        <% } else if (workspaceSection === 'safety') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Personal safety</span><h2>Keep safety plans connected to Kurukoo.</h2><p>Kurukoo can coordinate check-ins and trusted contacts. It is not an emergency responder, and external notifications require configured delivery services.</p></div><a class="workspace-button" href="/chat?prompt=Help%20me%20set%20up%20a%20safety%20check-in">Set up a check-in</a></section><div class="workspace-grid two"><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Trusted contacts</span><h2>Your contacts</h2></div></div><div class="workspace-data-list" data-safety-contacts></div><div class="empty-workspace" data-safety-contacts-empty><div class="empty-icon"><%- icon('safety') %></div><h3>No trusted contacts</h3><p>Add a contact through the safety flow in Chat.</p></div></section><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Check-ins</span><h2>Active check-ins</h2></div></div><div class="workspace-data-list" data-safety-checkins></div><div class="empty-workspace" data-safety-checkins-empty><div class="empty-icon"><%- icon('safety') %></div><h3>No active check-ins</h3><p>Create one through Chat when you need a check-in plan.</p></div></section></div>
        <% } else if (workspaceSection === 'artifacts') { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Artifacts</span><h2>Keep generated work connected to its source.</h2><p>Artifacts may be stored in Kurukoo-managed storage or an explicitly connected external provider. Storage state is always disclosed.</p></div><a class="workspace-button" href="/chat">Create an artifact</a></section><section class="workspace-panel"><div class="panel-heading"><div><span class="workspace-eyebrow">Storage</span><h2 data-artifact-storage-state>Checking…</h2><p data-artifact-storage-copy>Checking artifact storage configuration.</p></div><button class="workspace-button secondary" data-artifact-connect type="button" hidden>Connect Google Drive</button></div><div class="workspace-data-list" data-artifact-list></div><div class="empty-workspace" data-artifact-empty><div class="empty-icon"><%- icon('package') %></div><h3>No artifacts yet</h3><p>Generated files and media will appear here when Kurukoo creates them.</p></div><p class="workspace-footnote" data-artifact-action-note></p></section>
        <% } else { %>
          <section class="workspace-hero-card"><div><span class="workspace-eyebrow">Your Kurukoo</span><h2>Ask first. This workspace follows the conversation.</h2><p>Kurukoo is conversation-first. Use Chat to start an action, then come here to review its durable state.</p></div><a class="workspace-button" href="/chat">Open Chat</a></section>
          <section class="workspace-panel"><div class="empty-workspace"><div class="empty-icon"><%- icon('chat') %></div><h3>This workspace is ready</h3><p>Open Chat to create a request, reminder, safety check-in, saved item or other supported action.</p></div></section>
        <% } %>
      </div>
    </main>
  </div>
  <script src="/js/kurukoo-workspace.js?v=6" defer></script>
</body>
</html>
