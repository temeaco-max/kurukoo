<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container page-container">
    <section class="contact-hero public-help-hero">
        <div>
            <span class="eyebrow">Support &amp; partnerships</span>
            <h1 class="contact-title">Contact Kurukoo</h1>
            <p class="contact-subtitle">Use Web Chat to describe a request, report an issue, or begin a discussion about a scoped partnership.</p>
        </div>
        <span class="public-status public-status--ready">Web Chat available</span>
    </section>

    <section class="contact-grid" aria-label="Contact options">
        <article class="contact-card">
            <span class="public-status public-status--ready">Recommended</span>
            <h2>Start in Web Chat</h2>
            <p>Web Chat is the active support and request channel in this deployment. Your account can keep the resulting conversation together when identity is needed.</p>
            <a href="/chat?prompt=I%20need%20help%20with%20Kurukoo" class="btn btn-primary">Open Web Chat</a>
        </article>

        <article class="contact-card contact-card--muted">
            <span class="public-status public-status--setup">Not configured</span>
            <h2>Other contact channels</h2>
            <p>WhatsApp, USSD, SMS, and direct email support are not listed as active channels in this deployment because their delivery or support adapters are not configured.</p>
            <p>If your request requires a provider, payment, or integration discussion, explain that context in Web Chat and Kurukoo will present only the next supported action.</p>
            <a href="/channels" class="text-link">Review channel readiness →</a>
        </article>
    </section>
</main>

<%- include('_partials/footer') %>
