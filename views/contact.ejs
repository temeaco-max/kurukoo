<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main>
    <section class="section contact-hero">
        <div class="container text-center">
            <h1 class="contact-title">Contact Kurukoo</h1>
            <p class="contact-subtitle">Use Web Chat to describe a request, report an issue, or begin a discussion about a scoped partnership.</p>
        </div>
    </section>

    <section class="section container contact-grid">
        <article class="card contact-card">
            <h2 class="mb-16">Start in Web Chat</h2>
            <p class="text-gray mb-24">Web Chat is the active support and request channel in this deployment. Your account can keep the resulting conversation together when identity is needed.</p>
            <a href="/chat?prompt=I%20need%20help%20with%20Kurukoo" class="btn btn-primary">Open Web Chat</a>
        </article>

        <article class="card contact-card contact-card--muted">
            <h2 class="mb-16">Other contact channels</h2>
            <p class="text-gray">WhatsApp, USSD, SMS, and direct email support are not listed as active channels in this deployment because their delivery or support adapters are not configured.</p>
            <p class="text-gray">If your request requires a provider, payment, or integration discussion, explain that context in Web Chat and Kurukoo will present only the next supported action.</p>
        </article>
    </section>
</main>

<style>
.contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
.contact-card { padding: 32px; }
.contact-card--muted { background: var(--gray-50); }
@media (max-width: 720px) { .contact-grid { grid-template-columns: 1fr; } }
</style>

<%- include('_partials/footer') %>
