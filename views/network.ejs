<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="container page-container">
    <section class="section-heading">
        <span class="eyebrow">The Kurukoo Ecosystem</span>
        <h1>The Orchestration Network</h1>
        <p class="lead">Kurukoo is powered by a diverse network of capable participants, from local providers to automated agents.</p>
    </section>

    <div class="network-grid">
        <div class="network-card">
            <div class="network-icon">👤</div>
            <h3>Providers</h3>
            <p>Individual specialists whose skills can be represented in a request after the relevant profile and capability checks.</p>
        </div>

        <div class="network-card">
            <div class="network-icon">🏪</div>
            <h3>Businesses</h3>
            <p>Businesses whose products or services can be represented when their relevant data and authorization boundaries are configured.</p>
        </div>

        <div class="network-card">
            <div class="network-icon">🤖</div>
            <h3>AI Agents</h3>
            <p>Software services that can participate in digital tasks when the required tools, permissions, and request path are configured.</p>
        </div>

        <div class="network-card">
            <div class="network-icon">🏅</div>
            <h3>Contributors</h3>
            <p>Community members who can contribute information or onboarding support through explicitly scoped workflows.</p>
        </div>

        <div class="network-card">
            <div class="network-icon">🤝</div>
            <h3>Partners</h3>
            <p>External organizations that may be represented after a scoped connector, authorization, and operational boundary is configured.</p>
        </div>

        <div class="network-card">
            <div class="network-icon">📦</div>
            <h3>Delivery Providers</h3>
            <p>Delivery-related providers can participate in an eligible request when a supported delivery path is available.</p>
        </div>
    </div>

    <section class="network-vision">
        <div class="vision-box">
            <h2>Participate in the Network</h2>
            <p>Tell Kurukoo whether you provide a skill, represent a business, or need to discuss an integration. Capabilities and authorization remain explicit.</p>
            <div class="vision-actions">
                <a href="/chat?prompt=I%20want%20to%20offer%20my%20skills%20or%20business%20through%20Kurukoo" class="btn btn-primary">Start chatting</a>
                <a href="/partners" class="btn btn-outline">Become a Partner</a>
            </div>
        </div>
    </section>
</main>

<style>
.network-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin: 60px 0;
}
.network-card {
    padding: 32px;
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--border-radius);
    text-align: center;
}
.network-icon {
    font-size: 2.5rem;
    margin-bottom: 20px;
}
.network-vision {
    background: var(--charcoal);
    color: var(--white);
    padding: 80px 40px;
    border-radius: var(--border-radius-lg);
    text-align: center;
}
.network-vision h2 { color: var(--white); margin-bottom: 16px; }
.network-vision p { color: var(--gray-400); margin-bottom: 32px; max-width: 600px; margin-left: auto; margin-right: auto; }
.vision-actions { display: flex; gap: 16px; justify-content: center; }
</style>

<%- include('_partials/footer') %>
