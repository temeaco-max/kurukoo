<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="home-page">
  <section class="home-hero section">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <span class="eyebrow">The Conversational Fulfillment Network</span>
        <h1>The trusted neighbor who knows everyone.</h1>
        <p class="home-hero__lead">Meet Kurukoo — a conversational utility that helps you find trusted people, get everyday things done, offer your skills, and discover useful opportunities nearby.</p>
        <div class="home-hero__actions">
          <a class="btn btn-primary home-cta" href="/chat">Start chatting</a>
          <a class="btn btn-outline home-cta" href="/how-it-works">How it works</a>
        </div>
        <p class="home-trust"><span>★</span> Built for everyday coordination <span>•</span> Web Chat available <span>•</span> Privacy first</p>
      </div>
      <div class="home-chat-card" aria-label="Illustrative Kurukoo conversation">
        <div class="home-chat-card__top"><span class="home-avatar">K</span><div><strong>Kurukoo</strong><small>Conversational Fulfillment</small></div><span class="home-online">●</span></div>
        <div class="home-chat-card__body">
          <div class="chat-bubble chat-bubble--user">I need a ride to the airport at 5am tomorrow.</div>
          <div class="chat-bubble chat-bubble--assistant">I can help scope that ride request and check whether a supported path is available.</div>
          <div class="chat-result"><div><span class="result-icon">🚗</span><div><strong>Ride request</strong><small>Requirements captured · availability confirmed before next step</small></div></div><span class="result-arrow">→</span></div>
        </div>
        <div class="home-chat-card__footer">Start a conversation. Kurukoo handles the rest.</div>
      </div>
    </div>
  </section>

  <!-- Role Priming Section -->
  <section class="home-roles section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">What do you want to do today?</span>
        <h2>One conversation. Every role.</h2>
        <p>Kurukoo is like that reliable, connected neighbor who knows every plumber, rider, and shopkeeper in town.</p>
      </div>
      <div class="network-preview-grid">
        <div class="network-mini-card">
          <span class="icon">👤</span>
          <strong>Request a service</strong>
          <p>Need a ride, repair, delivery, food, or a worker? Tell Kurukoo what you need.</p>
          <a href="/chat?prompt=I%20need%20help%20with%20..." class="text-link" style="margin-top: 12px; display: inline-block;">Request a service →</a>
        </div>
        <div class="network-mini-card">
          <span class="icon">💼</span>
          <strong>Offer your skills</strong>
          <p>Ride, cook, build, deliver, design, or teach. List your skills once and let people find you.</p>
          <a href="/chat?prompt=I%20want%20to%20offer%20my%20skills" class="text-link" style="margin-top: 12px; display: inline-block;">Offer skills →</a>
        </div>
        <div class="network-mini-card">
          <span class="icon">🏪</span>
          <strong>Grow my business</strong>
          <p>Turn your products and services into a discoverable local offering without a complicated dashboard.</p>
          <a href="/chat?prompt=I%20want%20to%20grow%20my%20business" class="text-link" style="margin-top: 12px; display: inline-block;">Grow business →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Living Profile Section -->
  <section class="home-living section" style="background: var(--surface-warm);">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">A helper who learns a little more every day</span>
        <h2>A friend who remembers</h2>
        <p>No forms. No questionnaires. Kurukoo learns from every conversation and gets smarter every time you return.</p>
      </div>
      <div class="network-preview-grid">
        <div class="network-mini-card" style="background: var(--white);">
          <span class="icon">🧠</span>
          <strong>Your profile lives and grows</strong>
          <p>Whether ordering dinner or booking a carpenter, everything links to a single secure profile.</p>
        </div>
        <div class="network-mini-card" style="background: var(--white);">
          <span class="icon">💬</span>
          <strong>Natural conversations</strong>
          <p>Speak or type naturally in English, Pidgin, or local phrases. No rigid menus or buttons.</p>
        </div>
        <div class="network-mini-card" style="background: var(--white);">
          <span class="icon">⚡</span>
          <strong>Proactive opportunities</strong>
          <p>Surfaces timely alerts, nearby mobile vendors, and earning opportunities matching your skills.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Nearby Pulse Section -->
  <section class="home-pulse section">
    <div class="container home-split">
      <div class="section-heading section-heading--left">
        <span class="eyebrow">Nearby Pulse</span>
        <h2>See how nearby help can work</h2>
        <p>When you choose to share an approximate area, Kurukoo can help surface relevant people, services, and opportunities. Exact locations stay private.</p>
        <div style="margin-top: 24px;">
          <a href="/discover" class="btn btn-outline">Explore the full map →</a>
        </div>
      </div>
      <div class="channel-list">
        <div class="channel-item">
          <div class="channel-item__icon">🍊</div>
          <div>
            <h3>Food & Cravings</h3>
            <p>Illustrative nearby request pin for local food and vendor items.</p>
          </div>
        </div>
        <div class="channel-item">
          <div class="channel-item__icon">🔧</div>
          <div>
            <h3>Repairs & Maintenance</h3>
            <p>Illustrative nearby pin for generator and appliance fixes.</p>
          </div>
        </div>
        <div class="channel-item">
          <div class="channel-item__icon">🛵</div>
          <div>
            <h3>Mobility & Delivery</h3>
            <p>Illustrative nearby pin for rides and parcel transport.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Can You Do Section -->
  <section class="home-explore section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Capabilities</span>
        <h2>Everything you need, one conversation away</h2>
        <p>Explore what Kurukoo can coordinate for you. Tap any category to start.</p>
      </div>
      <div class="capability-grid">
        <a href="/chat?prompt=I%20need%20to%20order%20food" class="capability-card"><span>🍜</span><strong>Order Food</strong></a>
        <a href="/chat?prompt=I%20need%20groceries" class="capability-card"><span>🛒</span><strong>Get Groceries</strong></a>
        <a href="/chat?prompt=I%20need%20a%20ride" class="capability-card"><span>🛵</span><strong>Get a Ride</strong></a>
        <a href="/chat?prompt=I%20need%20something%20repaired" class="capability-card"><span>🔧</span><strong>Get a Repair</strong></a>
        <a href="/chat?prompt=I%20need%20delivery%20help" class="capability-card"><span>📦</span><strong>Send Parcels</strong></a>
        <a href="/chat?prompt=I%20want%20to%20sell%20something" class="capability-card"><span>🏪</span><strong>Sell Locally</strong></a>
        <a href="/chat?prompt=I%20need%20emergency%20help" class="capability-card"><span>🚨</span><strong>Emergency SOS</strong></a>
        <a href="/chat?prompt=I%20want%20to%20find%20work" class="capability-card"><span>💼</span><strong>Find Work</strong></a>
      </div>
      <div class="center-cta" style="margin-top: 32px;">
        <a href="/explore" class="btn btn-outline">Explore all 45+ categories</a>
      </div>
    </div>
  </section>

  <!-- Channels Section -->
  <section class="home-channels section" style="background: var(--surface-warm);">
    <div class="container home-split">
      <div class="section-heading section-heading--left">
        <span class="eyebrow">Access Points</span>
        <h2>Start in Web Chat</h2>
        <p>Web Chat is the active access point in this deployment. Other channels appear only when their adapters are configured.</p>
      </div>
      <div class="channel-list">
        <div class="channel-item">
            <div class="channel-item__icon" aria-hidden="true">⌘</div>
            <div>
                <h3>Web Chat</h3>
                <p>Describe a request, review the next step, and continue a saved conversation.</p>
            </div>
        </div>
        <div class="channel-item channel-item--unavailable">
            <div class="channel-item__icon" aria-hidden="true">◌</div>
            <div>
                <h3>WhatsApp</h3>
                <p>Unavailable in this deployment. Use Web Chat instead.</p>
            </div>
        </div>
        <div class="channel-item channel-item--unavailable">
            <div class="channel-item__icon" aria-hidden="true">⌁</div>
            <div>
                <h3>USSD</h3>
                <p>Unavailable in this deployment. Use Web Chat instead.</p>
            </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('_partials/footer') %>
