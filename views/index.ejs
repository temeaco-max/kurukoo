<%- include('_partials/head') %>
<%- include('_partials/nav') %>

<main class="home-page">
  <section class="home-hero section">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <span class="eyebrow">The Conversational Fulfillment Network</span>
        <h1>Tell Kurukoo what you need. Kurukoo figures out who or what can fulfil it.</h1>
        <p class="home-hero__lead">Kurukoo is a conversational utility that keeps a request in context and checks for the next supported path through one conversation.</p>
        <div class="home-hero__actions">
          <a class="btn btn-primary home-cta" href="/chat">Start chatting</a>
          <a class="btn btn-outline home-cta" href="/how-it-works">How it works</a>
        </div>
        <p class="home-trust"><span>★</span> One conversation <span>•</span> Web Chat access <span>•</span> Supported request paths</p>
      </div>
      <div class="home-chat-card" aria-label="Illustrative Kurukoo conversation">
        <div class="home-chat-card__top"><span class="home-avatar">K</span><div><strong>Kurukoo</strong><small>Conversational Fulfillment</small></div><span class="home-online">●</span></div>
        <div class="home-chat-card__body">
          <div class="chat-bubble chat-bubble--user">I need a ride to the airport at 5am tomorrow.</div>
          <div class="chat-bubble chat-bubble--assistant">I can help scope that ride request and check whether a supported path is available.</div>
          <div class="chat-result"><div><span class="result-icon">🚗</span><div><strong>Ride request</strong><small>Requirements captured · availability confirmed before the next step</small></div></div><span class="result-arrow">→</span></div>
        </div>
        <div class="home-chat-card__footer">Start a conversation. Kurukoo handles the rest.</div>
      </div>
    </div>
  </section>

  <section class="home-network section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">The Kurukoo Network</span>
        <h2>Who fulfils your requests?</h2>
        <p>Kurukoo connects your needs to a vast network of capable participants.</p>
      </div>
      <div class="network-preview-grid">
        <div class="network-mini-card">
          <span class="icon">👤</span>
          <strong>Providers</strong>
          <p>Specialists can participate through validated request flows.</p>
        </div>
        <div class="network-mini-card">
          <span class="icon">🏪</span>
          <strong>Businesses</strong>
          <p>Businesses can participate where their catalogue data is available.</p>
        </div>
        <div class="network-mini-card">
          <span class="icon">🤖</span>
          <strong>AI Agents</strong>
          <p>Software services for digital tasks.</p>
        </div>
        <div class="network-mini-card">
          <span class="icon">📦</span>
          <strong>Logistics</strong>
          <p>Delivery coordination is presented only when a supported path is available.</p>
        </div>
      </div>
      <div class="center-cta">
        <a href="/network" class="text-link">Learn more about the network <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="home-explore section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Capabilities</span>
        <h2>What can you ask Kurukoo?</h2>
        <p>Ask naturally. Kurukoo understands the requirements and routes your request.</p>
      </div>
      <div class="capability-grid">
        <a href="/chat?prompt=I%20need%20to%20order%20food" class="capability-card"><span>🍜</span><strong>Order Food</strong></a>
        <a href="/chat?prompt=I%20need%20a%20ride" class="capability-card"><span>🛵</span><strong>Get a Ride</strong></a>
        <a href="/chat?prompt=I%20need%20something%20repaired" class="capability-card"><span>🔧</span><strong>Get a Repair</strong></a>
        <a href="/chat?prompt=I%20need%20delivery%20help" class="capability-card"><span>📦</span><strong>Arrange Delivery</strong></a>
        <a href="/chat?prompt=I%20want%20to%20sell%20something" class="capability-card"><span>🏪</span><strong>Sell Locally</strong></a>
        <a href="/chat?prompt=I%20need%20to%20find%20work" class="capability-card"><span>💼</span><strong>Find Work</strong></a>
      </div>
      <div class="center-cta">
        <a href="/explore" class="btn btn-outline">Explore all capabilities</a>
      </div>
    </div>
  </section>

  <section class="home-channels section">
    <div class="container home-split">
      <div class="section-heading section-heading--left">
        <span class="eyebrow">Access Points</span>
        <h2>Start in Web Chat</h2>
        <p>Web Chat is the active access point in this deployment. Other channels are shown only when their adapters are connected.</p>
      </div>
      <div class="channel-list">
        <div class="channel-item">
            <div class="channel-item__icon" aria-hidden="true">⌘</div>
            <div>
                <h3>Web Chat</h3>
                <p>Describe a request, review the next step, and continue a saved conversation.</p>
            </div>
        </div>
        <div class="channel-item channel-item--unavailable">
            <div class="channel-item__icon" aria-hidden="true">◌</div>
            <div>
                <h3>WhatsApp</h3>
                <p>Unavailable in this deployment. Use Web Chat instead.</p>
            </div>
        </div>
        <div class="channel-item channel-item--unavailable">
            <div class="channel-item__icon" aria-hidden="true">⌁</div>
            <div>
                <h3>USSD</h3>
                <p>Unavailable in this deployment. Use Web Chat instead.</p>
            </div>
        </div>
      </div>
    </div>
  </section>
</main>


<%- include('_partials/footer') %>
