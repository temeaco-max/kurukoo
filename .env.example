KURUKOO_COORDINATOR_PROMOTION_ENABLED=false
KURUKOO_COORDINATOR_POLICY_VERSION=coordinator-policy-v1
CREDIT_ECONOMY_ENABLED=true
DB_PATH=tmp/kurukoo.sqlite

# Canonical persistence backend. SQL.js is the lightweight single-process default.
# PostgreSQL is the canonical durable shared-state backend for multi-instance/Cloud Run.
# The application remains fail-closed (BLOCKED) in production unless BOTH the full
# call-surface migration is verified AND the operator-set activation gate below is true.
KURUKOO_DATABASE_MODE=sqljs
KURUKOO_POSTGRES_APPLICATION_INTEGRATED=false
DATABASE_URL=
POSTGRES_URL=
KURUKOO_POSTGRES_SSL=false
KURUKOO_POSTGRES_POOL_MAX=5
KURUKOO_POSTGRES_IDLE_TIMEOUT_SECONDS=30
KURUKOO_POSTGRES_CONNECT_TIMEOUT_SECONDS=5

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OTP_LEGACY_LOGIN=false
OTP_DEBUG=false
KURUKOO_DEV_AUTH=false
KURUKOO_TEST_PHONE=
KURUKOO_TEST_NAME=Kurukoo Development Tester
KURUKOO_EMAIL_OTP_ENABLED=false
KURUKOO_MAGIC_LINK_AUTH=true
KURUKOO_PUBLIC_BASE_URL=http://localhost:3000
# Production automatically activates configured Telegram/WhatsApp/Stripe/Resend/Mistral integrations unless explicitly disabled.
KURUKOO_EXTERNAL_AUTO_ACTIVATE=false
KURUKOO_AUTH_CHALLENGE_DEBUG=false
