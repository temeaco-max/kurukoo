# Kurukoo deployment configuration — copy to a private .env file; never commit real credentials.
# REQUIRED IN PRODUCTION means the application must receive an owner-managed secret before production start.

# Runtime and storage
NODE_ENV=development                         # production in deployed environments
HOST=0.0.0.0
PORT=3000
DB_PATH=tmp/kurukoo.sqlite                   # single-instance launch only
KURUKOO_WORKERS=1                            # set 0 for deterministic local tests
KURUKOO_DISABLE_LISTEN=false
KURUKOO_DB_SAVE_DEBOUNCE_MS=250
CHAT_ATTACHMENT_BODY_LIMIT=35mb
CHAT_UPLOAD_DIR=tmp/uploads

# REQUIRED IN PRODUCTION — authentication and privacy
JWT_SECRET=                                  # high-entropy server secret; never return to browser
MEMORY_ENCRYPTION_KEY=                       # high-entropy server secret for protected memory data
ADMIN_USERNAME=admin                         # replace in production
ADMIN_PASSWORD=                              # required for production admin access
OTP_LEGACY_LOGIN=false                       # local demos only; never enable in production
OTP_DEBUG=false                              # never enable in production

# AI / intent — optional integrations; application retains deterministic fallbacks where documented
GEMINI_API_KEY=                              # server-side only
GROQ_API_KEY=                                # server-side only
GROQ_MODEL=
GROQ_MAX_CONCURRENT=2
HUGGINGFACE_API_KEY=
HF_API_KEY=
KURUKOO_SMOLLM2_LOCAL=false
SMOLLM2_MAX_NEW_TOKENS=256
AI_QUOTA_SIMPLE_PER_DAY=200
AI_QUOTA_COMPLEX_PER_DAY=30
AI_QUOTA_TOKENS_PER_DAY=500000
AI_QUOTA_GLOBAL_COMPLEX_PER_MIN=10
AI_QUOTA_HARD_BLOCK=false
AI_SIMPLE_CACHE_TTL_MS=300000

# Web Voice — optional; disable instantly with KURUKOO_VOICE_ENABLED=false
# Gemini credentials remain server-side; the browser receives only ephemeral session material.
KURUKOO_VOICE_ENABLED=false
KURUKOO_VOICE_PROVIDER=gemini
KURUKOO_VOICE_MODEL=gemini-3.1-flash-live-preview
KURUKOO_VOICE_MAX_SESSION_SECONDS=900
KURUKOO_VOICE_IDLE_TIMEOUT_SECONDS=120
KURUKOO_VOICE_MAX_CONCURRENT_SESSIONS=2
KURUKOO_VOICE_SESSION_RATE_LIMIT=5

# Bounded autonomous follow-up — disabled by default
KURUKOO_AGENT_ENABLED=false
KURUKOO_AGENT_MAX_ACTIONS_PER_CYCLE=3
KURUKOO_AGENT_MAX_RETRIES=3
KURUKOO_AGENT_MAX_CONCURRENT_GOALS=2
KURUKOO_AGENT_COOLDOWN_SECONDS=300
KURUKOO_AGENT_WORKER_INTERVAL_MS=60000
KURUKOO_AGENT_AUTONOMOUS_LOW_RISK=false

# QR contextual entry — REQUIRED for signed QR links outside local development
QR_CONTEXT_SECRET=                           # high-entropy server secret; never expose in QR URLs

# Stripe UK collection — deployment dependent. The adapter stays fail-closed until all are set.
KURUKOO_PAY_PROVIDER=sandbox                 # set to stripe only after credentials and webhook registration
STRIPE_SECRET_KEY=                           # server-side only
STRIPE_WEBHOOK_SECRET=                       # Stripe endpoint signing secret
ECONOMIC_PAYMENT_ADAPTER=sandbox

# Email — deployment dependent; absent credentials leave delivery unavailable rather than successful.
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# Channel adapters — deployment dependent; UI must remain Not connected until configured.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
IVR_WEBHOOK_SECRET=
IVR_CALLBACK_URL=

# Optional notification and device integrations
MQTT_BROKER_URL=

# Feature flags — optional, fail closed for high-risk or external capabilities.
CREDIT_ECONOMY_ENABLED=true
FORCE_SANDBOX_SUBSCRIPTION=false
FF_USSD=false
FF_NIMC_KYC=false
FF_MOBILE_MONEY=false
FF_STRIPE_PAYPAL=false
FF_POINTS_ENABLED=true
FF_UK_LIFE_ADMIN=false
FF_AFFILIATE_LINKS=false
FF_CONTRIBUTOR_SYSTEM=true
FF_EMAIL_REQUIRED=false

# Single-instance worker cadence. Reduce only with measured operational need.
KURUKOO_REMINDER_INTERVAL_SEC=60
KURUKOO_MEMORY_INTERVAL_SEC=300
KURUKOO_SAFETY_INTERVAL_SEC=60
KURUKOO_PURGE_INTERVAL_SEC=86400
KURUKOO_DEFERRED_INTERVAL_SEC=300
KURUKOO_ORCHESTRATION_INTERVAL_SEC=60
KURUKOO_TRUST_SCORE_INTERVAL_SEC=86400
