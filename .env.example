# Kurukoo environment template. NEVER commit real credentials.
# Gemini text is bounded hosted generation; use the cost-conscious 2.5 Flash family by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=
GEMINI_LIVE_MODEL=
# Optional Mistral hosted capabilities; each external operation remains explicitly feature-gated.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_VISION_MODEL=pixtral-large-latest
# Voxtral TTS is disabled by default and requires an approved externally managed saved voice profile; do not upload a user artifact as a voice clone without separate consent design and evidence.
MISTRAL_TTS_MODEL=
MISTRAL_TTS_VOICE_ID=
MISTRAL_TTS_RESPONSE_FORMAT=mp3
MISTRAL_TIMEOUT_MS=15000
KURUKOO_MISTRAL_TRANSCRIPTION_ENABLED=false
KURUKOO_AI_HOSTED_PROVIDER=mistral
# Optional Hugging Face teacher-provider credentials only; they never enable raw SmolLM2 serverless runtime inference.
HUGGINGFACE_API_KEY=
HF_API_KEY=
# Separate Hugging Face Jobs credential for managed GPU training and private artifact retrieval; never commit a value.
HF_TOKEN=
GROQ_API_KEY=
# OpenRouter hosted text requires an explicit approved model and FF_HOSTED_OPENROUTER=true.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=15000
OPENROUTER_MAX_TOKENS=384
OPENAI_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
PORT=3000

# Offline teacher/evaluator pool. This is the existing ml/teachers entrypoint,
# not a production dependency. free-first means preference only: no provider is
# assumed free, and the provider's own quota/billing remains authoritative.
KURUKOO_TEACHER_PROVIDER=auto
KURUKOO_TEACHER_PROVIDERS=gemini,mistral,groq,openrouter,huggingface,openai
KURUKOO_TEACHER_FREE_FIRST=true
KURUKOO_TEACHER_GEMINI_MODEL=gemini-2.5-flash
KURUKOO_TEACHER_MISTRAL_MODEL=mistral-small-latest
KURUKOO_TEACHER_GROQ_MODEL=openai/gpt-oss-20b
KURUKOO_TEACHER_OPENROUTER_MODEL=openrouter/free
KURUKOO_TEACHER_HUGGINGFACE_MODEL=HuggingFaceTB/SmolLM3-3B
KURUKOO_TEACHER_OPENAI_MODEL=gpt-5-mini
KURUKOO_TEACHER_LIMIT=25
KURUKOO_TEACHER_TIMEOUT=120
KURUKOO_TEACHER_MAX_TOKENS=1200
KURUKOO_TEACHER_SEED=42
GROQ_API_BASE=https://api.groq.com/openai/v1
MISTRAL_API_BASE=https://api.mistral.ai/v1
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
HUGGINGFACE_API_BASE=https://router.huggingface.co/v1
OPENAI_API_BASE=https://api.openai.com/v1

# Payment & Identity Services
KURUKOO_PAY_PROVIDER=sandbox
MOMO_API_KEY=
PAGA_API_KEY=
STRIPE_SECRET_KEY=
AT_API_KEY=
VERIFYME_SECRET=

# Bounded Autonomous Agent Runtime
KURUKOO_AGENT_ENABLED=true
KURUKOO_AGENT_AUTONOMOUS=true
KURUKOO_AGENT_AUTONOMOUS_LOW_RISK=true
KURUKOO_AGENT_MAX_ACTIONS_PER_CYCLE=8
KURUKOO_AGENT_MAX_RETRIES=2
KURUKOO_AGENT_MAX_CONCURRENT_GOALS=5
KURUKOO_AGENT_COOLDOWN_SECONDS=120
KURUKOO_AGENT_WORKER_INTERVAL_MS=60000
KURUKOO_COORDINATOR_TEACHER_ENABLED=false
KURUKOO_COORDINATOR_PROMOTION_ENABLED=false
KURUKOO_COORDINATOR_POLICY_VERSION=coordinator-policy-v1
CREDIT_ECONOMY_ENABLED=true
DB_PATH=tmp/kurukoo.sqlite

# Security (required in production)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OTP_LEGACY_LOGIN=false
OTP_DEBUG=false
KURUKOO_DEV_AUTH=false
KURUKOO_TEST_PHONE=
KURUKOO_TEST_NAME=Kurukoo Development Tester
KURUKOO_EMAIL_OTP_ENABLED=false

# Progressive identity — additive to OTP. Email is continuity; phone remains primary once proven.
KURUKOO_MAGIC_LINK_AUTH=true
KURUKOO_PUBLIC_BASE_URL=http://localhost:3000
KURUKOO_AUTH_CHALLENGE_DEBUG=false
KURUKOO_GOOGLE_CLIENT_ID=
KURUKOO_APPLE_CLIENT_ID=

# Email channel
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# IVR channel
IVR_WEBHOOK_SECRET=
IVR_CALLBACK_URL=

# Progressive trust and channel evidence gates
KURUKOO_PROGRESSIVE_TRUST_ENABLED=false
KURUKOO_PUSH_APPROVAL_ENABLED=false
KURUKOO_CHANNEL_EVIDENCE_ENABLED=false
KURUKOO_LOCATION_CONSENT_ENABLED=false

# Feature Flags. Credentials never enable an external integration by themselves.
FF_USSD=false
FF_WHATSAPP=false
FF_TELEGRAM=false
FF_SMS=false
FF_EMAIL=false
FF_GOOGLE_DRIVE=false
FF_GOOGLE_SHEETS=false
FF_NOTION=false
FF_OUTLOOK=false
FF_ONEDRIVE=false
FF_FCM=false
FF_VOICE=false
FF_STRIPE_PAYMENTS=false
FF_MOBILE_MONEY=false
FF_HOSTED_GEMINI=false
FF_HOSTED_MISTRAL=false
FF_MISTRAL_TTS=false
FF_HOSTED_GROQ=false
FF_HOSTED_OPENROUTER=false
FF_HUGGINGFACE_JOBS=false
FF_WEBRTC=false
FF_IOT_REMOTE=false
FF_NEARBY_PULSE=false
FF_NIMC_KYC=false
FF_STRIPE_PAYPAL=false
FF_POINTS_ENABLED=true
FF_UK_LIFE_ADMIN=false
FF_AFFILIATE_LINKS=true
FF_CONTRIBUTOR_SYSTEM=true
FF_EMAIL_REQUIRED=false

# Channel Wiring
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
KURUKOO_WHATSAPP_LINKED_DEVICE_ENABLED=false
KURUKOO_WHATSAPP_LINKED_DEVICE_ALLOW=false
KURUKOO_WHATSAPP_LINKED_DEVICE_AUTOSTART=false
KURUKOO_WHATSAPP_LINKED_DEVICE_OWNER_PHONE=
KURUKOO_WHATSAPP_LINKED_DEVICE_AUTH_DIR=.data/whatsapp-linked-device
KURUKOO_WHATSAPP_LINKED_DEVICE_ALLOW_GROUPS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
APPLE_BC_ENABLED=false
APPLE_BC_SHARED_SECRET=
APPLE_BC_MSP_URL=
APPLE_BC_BID=

# External AI channel / MCP integration.
KURUKOO_MCP_ENABLED=false
KURUKOO_MCP_ISSUER=
KURUKOO_MCP_CLIENT_ID=
KURUKOO_MCP_CLIENT_SECRET=
KURUKOO_MCP_REDIRECT_URIS=
KURUKOO_MCP_OAUTH_SECRET=
KURUKOO_MCP_ACCESS_TOKEN_TTL_SECONDS=3600
KURUKOO_MCP_REFRESH_TOKEN_TTL_SECONDS=7776000

# Realtime Web Voice
KURUKOO_VOICE_ENABLED=false
KURUKOO_VOICE_PROVIDER=gemini-live
KURUKOO_VOICE_MODEL=gemini-2.5-flash-native-audio-live
KURUKOO_VOICE_EXPERIMENTAL_BROWSER_SPEECH=false
KURUKOO_VOICE_TTS_PROVIDER=disabled
KURUKOO_VOICE_TTS_MODEL=
KURUKOO_VOICE_PROVIDER_BUDGET_PER_DAY=0
KURUKOO_VOICE_MAX_SESSION_SECONDS=900
KURUKOO_VOICE_IDLE_TIMEOUT_SECONDS=120
KURUKOO_VOICE_MAX_CONCURRENT_SESSIONS=2
KURUKOO_VOICE_SESSION_RATE_LIMIT=5

# User-owned artifact storage. Google Drive is preferred when the authenticated owner
# has completed the narrow drive.file OAuth connection; otherwise verified local managed
# storage is used without claiming external persistence. Keep credentials in deployment secrets.
KURUKOO_GOOGLE_DRIVE_CLIENT_ID=
KURUKOO_GOOGLE_DRIVE_CLIENT_SECRET=
KURUKOO_GOOGLE_DRIVE_REDIRECT_URI=
# Google Sheets source OAuth uses only spreadsheets.readonly and its own exact callback.
KURUKOO_GOOGLE_SHEETS_CLIENT_ID=
KURUKOO_GOOGLE_SHEETS_CLIENT_SECRET=
KURUKOO_GOOGLE_SHEETS_REDIRECT_URI=
# Notion public connection OAuth; use an exact registered callback and share only selected pages.
KURUKOO_NOTION_CLIENT_ID=
KURUKOO_NOTION_CLIENT_SECRET=
KURUKOO_NOTION_REDIRECT_URI=
# Microsoft Graph delegated OAuth; Outlook uses Mail.ReadBasic and OneDrive uses Files.Read through the exact registered callback.
KURUKOO_MICROSOFT_CLIENT_ID=
KURUKOO_MICROSOFT_CLIENT_SECRET=
KURUKOO_MICROSOFT_REDIRECT_URI=
KURUKOO_MICROSOFT_TENANT=common
KURUKOO_STORAGE_ENCRYPTION_KEY=
KURUKOO_MANAGED_ARTIFACT_STORAGE_DIR=.data/artifacts
KURUKOO_ARTIFACT_MAX_BYTES=26214400

NODE_ENV=development
HOST=0.0.0.0
# Raw Hugging Face serverless SmolLM2 inference is retired. Enable this only for actual local Transformers.js model execution.
KURUKOO_SMOLLM2_LOCAL=false
SMOLLM2_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
SMOLLM2_FALLBACK_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
SMOLLM2_DTYPE=q4
SMOLLM2_MAX_NEW_TOKENS=192

# Offline Student v1 training. This never runs during application startup.
# `local_cuda` is the safe default. The `huggingface` path also requires a valid HF_TOKEN,
# a private artifact repository, an explicit approval flag, and a bounded cost cap.
KURUKOO_TRAINING_BACKEND=local_cuda
KURUKOO_TRAIN_MIN_CUDA_MEMORY_GIB=16
KURUKOO_HF_ARTIFACT_REPO=
KURUKOO_HF_JOB_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel
KURUKOO_HF_TRAIN_TIMEOUT_SECONDS=14400
KURUKOO_HF_MAX_ESTIMATED_COST_USD=
KURUKOO_REMOTE_TRAINING_LAUNCH_APPROVED=false
GROQ_MAX_CONCURRENT=8
GROQ_MODEL=openai/gpt-oss-20b
AI_QUOTA_COMPLEX_PER_DAY=30
AI_QUOTA_GLOBAL_COMPLEX_PER_MIN=10
AI_QUOTA_HARD_BLOCK=true
AI_QUOTA_SIMPLE_PER_DAY=200
AI_QUOTA_TOKENS_PER_DAY=500000
AI_SIMPLE_CACHE_TTL_MS=300000
CHAT_ATTACHMENT_BODY_LIMIT=10485760
CHAT_UPLOAD_DIR=tmp/uploads
ECONOMIC_PAYMENT_ADAPTER=sandbox
FORCE_SANDBOX_SUBSCRIPTION=true
KURUKOO_DB_SAVE_DEBOUNCE_MS=250
KURUKOO_DEFERRED_INTERVAL_SEC=300
KURUKOO_MEMORY_INTERVAL_SEC=300
KURUKOO_ORCHESTRATION_INTERVAL_SEC=60
KURUKOO_PURGE_INTERVAL_SEC=86400
KURUKOO_REMINDER_INTERVAL_SEC=60
KURUKOO_SAFETY_INTERVAL_SEC=60
KURUKOO_TRUST_SCORE_INTERVAL_SEC=86400
KURUKOO_WORKERS=1
KURUKOO_DISABLE_LISTEN=false
KURUKOO_EXTERNAL_EXECUTION_ENABLED=false
KURUKOO_PROGRAMMATIC_AD_PROVIDER=none
MQTT_BROKER_URL=
STRIPE_WEBHOOK_SECRET=
FCM_SERVICE_ACCOUNT_JSON=
KURUKOO_FCM_PROJECT_ID=
KURUKOO_FCM_CLIENT_EMAIL=
KURUKOO_FCM_PRIVATE_KEY=
MEMORY_ENCRYPTION_KEY=
QR_CONTEXT_SECRET=
KURUKOO_PRODUCT_CATALOGUE_SECRET=
KURUKOO_NOTIFICATION_MAX_QUEUE=10000

# Personal Telegram linked-device connector
KURUKOO_TELEGRAM_LINKED_DEVICE_ENABLED=false
KURUKOO_TELEGRAM_LINKED_DEVICE_ALLOW=false
KURUKOO_TELEGRAM_LINKED_DEVICE_OWNER_PHONE=
KURUKOO_TELEGRAM_LINKED_DEVICE_AUTH_DIR=.data/telegram-linked-device
KURUKOO_TELEGRAM_LINKED_DEVICE_ALLOW_GROUPS=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LINKED_DEVICE_2FA_PASSWORD=

FF_PRIVATE_NUMBER_MASKING=false
NUMBER_MASKING_PROVIDER=
KURUKOO_CLOUD_RUN_PROVING=false
KURUKOO_SMOLLM2_STARTUP_MODE=lazy
KURUKOO_SMOLLM2_MAX_CONCURRENCY=1
KURUKOO_SMOLLM2_INIT_TIMEOUT_MS=180000
KURUKOO_SMOLLM2_REQUEST_TIMEOUT_MS=240000
KURUKOO_SMOLLM2_CACHE_DIR=/tmp/huggingface
KURUKOO_SMOLLM2_READINESS_REQUIRED=false
KURUKOO_PERSISTENT_STATE_REQUIRED=true
