# Comma-separated STUN URLs. Direct ICE remains preferred when available.
STUN_SERVERS=stun:stun.l.google.com:19302
# Comma-separated coturn TURN URLs, for example turn:turn.example.com:3478?transport=udp.
TURN_URL=
