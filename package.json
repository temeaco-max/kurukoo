{
  "name": "kurukoo-platform",
  "private": true,
  "version": "5.52.13",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "tsx index.ts",
    "build": "tsc && npm run copy:public && npm run optimize:css",
    "copy:public": "node scripts/copy-public.mjs",
    "optimize:css": "node scripts/optimize-css.mjs",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "audit:css": "node scripts/audit-inline-css.mjs",
    "audit:css:all": "node scripts/audit-css-system.mjs",
    "audit:messaging": "node scripts/audit-messaging-system.mjs",
    "audit:skills": "node scripts/audit-skills.mjs",
    "audit:services": "node scripts/audit-services.mjs",
    "audit:security": "node scripts/audit-security-boundaries.mjs && npm run audit:economic",
    "audit:economic": "tsx scripts/test-economic-request.ts",
    "secrets:staged": "node scripts/scan-staged-secrets.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "test:email": "tsx scripts/test-email-channel.ts",
    "test:economic-lifecycle": "tsx scripts/test-economic-lifecycle.ts",
    "test:provider-entities": "tsx scripts/test-provider-entities.ts",
    "test:provider-verification": "tsx scripts/test-provider-verification.ts",
    "test:multi-party": "tsx scripts/test-multi-party-economic-request.ts",
    "test:execution-boundary": "tsx scripts/test-execution-boundary.ts",
    "test:native-assistance": "tsx scripts/test-native-assistance.ts",
    "test:notification-queue": "tsx scripts/test-notification-queue.ts",
    "test:skill-flows": "tsx scripts/test-skill-flows.ts",
    "test:conversation-workspace": "tsx scripts/test-conversation-workspace.ts",
    "test:auth-entry": "tsx scripts/test-auth-entry.ts",
    "test:channel-usage": "tsx scripts/test-channel-usage.ts",
    "db:migrate:messages": "tsx scripts/migrate-messages.ts",
    "test:ai": "tsx scripts/test-ai-pipeline.ts",
    "fasttext:build": "node scripts/build-fasttext.mjs",
    "fasttext:test": "tsx scripts/test-fasttext.ts && tsx scripts/test-fasttext-router.ts",
    "test:public-routes": "tsx scripts/test-public-routes.ts",
    "test:public-runtime": "tsx scripts/test-public-runtime-contracts.ts",
    "test:chat-dom-safety": "node scripts/test-chat-dom-safety.mjs",
    "test:conversation-first-auth": "tsx scripts/test-conversation-first-auth.ts",
    "test:conversational-auth-controls": "tsx scripts/test-conversational-auth-controls.ts",
    "test:voice": "tsx scripts/test-voice-integration.ts",
    "test:pilot-observability": "tsx scripts/test-pilot-observability.ts",
    "test:provider-coordination": "tsx scripts/test-provider-coordination.ts",
    "test:economic-participant-migration": "tsx scripts/test-economic-participant-migration.ts",
    "test:provider-supply-registry": "tsx scripts/test-provider-supply-registry.ts",
    "test:supply-acquisition": "tsx scripts/test-provider-supply-acquisition.ts",
    "test:qr": "tsx scripts/test-qr-context.ts",
    "test:agent-runtime": "tsx scripts/test-agent-runtime.ts",
    "test:stripe-payment": "tsx scripts/test-stripe-payment.ts",
    "test:discovery-routes": "tsx scripts/test-discovery-routes.ts",
    "test:presence-routes": "tsx scripts/test-presence-routes.ts",
    "test:content-routes": "tsx scripts/test-content-routes.ts",
    "test:trust": "tsx scripts/test-trust-routes.ts",
    "test:trust-score": "tsx scripts/test-trust-score.ts",
    "test:dispute-lifecycle": "tsx scripts/test-dispute-lifecycle.ts",
    "test:circle": "tsx scripts/test-circle-routes.ts",
    "test:order": "tsx scripts/test-order-routes.ts",
    "test:admin": "tsx scripts/test-admin-routes.ts",
    "test:seo-admin": "tsx scripts/test-seo-admin-routes.ts",
    "test:composition": "tsx scripts/test-composition-routes.ts",
    "test:task": "node scripts/test-task-routes.mjs",
    "test:routes": "npm run test:composition && npm run test:public-routes && npm run test:public-runtime && npm run test:conversation-workspace && npm run test:voice && npm run test:qr && npm run test:agent-runtime && npm run test:stripe-payment && npm run test:channel-usage && npm run test:discovery-routes && npm run test:presence-routes && npm run test:content-routes && npm run test:trust && npm run test:trust-score && npm run test:dispute-lifecycle && npm run test:circle && npm run test:order && npm run test:admin && npm run test:seo-admin && npm run test:task && npm run test:provider-entities && npm run test:provider-verification && npm run test:multi-party && npm run test:execution-boundary && npm run test:provider-coordination && npm run test:economic-participant-migration && npm run test:provider-supply-registry && npm run test:supply-acquisition && npm run test:native-assistance && npm run test:auth-entry && npm run test:conversational-auth-controls && npm run test:economic-lifecycle",
    "test:security": "npm run test:trust && npm run test:circle && npm run test:order && npm run test:admin && npm run test:task",
    "postinstall": "fasttext --help >/dev/null 2>&1 && echo 'FastText is available' || echo 'FastText CLI not found. Install with: brew install fasttext (macOS) or apt-get install: fasttext (Linux). Using template fallback until model is available.'"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@huggingface/inference": "^4.13.25",
    "@huggingface/transformers": "^3.7.2",
    "@types/qrcode": "1.5.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.2",
    "qrcode": "1.5.4",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/sql.js": "^1.4.9",
    "adm-zip": "^0.6.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
